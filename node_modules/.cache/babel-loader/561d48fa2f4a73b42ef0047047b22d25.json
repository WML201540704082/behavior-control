CiDetail","$refs","ciDetail","style","width","id","backManage","_this2","$nextTick","saveCitype","saveCi","addCi","editCi"],"sources":["src/views/system/modelManage.vue"],"sourcesContent":["<template>\n  <basic-container>\n    <div class=\"model_top page_form\">\n      <div class=\"model_top_left\">\n        <el-button-group>\n          <el-button type=\"primary\" size=\"small\" @click=\"addCi\" icon=\"el-icon-plus\">模 型</el-button>\n          <el-button type=\"primary\" size=\"small\" @click=\"addModel\" icon=\"el-icon-upload\">导 入 模 型</el-button>\n          <el-button type=\"primary\" size=\"small\" @click=\"addModel\" icon=\"el-icon-download\">导 出 模 型</el-button>\n          <el-button type=\"primary\" size=\"small\" @click=\"showLevel = true\" icon=\"el-icon-plus\">层 级</el-button>\n          <el-button type=\"primary\" size=\"small\" @click=\"showLevelManage = true\" icon=\"el-icon-edit\">层 级</el-button>\n          <el-button type=\"primary\" size=\"small\" @click=\"addModel\" icon=\"el-icon-view\">{{ showTopo? '隐 藏 拓 扑' : '显 示 拓 扑'}}</el-button>\n        </el-button-group>\n      </div>\n      \n      <el-row class=\"model_top_right\" >\n        <el-col :span=\"7\">\n          <el-radio-group v-model=\"modeShowType\" size=\"small\">\n            <el-radio-button label=\"card\"><i class=\"el-icon-s-grid\"></i></el-radio-button>\n            <el-radio-button label=\"table\"><i class=\"el-icon-s-unfold\"></i></el-radio-button>\n          </el-radio-group>\n        </el-col>\n        <el-col :span=\"17\">\n          <el-input placeholder=\"请输入内容\" v-model=\"searchText\" size=\"medium\" class=\"input-with-select\">\n            <el-button slot=\"prepend\" size=\"small\" icon=\"el-icon-search\"></el-button>\n            <el-popover\n              slot=\"append\"\n              placement=\"bottom\"\n              title=\"标题\"\n              width=\"200\"\n              trigger=\"click\"\n            >\n              <el-button slot=\"reference\" size=\"small\" icon=\"el-icon-setting\"></el-button>\n            </el-popover>\n          </el-input>\n        </el-col>\n      </el-row>\n        \n    </div>\n    <div class=\"model_content page_body\" v-loading=\"pageLoading\">\n      <el-scrollbar v-if=\"modeShowType === 'card'\" style=\"height:100%\">\n        <div\n          class=\"level_box\"\n          v-for=\"item in modelList\"\n          :key=\"item.id\"\n        >\n          <div class=\"level_name text-grey\">\n            <i class=\"tsfont-formstaticlist\" v-if=\"item.isMenu === 1\"></i>\n            {{ item.name }}\n          </div>\n          <el-row :gutter=\"50\" class=\"model_list\">\n            <el-col\n              :span=\"6\"\n              style=\"margin-bottom: 20px\"\n              v-for=\"(it, index) in item.ciList\"\n              :key=\"index\"\n            >\n              <div class=\"model_card\" @click=\"seeCiDetail(it)\">\n                <i class=\"icon\" :class=\"it.icon + ' ' + getIconClass(it)\"></i>\n                <div class=\"ci_name\">\n                  <div>{{it.label}}</div>\n                  <div class=\"text-grey\" style=\"margin-top:4px\">{{it.name}}</div>\n                </div>\n              </div>\n            </el-col>\n          </el-row>\n        </div>\n      </el-scrollbar>\n    </div>\n    \n    <!-- 详情页面 -->\n    <div ref=\"ciDetail\" class=\"form_detail\">\n      <modelDetailForm\n        v-if=\"showDetail\"\n        :ciId=\"ciId\"\n        @quitDetail=\"backManage\"\n        @seeCiDetail=\"editCi\"\n      ></modelDetailForm>\n    </div>\n    <!-- 模型弹窗 -->\n    <modelForm\n      v-if=\"showModel\"\n      :isShow=\"showModel\"\n      :showType=\"showType\"\n      :ciId=\"ciId\"\n      @close=\"showModel = false\"\n      @saveCi=\"saveCi\"\n    ></modelForm>\n\n    <!-- 层级弹窗 -->\n    <levelForm\n      v-if=\"showLevel\"\n      :isShow=\"showLevel\"\n      @close=\"showLevel = false\"\n      @saveCitype=\"saveCitype\"\n    ></levelForm>\n\n    <!-- 层级管理弹窗 -->\n    <levelManage\n      v-if=\"showLevelManage\"\n      :isShow=\"showLevelManage\"\n      @close=\"showLevelManage = false\"\n      @saveCitypeManage=\"saveCitype\"\n    ></levelManage>\n    \n  </basic-container>\n</template>\n\n<script>\nimport { citypesearch } from \"@/api/system/ciModel\";\nimport modelForm from './components/modelManageComponent/modelFom';\nimport levelForm from './components/modelManageComponent/levelForm';\nimport levelManage from './components/modelManageComponent/levelManage';\nimport modelDetailForm from './modelDetailForm';\n\nexport default {\n  components: { \n    modelForm,\n    levelForm,\n    levelManage,\n    modelDetailForm,\n  },\n  data() {\n    return{\n      showTopo: false,\n      modeShowType: \"card\",\n      searchText: '',\n      modelList: [],\n      pageLoading: false,\n      // 弹窗相关\n      showModel: false,\n      showLevel: false,\n      showLevelManage: false,\n      showDetail: false,\n      ciId: '', //模型id\n      showType: '',\n    }\n  },\n  mounted() {\n    this.setPageContentHeight()\n    this.getModelList()\n  },\n  methods: {\n    // 获得所有模型列表\n    getModelList() {\n      this.pageLoading = true\n      citypesearch().then(res => {\n        this.modelList = res.Return\n        this.pageLoading = false\n      }).catch(err => {\n        this.pageLoading = false\n      })\n    },\n    // 设置图标颜色\n    getIconClass(row) {\n      if (row.isVirtual) {\n        return 'text-grey';\n      } else {\n        if (!row.isAbstract) {\n          return 'text_primary';\n        } else {\n          return 'text_default';\n        }\n      }\n    },\n    // 查看模型详情\n    seeCiDetail(row) {\n      this.$refs.ciDetail.style.width = 'calc(100% - 40px)'\n      this.ciId = row.id\n      this.showDetail = true\n      \n    },\n    // 返回模型管理\n    backManage() {\n      this.$refs.ciDetail.style.width = '0px'\n      this.$nextTick(() => {\n        this.showDetail = false\n      })\n    },\n    // 层级保存成功回调\n    saveCitype() {\n      this.showLevel = false\n      this.showLevelManage = false\n      this.getModelList()\n    },\n    // 模型保存回调\n    saveCi() {\n      this.showModel = false\n      this.getModelList()\n    },\n    // 新增模型\n    addCi() {\n      this.showModel = true\n      this.showType = '新增'\n    },\n    // 编辑模型\n    editCi() {\n      this.showModel = true\n      this.showType = '修改'\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.model_top{\n  display: flex;\n  justify-content: space-between;\n  &_right{\n    display: flex\n  }\n}\n.model_content{\n  .level_box{\n    .level_name{\n      font-size: 14px;\n      margin-bottom: 5px\n    }\n  }\n  .model_card{\n    background-color: #edeef3;\n    min-height: 60px;\n    box-shadow: 0 2px 4px rgba(0, 0, 0, .12), 0 0 6px rgba(0, 0, 0, .04);\n    border-radius: 5px;\n    padding: 10px;\n    display: flex;\n    cursor: pointer;\n    align-items: center;\n    .icon{\n      font-size: 24px;\n      margin-right: 20px;\n    }\n    .ci_name{\n      font-size: 14px;\n    }\n  }\n}\n.form_detail{\n  // width: calc(100% - 40px);\n  width: 0px;\n  height: calc(100% - 40px);\n  position: absolute;\n  top: 20px;\n  left: 20px;\n  transition: all 0.5s;\n  background: #fff;\n  overflow: hidden;\n}\n</style>\n"],"mappings":"AA4GA,SAAAA,YAAA;AACA,OAAAC,SAAA;AACA,OAAAC,SAAA;AACA,OAAAC,WAAA;AACA,OAAAC,eAAA;AAEA;EACAC,UAAA;IACAJ,SAAA,EAAAA,SAAA;IACAC,SAAA,EAAAA,SAAA;IACAC,WAAA,EAAAA,WAAA;IACAC,eAAA,EAAAA;EACA;EACAE,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;MACAC,YAAA;MACAC,UAAA;MACAC,SAAA;MACAC,WAAA;MACA;MACAC,SAAA;MACAC,SAAA;MACAC,eAAA;MACAC,UAAA;MACAC,IAAA;MAAA;MACAC,QAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,oBAAA;IACA,KAAAC,YAAA;EACA;EACAC,OAAA;IACA;IACAD,YAAA,WAAAA,aAAA;MAAA,IAAAE,KAAA;MACA,KAAAX,WAAA;MACAX,YAAA,GAAAuB,IAAA,WAAAC,GAAA;QACAF,KAAA,CAAAZ,SAAA,GAAAc,GAAA,CAAAC,MAAA;QACAH,KAAA,CAAAX,WAAA;MACA,GAAAe,KAAA,WAAAC,GAAA;QACAL,KAAA,CAAAX,WAAA;MACA;IACA;IACA;IACAiB,YAAA,WAAAA,aAAAC,GAAA;MACA,IAAAA,GAAA,CAAAC,SAAA;QACA;MACA;QACA,KAAAD,GAAA,CAAAE,UAAA;UACA;QACA;UACA;QA