CiType: function removeCiType(ciType) {\n      this.$set(ciType, 'isDeleted', true);\n    },\n    // 恢复层级\n    recoverCiType: function recoverCiType(ciType) {\n      this.$set(ciType, 'isDeleted', null);\n    },\n    // 保存结果\n    save: function save() {\n      var _this2 = this;\n      this.saveLoading = true;\n      saveAllCitype({\n        ciTypeList: this.ciTypeList\n      }).then(function (res) {\n        _this2.saveLoading = false;\n        Message({\n          type: 'success',\n          message: '保存成功!'\n        });\n        _this2.$emit(\"saveCitypeManage\");\n      }).catch(function () {\n        _this2.saveLoading = false;\n      });\n    }\n  }\n};",{"version":3,"names":["citypeList","saveAllCitype","Message","draggable","components","props","data","dragOptions","animation","scroll","group","disabled","ghostClass","ciTypeList","saveLoading","mounted","getAllCitype","methods","_this","then","res","Return","removeCiType","ciType","$set","recoverCiType","save","_this2","type","message","$emit","catch"],"sources":["src/views/system/components/modelManageComponent/levelManage.vue"],"sourcesContent":["<template>\n  <div>\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"isShow\"\n      title=\"选择图标\"\n      width=\"650px\"\n      top=\"10vh\"\n      v-el-drag-dialog\n    >\n      <div class=\"card-head\">\n        <div class=\"block-handler text-grey\">排 序</div>\n        <div class=\"block-name text-grey\">名 称</div>\n        <div class=\"block-key text-grey\">关 键 类 型</div>\n        <div class=\"block-topo text-grey\">拓 扑 中 显 示</div>\n        <div class=\"block-type text-grey\">模 型 数 量</div>\n        <div class=\"block-showtype text-grey\"></div>\n      </div>\n      <div style=\"height:600px\">\n        <el-scrollbar style=\"height:100%\">\n          <draggable\n            v-bind=\"dragOptions\"\n            tag=\"div\"\n            class=\"dataSource-ul\"\n            :list=\"ciTypeList\"\n            :group=\"{ name: 'item-sub' }\"\n            handle=\".tsfont-bar\"\n            :forceFallback=\"false\"\n            @start=\"moveStart\"\n            @end=\"moveEnd\"\n          >\n            <div v-for=\"(item, index) in ciTypeList\" :key=\"index\" class=\"card-item\">\n              <div class=\"block-handler\">\n                <div v-if=\"!item.isDeleted\"><i class=\"tsfont-bar move\"></i></div>\n              </div>\n              <div class=\"block-name\">\n                <div v-if=\"!item.isDeleted\">\n                  <el-input\n                    v-model=\"item.name\"\n                    :maxlength=\"30\"\n                    show-word-limit\n                    border=\"border\"\n                    :validateList=\"['required']\"\n                    size=\"small\"\n                  ></el-input>\n                </div>\n                <div v-else style=\"text-decoration:line-through\" class=\"text-grey\">{{ item.name }}</div>\n              </div>\n              <div class=\"block-key\">\n                <div v-if=\"!item.isDeleted\">\n                  <el-switch \n                    v-model=\"item.isMenu\" \n                    active-color=\"#1670f0\" \n                    inactive-color=\"#e5e5e5\"\n                    :active-value=\"1\"\n                    :inactive-value=\"0\"\n                    size=\"small\"\n                  ></el-switch>\n                </div>\n              </div>\n              <div class=\"block-topo\">\n                <div v-if=\"!item.isDeleted\">\n                  <el-switch \n                    v-model=\"item.isShowInTopo\" \n                    active-color=\"#1670f0\" \n                    inactive-color=\"#e5e5e5\"\n                    :active-value=\"1\"\n                    :inactive-value=\"0\"\n                    size=\"small\"\n                  ></el-switch>\n                </div>\n              </div>\n              <div class=\"block-type\">\n                <el-badge :value=\"item.ciCount\" class=\"item\"></el-badge>\n              </div>\n              <div class=\"block-showtype\">\n                <div v-if=\"!item.ciCount\">\n                  <div\n                    v-if=\"!item.isDeleted\"\n                    class=\"tsfont-close-o\"\n                    style=\"cursor:pointer\"\n                    @click=\"removeCiType(item)\"\n                  >删 除</div>\n                  <div\n                    v-else\n                    class=\"tsfont-rotate-right\"\n                    style=\"cursor:pointer\"\n                    @click=\"recoverCiType(item)\"\n                  >恢 复</div>\n                </div>\n              </div>\n            </div>\n          </draggable>\n        </el-scrollbar>\n      </div>\n      <div class=\"submit_btn\">\n        <el-button type=\"primary\" size=\"small\" @click=\"save\" :loading=\"saveLoading\">保 存</el-button>\n        <el-button size=\"small\" @click=\"$emit('close')\">取 消</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { citypeList, saveAllCitype } from \"@/api/system/ciModel\";\nimport { Message } from 'element-ui'\nimport draggable from 'vuedraggable';\n\nexport default {\n  components: {\n    draggable\n  },\n  props: ['isShow'],\n  data() {\n    return{\n      dragOptions: {\n        animation: 150,\n        scroll: true,\n        group: 'description',\n        disabled: false,\n        ghostClass: 'ghost'\n      },\n      ciTypeList: [],\n      saveLoading: false,\n    }\n  },\n  mounted() {\n    // console.log(draggable)\n    this.getAllCitype()\n  },\n  methods: {\n    // 获得全部层级\n    getAllCitype() {\n      citypeList().then(res => {\n        this.ciTypeList = res.Return\n      })\n    },\n    // 移除层级\n    removeCiType(ciType) {\n      this.$set(ciType, 'isDeleted', true);\n    },\n    // 恢复层级\n    recoverCiType(ciType) {\n      this.$set(ciType, 'isDeleted', null);\n    },\n    // 保存结果\n    save() {\n      this.saveLoading = true\n      saveAllCitype({ciTypeList: this.ciTypeList}).then(res => {\n        this.saveLoading = false\n        Message({\n          type: 'success',\n          message: '保存成功!'\n        })\n        this.$emit(\"saveCitypeManage\")\n      }).catch(() => {\n        this.saveLoading = false\n      })\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.card-head {\n  position: relative;\n  height: 30px;\n  line-height: 30px;\n  font-size: 14px;\n\n  .block-handler {\n    position: absolute;\n    left: 10px;\n  }\n  .block-name {\n    position: absolute;\n    left: 60px;\n  }\n  .block-key {\n    position: absolute;\n    left: 270px;\n  }\n  .block-topo {\n    position: absolute;\n    left: 360px;\n  }\n  .block-type {\n    position: absolute;\n    left: 465px;\n  }\n  .block-showtype {\n    position: absolute;\n    right: 0;\n    // left:500px;\n  }\n}\n.card-item {\n  margin-bottom: 10px;\n  position: relative;\n  height: 30px;\n  line-height: 30px;\n  .block-handler {\n    position: absolute;\n    left: 15px;\n    cursor: move;\n  }\n  .block-name {\n    position: absolute;\n    left: 60px;\n  }\n  .block-key {\n    position: absolute;\n    left: 270px;\n  }\n  .block-topo {\n    position: absolute;\n    left: 360px;\n  }\n  .block-type {\n    position: absolute;\n    left: 487px;\n  }\n  .block-showtype {\n    position: absolute;\n    // left:500px;\n    right: 10px;\n  }\n}\n</style>\n"],"mappings":"AA2GA,SAAAA,UAAA,EAAAC,aAAA;AACA,SAAAC,OAAA;AACA,OAAAC,SAAA;AAEA;EACAC,UAAA;IACAD,SAAA,EAAAA;EACA;EACAE,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,WAAA;QACAC,SAAA;QACAC,MAAA;QACAC,KAAA;QACAC,QAAA;QACAC,UAAA;MACA;MACAC,UAAA;MACAC,WAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA;IACA,KAAAC,YAAA;EACA;EACAC,OAAA;IACA;IACAD,YAAA,WAAAA,aAAA;MAAA,IAAAE,KAAA;MACAlB,UAAA,GAAAmB,IAAA,WAAAC,GAAA;QACAF,KAAA,CAAAL,UAAA,GAAAO,GAAA,CAAAC,MAAA;MACA;IACA;IACA;IACAC,YAAA,WAAAA,aAAAC,MAAA;MACA,KAAAC,IAAA,CAAAD,MAAA;IACA;IACA;IACAE,aAAA,WAAAA,cAAAF,MAAA;MACA,KAAAC,IAAA,CAAAD,MAAA;IACA;IACA;IACAG,IAAA,WAAAA,KAAA;MAAA,IAAAC,MAAA;MACA,KAAAb,WAAA;MACAb,aAAA;QAAAY,UAAA,OAAAA;MAAA,GAAAM,IAAA,WAAAC,GAAA;QACAO,MAAA,CAAAb,WAAA;QACAZ,OAAA;UACA0B,IAAA;UACAC,OAAA;QACA;QACAF,MAAA,CAAAG,KAAA;MACA,GAAAC,KAAA;QACAJ,MAAA,CAAAb,WAAA;MACA;IACA;EACA;AACA"}]}