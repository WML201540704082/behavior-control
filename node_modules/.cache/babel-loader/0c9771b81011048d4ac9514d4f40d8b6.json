ght=\"tableHeight\" stripe size=\"small\" v-loading=\"tableLoading\" @selection-change=\"selectionChange\">\n        <el-table-column label=\"工单编号\" prop=\"workCode\" align=\"center\" show-overflow-tooltip />\n        <el-table-column label=\"机房\" prop=\"roomName\" align=\"center\" show-overflow-tooltip />\n        <el-table-column label=\"操作人\" prop=\"workerName\" align=\"center\" show-overflow-tooltip />\n        <el-table-column label=\"操作对象\" prop=\"operateDevice\" align=\"center\" show-overflow-tooltip />\n        <el-table-column label=\"操作时间\" prop=\"operateTime\" align=\"center\" show-overflow-tooltip />\n        <el-table-column label=\"认证类型\" prop=\"verifyType\" width=\"150\" align=\"center\" show-overflow-tooltip />\n        <el-table-column label=\"操作\" align=\"center\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-button v-if=\"(scope.row.ossAddress && scope.row.ossAddress.length>0)\" type=\"text\" size=\"mini\" @click=\"showVideo(scope.row)\" icon=\"el-icon-video-camera\">查看视频</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!-- 分页 -->\n      <pagination :total=\"total\" :page.sync=\"searchForm.pageNo\" :limit.sync=\"searchForm.pageSize\" :pageSizes=\"[10,20,50,100,200]\" @pagination=\"getList\"/>\n    </div>\n\n  </basic-container>\n</template>\n\n<script>\n  import { mapGetters } from 'vuex'\n  import { getVideoByPage } from '@/api/xcnanr/roomRecordLog'\n\n  export default {\n    name: 'RoomRecordVideo',\n    computed: { ...mapGetters([\"permission\", \"userInfo\", 'userDetail']),\n      permissionList() {\n        return {}\n      }},\n    data() {\n      return {\n        searchForm: {\n          workCode: null,\n          workerName: null,\n          operateDevice: null,\n          pageNo: 1,\n          pageSize: 10,\n        },\n        total: 0,\n        tableData: [],\n        tableHeight: undefined,\n        tableLoading: false\n      }\n    },\n    mounted() {\n      this.setPageContentHeight()\n      this.setTableHeight()\n      this.getList()\n    },\n    methods: {\n      showVideo(row)   {\n        window.open(row.ossAddress, '_blank');\n      },\n      // 设置表格高度\n      setTableHeight() {\n        let bodyBox = document.getElementsByClassName('page_body')\n        this.tableHeight = (bodyBox[0].offsetHeight - 100) + 'px'\n      },\n      queryEvent() {\n        this.searchForm.pageNo = 1;\n        this.searchForm.pageSize = 10;\n        this.getList()\n      },\n      resetEvent() {\n        this.searchForm = {\n          workCode: null,\n          workerName: null,\n          operateDevice: null,\n          pageNo: 1,\n          pageSize: 10,\n        }\n        this.getList()\n      },\n      getList() {\n        this.tableLoading = true\n        // 处理时间范围\n        getVideoByPage(this.searchForm).then(res => {\n          this.tableData = res.data.records\n          this.total = res.data.total\n          this.tableLoading = false\n        }).catch(() => {\n          this.tableLoading = false\n        })\n      }\n    }\n  }\n</script>\n\n<style lang=\"scss\" scoped>\n  .el-link {\n    font-size: 13px;\n  }\n\n  .s_lt {\n    font-size: 12px;\n  }\n</style>\n"],"mappings":";;;;;;AAmDA,SAAAA,UAAA;AACA,SAAAC,cAAA;AAEA;EACAC,IAAA;EACAC,QAAA,EAAAC,aAAA,CAAAA,aAAA,KAAAJ,UAAA;IACAK,cAAA,WAAAA,eAAA;MACA;IACA;EAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,aAAA;QACAC,MAAA;QACAC,QAAA;MACA;MACAC,KAAA;MACAC,SAAA;MACAC,WAAA,EAAAC,SAAA;MACAC,YAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,oBAAA;IACA,KAAAC,cAAA;IACA,KAAAC,OAAA;EACA;EACAC,OAAA;IACAC,SAAA,WAAAA,UAAAC,GAAA;MACAC,MAAA,CAAAC,IAAA,CAAAF,GAAA,CAAAG,UAAA;IACA;IACA;IACAP,cAAA,WAAAA,eAAA;MACA,IAAAQ,OAAA,GAAAC,QAAA,CAAAC,sBAAA;MACA,KAAAf,WAAA,GAAAa,OAAA,IAAAG,YAAA;IACA;IACAC,UAAA,WAAAA,WAAA;MACA,KAAAzB,UAAA,CAAAI,MAAA;MACA,KAAAJ,UAAA,CAAAK,QAAA;MACA,KAAAS,OAAA;IACA;IACAY,UAAA,WAAAA,WAAA;MACA,KAAA1B,UAAA;QACAC,QAAA;QACAC,UAAA;QACAC,aAAA;QACAC,MAAA;QACAC,QAAA;MACA;MACA