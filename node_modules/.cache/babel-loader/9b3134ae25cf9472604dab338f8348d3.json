e-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"isShow\"\n      title=\"数据修改\"\n      width=\"1200px\"\n      top=\"10vh\"\n      v-el-drag-dialog\n    >\n      <div>\n        <el-form ref=\"queryForm\" :model=\"searchForm\" label-width=\"105px\" class=\"xt_form\">\n          <el-row>\n            <el-col :span=\"8\">\n              <el-form-item label=\"品牌:\" prop=\"brand\">\n                <el-select v-model=\"searchForm.brand\"  clearable placeholder=\"请选择WBS编码\">\n                  <el-option\n                    v-for=\"dict in brandList\"\n                    :key=\"dict.dictKey\"  :label=\"dict.dictValue\" :value=\"dict.dictKey\"\n                  >\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"系列:\" prop=\"series\">\n                <el-select v-model=\"searchForm.series\"  clearable placeholder=\"请选择WBS编码\">\n                  <el-option\n                    v-for=\"dict in seriesList\"\n                    :key=\"dict.dictKey\"  :label=\"dict.dictValue\" :value=\"dict.dictKey\"\n                  >\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"型号:\" prop=\"deviceModel\">\n                <el-select v-model=\"searchForm.deviceModel\"  clearable placeholder=\"请选择WBS编码\">\n                  <el-option\n                    v-for=\"dict in deviceModelList\"\n                    :key=\"dict.dictKey\"  :label=\"dict.dictValue\" :value=\"dict.dictKey\"\n                  >\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"设备名称:\" prop=\"deviceName\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.deviceName\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"出厂序列号:\" prop=\"sn\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.sn\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"电源:\" prop=\"powerModel\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.powerModel\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"CPU:\" prop=\"cpuModel\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.cpuModel\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"内存:\" prop=\"memSize\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.memSize\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"硬盘:\" prop=\"hardDiskCapability\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.hardDiskCapability\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"制造商:\" prop=\"supplierName\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.supplierName\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"制作国家及地区:\" prop=\"serialNumber\">\n                <div slot=\"label\" class=\"formLabel\">\n                  制作国家<br>及地区\n                </div>\n                <el-select v-model=\"searchForm.maintenanceCountry\"  clearable placeholder=\"请选择WBS编码\">\n                  <el-option\n                    v-for=\"dict in maintenanceCountryList\"\n                    :key=\"dict.dictKey\"  :label=\"dict.dictValue\" :value=\"dict.dictKey\"\n                  >\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item label=\"地址:\" prop=\"aaa\">\n                <el-input\n                  placeholder=\"请输入\"\n                  clearable\n                  v-model=\"searchForm.aaa\"\n                >\n                </el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n            <el-form-item label=\"生产日期:\" prop=\"factoryDate\">\n              <el-date-picker\n                v-model=\"searchForm.factoryDate\"\n                type=\"date\"\n                clearable\n                placeholder=\"请选择\"\n              ></el-date-picker>\n            </el-form-item>\n          </el-col>\n          </el-row>\n        </el-form>\n        <div class=\"btn-row\">\n          <el-button type=\"primary\"\n                      @click=\"handleSubmit\">保存</el-button>\n          <el-button  style=\"margin-left: 15px;\"\n                      @click=\"handleCancel\">取消</el-button>\n        </div>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { globalattrDetail, globalattrSave } from \"@/api/system/relationManage\";\nimport {getDictList, getDictCmdbList} from \"@/api/dict\";\nexport default {\n  props: ['isShow', 'formData'],\n  data() {\n    return{\n      brandList: [],\n      seriesList: [],\n      deviceModelList: [],\n      maintenanceCountryList: [],\n\n      searchForm: {\n\n      },\n      rules: {\n        name: [\n          { required: true, message: '名称不能为空', trigger: 'blur' },\n        ]\n      },\n      pageLoading: false,\n      saveLoading: false,\n\n\n      dataList: [],\n      selectionList: [],\n      total: 0,\n      tableLoading: false, //表格加载\n      tableHeight: undefined,\n    }\n  },\n  computed: {\n    // ids() {\n    //   let ids = [];\n    //   this.selectionList.forEach(ele => {\n    //     ids.push(ele.id);\n    //   });\n    //   return ids.join(\",\");\n    // },\n  },\n  created() {\n    // this.getDetail()\n    this.searchForm = {...this.formData}\n    // 加载字典\n    this.getDictCmdbList('1082554947272704') // 品牌\n    this.getDictCmdbList('1082609011851264') // 系列\n    this.getDictCmdbList('1082608047161344') // 型号\n    this.getDictCmdbList('1083979207081984') // 国家及地区\n  },\n  methods: {\n    handleSubmit(){\n      this.$emit('setVal', this.searchForm)\n    },\n    handleCancel(){\n      this.$emit('close')\n    },\n    getDictCmdbList(ciId){\n      //加载字典\n      getDictCmdbList({ ciId: ciId }).then(res => {\n        if(ciId==='1082554947272704'){ // 品牌\n          this.brandList  = res.data;\n        }else if(ciId==='1082609011851264'){ // 系列\n          this.seriesList  = res.data;\n        }else if(ciId==='1082608047161344'){ // 型号\n          this.deviceModelList = res.data;\n        }else if(ciId==='1083979207081984'){ // 国家及地区\n          this.maintenanceCountryList = res.data;\n        }\n      });\n    },\n\n    // 详情\n    getDetail() {\n      if(this.showType != '新增') {\n        this.pageLoading = true\n        globalattrDetail({id: this.arrtId}).then(res => {\n          this.pageLoading = false\n          this.submitForm = res.Return\n        }).catch(() => {\n          this.pageLoading = false\n        })\n      }\n    },\n    // 保存\n    save() {\n      this.$refs.submitForm.validate((valid) => {\n        if(valid) {\n          this.saveLoading = true\n          globalattrSave(this.submitForm).then(res => {\n            this.saveLoading = false\n            this.$message({\n              type: 'success',\n              message: '保存成功！'\n            });\n            this.$emit('saveGlobalArrt')\n          }).catch(() => {\n            this.saveLoading = false\n          })\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n  .formLabel{\n    line-height: 20px;\n  }\n  .btn-row{\n    text-align: right;\n  }\n</style>\n"],"mappings":";;;;;;AAuKA,SAAAA,gBAAA,EAAAC,cAAA;AACA,SAAAC,WAAA,EAAAC,eAAA,IAAAA,gBAAA;AACA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,SAAA;MACAC,UAAA;MACAC,eAAA;MACAC,sBAAA;MAEAC,UAAA,GAEA;MACAC,KAAA;QACAC,IAAA,GACA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAC,WAAA;MACAC,WAAA;MAGAC,QAAA;MACAC,aAAA;MACAC,KAAA;MACAC,YAAA;MAAA;MACAC,WAAA,EAAAC;IACA;EACA;EACAC,QAAA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;EAAA,CACA;EACAC,OAAA,WAAAA,QAAA;IACA;IACA,KAAAf,UAAA,GAAAgB,aAAA,UAAAC,QAAA;IACA;IACA,KAAAxB,eAAA;IACA,KAAAA,eAAA;IACA,KAAAA,eAAA;IACA,KAAAA,eAAA;EACA;EACAyB,OAAA;IACAC,YAAA,WAAAA,aAAA;MACA,KAAAC,KAAA,gBAAApB,UAAA;IACA;IACAqB,YAAA,WAAAA,aAAA;MACA,KAAAD,KAAA;IACA;IACA3B,eAAA,WAAAA,gBAAA6B,IAAA;MAAA,IAAAC,KAAA;MACA;MACA9B,gBAAA;QAAA6B,IAAA,EAAAA;MAAA,GAAAE,IAAA,WAAAC,GAAA;QACA,IAAAH,IAAA;UAAA;UACAC,KAAA,CAAA3B,SAAA,GAAA6B,GAAA,CAAA9B,IAAA;QACA,WAAA2B,IAAA;UAAA;UACAC,KAAA,CAAA1B,UAAA,GAAA4B,GAAA,CAAA9B,IAAA;QACA,WAAA2B,IAAA;UAAA;UACAC,KAAA,CAAAzB,eAAA,GAAA2B,GAAA,CAAA9B,IAAA;QACA,WAAA2B,IAAA;UAAA;UACAC,KAAA,CAAAxB,sBAAA,GAAA0B,GAAA,CAAA9B,IAAA;QACA;MACA;IACA;IAEA;IACA+B,SAAA,WAAAA,UAAA;MAAA,IAAAC,MAAA;MACA,SAAAC,QAAA;QACA,KAAAtB,WAAA;QA