type = 'add';\n    },\n    close() {\n      this.componentsParams.isShow = false;\n      this.componentsParams.type = null;\n      this.editRow = null;\n    },\n    getTypeName(type) {\n      switch (type) {\n        case '2':\n          return '市';\n        case '3':\n          return '县';\n        default:\n          return null;\n      }\n    }\n  }\n}\n</script>\n<style lang=\"scss\" scoped>\n.xt-layout-sider {\n  border-radius: 5px\n}\n\n::v-deep .el-tree {\n  background: transparent;\n  color: #46506d;\n}\n\n.theme-xintong .xt-layout .xt-layout-has-sider {\n  width: 320px;\n  min-width: 300px;\n  max-width: 320px;\n  -webkit-box-flex: 0;\n  -ms-flex: 0 0 320px;\n  flex: 0 0 320px;\n  -webkit-transition: all 0.3s;\n  transition: all 0.3s;\n}\n</style>\n"],"mappings":";;;;;;AAoFA,SAAAA,OAAA,IAAAA,QAAA,EAAAC,GAAA;AACA,OAAAC,OAAA;AACA,SAAAC,UAAA;AAEA;EACAC,UAAA;IACAF,OAAA,EAAAA;EACA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,WAAA;MAEAC,QAAA;MACAC,SAAA;MACAC,OAAA;MACAC,gBAAA;QACAC,MAAA;QACAC,IAAA;MACA;IACA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;IACA;IACA,KAAAhB,OAAA;IACA,KAAAiB,SAAA;EACA;EACAC,QAAA,EAAAC,aAAA,CAAAA,aAAA,KACAhB,UAAA;IACAiB,cAAA,WAAAA,eAAA;MACA;QACAC,MAAA,OAAAC,SAAA,MAAAC,UAAA,CAAAC,cAAA;QACAC,OAAA,OAAAH,SAAA,MAAAC,UAAA,CAAAG,eAAA;QACAC,MAAA,OAAAL,SAAA,MAAAC,UAAA,CAAAK,iBAAA;QACAC,OAAA,OAAAP,SAAA,MAAAC,UAAA,CAAAO,eAAA;MACA;IACA;EAAA,EACA;EACAC,OAAA;IACAd,SAAA,WAAAA,UAAA;MACA,KAAAV,QAAA;MACA,KAAAA,QAAA,CAAAyB,IAAA;QACAC,IAAA;QACAC,EAAA;MACA;MACA,KAAA3B,QAAA,CAAAyB,IAAA;QACAC,IAAA;QACAC,EAAA;MACA;IACA;IACAlC,OAAA,WAAAA,QAAA;MAAA,IAAAmC,KAAA;MACA;MACA,KAAA7B,OAAA;MACAN,QAAA,CAAAmB,aAAA,KACA,KAAAX,WAAA,CACA,EAAA4B,IAAA,WAAAC,GAAA;QACAF,KAAA,CAAAzB,SAAA,GAAA2B,GAAA,CAAAhC,IAAA;MACA,GAAAiC,OAAA;QACAH,KAAA,CAAA7B,OAAA;MACA;IACA;IACAiC,YAAA,WAAAA,aAAAL,EAAA;MAAA,IAAAM,MAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACA7B,IAAA;MACA,GAAAsB,IAAA;QACA,OAAAnC,GAAA;UAAAiC,EAAA,EAAAA;QAAA;MACA,GAAAE,IAAA;QACAI,MAAA,CAAAxC,OAAA;QACAwC,MAAA,CAAAI,QAAA;UACA9B