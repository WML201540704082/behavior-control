e=\"font-size: 33px;color:#022eff\"></i>\n        <div class=\"menus-item-text\">新建知识</div>\n      </div>\n      <div class=\"menus-item\" @click=\"showUpload3 = true\">\n        <i class=\"el-icon-document\" style=\"font-size: 33px;color:#022eff\"></i>\n        <div class=\"menus-item-text\">我的知识</div>\n      </div>\n    </div>\n    <div class=\"left\">\n      <div class=\"history_search\">\n        <el-autocomplete\n          v-model=\"historySearchText\"\n          :fetch-suggestions=\"querySearchAsync\"\n          placeholder=\"请输入内容\"\n          @select=\"handleSelect\"\n          @keyup.enter.native=\"handleHistorySearch\"\n          style=\"width:100%\"\n        >\n          <i slot=\"prefix\" class=\"el-input__icon el-icon-search\"></i>\n        </el-autocomplete>\n      </div>\n      <div class=\"history_content\">\n        <div class=\"title\">历史对话</div>\n        <div class=\"history_list\">\n          <div\n            class=\"history_list_item\"\n            v-for=\"(item, index) in historyList\"\n            :key=\"index\"\n            :class=\"active == index? 'is_active':''\"\n             @click=\"seeHistoryDetail(item,index)\"\n          >\n            <div class=\"item_left\">\n              <div class=\"title\">{{item.problem}}</div>\n              <div class=\"time\">{{item.time}}</div>\n            </div>\n            <div class=\"item_right\">\n              <!-- <i class=\"el-icon-view\" @click=\"seeHistoryDetail(item,index)\"></i> -->\n              <img src=\"../img/delicon.png\" @click.stop=\"delHistory(item)\"/>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"right\">\n      <div class=\"search_box\">\n        <el-input placeholder=\"请输入内容\" v-model=\"searchText\" style=\"width:100%\" @keyup.enter.native=\"answerSearch(1)\" @submit.native.prevent @input=\"handleSearchText\">\n          <div slot=\"append\" class=\"searchbtn\" @click=\"answerSearch(1)\">搜索</div>\n        </el-input>\n        <el-button type=\"info\" @click=\"handleReset\" style=\"margin-left: 10px;height: 40px;\">重置</el-button>\n      </div>\n      <div class=\"ai-wrap\">\n      </div>\n      <div class=\"search_list\" v-if=\"searchContentList.length>0\">\n        <div\n          class=\"search_list_item\"\n          v-for=\"(item, index) in searchContentList\"\n          :key=\"index\"\n        >\n          <img src=\"../img/searchIcon.png\" alt=\"\" class=\"search_icon\">\n          <div class=\"title\">{{item.problem}}</div>\n          <div class=\"content\">{{item.answer}}</div>\n          <div class=\"btnn\">\n            <template>\n              <el-button type=\"primary\" size=\"mini\" @click=\"handlelCollect(item)\" v-if=\"item.collectFlag=='未收藏'\">收藏</el-button>\n              <el-tag type=\"success\" v-else> 已收藏 </el-tag>\n            </template>\n            <template>\n              <el-button type=\"primary\" size=\"mini\" @click=\"handlelStudy(item)\" v-if=\"item.learnFlag=='未学习'\" style=\"margin-left: 10px\">学习</el-button>\n              <el-tag type=\"success\" v-else style=\"margin-left: 10px\">已学习</el-tag>\n            </template>\n\n          </div>\n\n        </div>\n      </div>\n      <div v-else class=\"search_empty\">\n        <div class=\"search_emptyc\">\n          <div class=\"search_emptycl\">\n            <div class=\"search_emptyct\">最新知识 ></div>\n            <div class=\"search_emptycc\" v-loading=\"newLoading\">\n              <div\n                class=\"search_emptyc_item\"\n                v-for=\"(item, index) in newList\"\n                :key=\"index\"\n                @click=\"handleClick(item.problem)\">\n                <span :class=\"'col'+index\">{{ index+1 }}</span>\n                {{ item.problem }}\n              </div>\n            </div>\n          </div>\n          <div class=\"search_emptycr\">\n            <div class=\"search_emptyct\">\n              知识热搜 >\n              <el-radio-group v-model=\"month\" @change=\"handleChange\" size=\"mini\" style=\"width: auto;\">\n                <el-radio-button :label=\"1\">日</el-radio-button>\n                <el-radio-button :label=\"2\">周</el-radio-button>\n                <el-radio-button :label=\"3\">月</el-radio-button>\n              </el-radio-group>\n            </div>\n            <div class=\"search_emptycc\" v-loading=\"logLoading\">\n              <div\n                class=\"search_emptyc_item\"\n                v-for=\"(item, index) in logList\"\n                :key=\"index\"\n                @click=\"handleClick(item.problem)\">\n                <span :class=\"'col'+index\">{{ index+1 }}</span>\n                {{ item.problem }}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- <div v-else class=\"search_empty\" style=\"color:#909399\">\n        {{ searchText==''||!isSearch? '请输入您的问题...':'暂无回答'}}\n      </div> -->\n    </div>\n\n    <!-- 上传问题弹窗 -->\n    <uploadQuestion\n      v-if=\"showUpload\"\n      :isShow=\"showUpload\"\n      @close=\"showUpload = false\"\n    ></uploadQuestion>\n    <!-- 新建知识弹窗 -->\n    <addKnowledge\n      v-if=\"showUpload2\"\n      :isShow=\"showUpload2\"\n      @close=\"showUpload2 = false\"\n    ></addKnowledge>\n    <!-- 我的知识弹窗 -->\n    <myKnowledge\n      v-if=\"showUpload3\"\n      :isShow=\"showUpload3\"\n      @close=\"showUpload3 = false\"\n    ></myKnowledge>\n  </div>\n\n\n  <div class=\"intelligenceAnswer\" v-else>\n    <iframe\n      src=\"http://25.41.75.98:32360/chatbot/yOvZPTTLjsTFtEzS\"\n      style=\"width: 100%; height: 100%; min-height: 700px\"\n      allow=\"microphone\">\n    </iframe>\n  </div>\n</div>\n</template>\n\n<script>\nimport { knowledgeList, historyAnswerList, historyAnswerDelete, collect, learnSave, logStastic, newKnowledge } from \"@/api/ictOperation/index\"\nimport { formatDate } from \"@/util/date\"\nimport uploadQuestion from './intelligenceAnswer/uploadQuestion'\nimport addKnowledge from './intelligenceAnswer/addKnowledg