dth=\"80px\" class=\"xt_search_form\">\n        <el-row>\n          <el-col :span=\"6\">\n            <el-form-item label=\"设备名称\" prop=\"objectName\">\n              <el-input\n                placeholder=\"请输入设备名称\"\n                clearable\n                v-model=\"searchForm.objectName\"\n              ></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"工单编号\">\n              <el-input\n                placeholder=\"请输入工单编号\"\n                clearable\n                v-model=\"searchForm.repairId\"\n              ></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"检修人员\" prop=\"feedbackPerson\">\n              <el-input\n                placeholder=\"请输入检修人员\"\n                clearable\n                v-model=\"searchForm.feedbackPerson\"\n              ></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\" align=\"right\">\n            <el-button type=\"primary\" @click=\"handleQuery\" style=\"margin-right: 5px;\">查询</el-button>\n            <el-button type=\"primary\" plain @click=\"handleReset\">重置</el-button>\n          </el-col>\n        </el-row>\n      </el-form>\n      <!--      </el-card>-->\n    </div>\n    <div class=\"page_body\">\n      <el-table :data=\"tableData\" :height=\"tableHeight\" stripe size=\"small\" v-loading=\"tableLoading\">\n        <el-table-column label=\"设备名称\" prop=\"objectName\" width=\"200\" align=\"center\"\n                         show-overflow-tooltip></el-table-column>\n        <el-table-column label=\"工单编号\" prop=\"repairId\" width=\"170\" align=\"center\"\n                         show-overflow-tooltip></el-table-column>\n        <el-table-column label=\"检修内容\" prop=\"description\" min-width=\"260\" align=\"center\" show-overflow-tooltip>\n          <template slot-scope=\"scope\">\n            <span>{{ !scope.row.description? '-' : scope.row.description}}</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"终结内容\" prop=\"feedbackContent\" min-width=\"260\" align=\"center\" show-overflow-tooltip>\n          <template slot-scope=\"scope\">\n            <span>{{ !scope.row.feedbackContent? '-' : scope.row.feedbackContent}}</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"检修人员\" prop=\"feedbackPerson\" width=\"120\" align=\"center\"\n                         show-overflow-tooltip></el-table-column>\n        <el-table-column label=\"检修时间\" prop=\"feedbackTime\" width=\"140\" align=\"center\"\n                         show-overflow-tooltip></el-table-column>\n        <el-table-column label=\"公司\" prop=\"companyName\" min-width=\"220\" align=\"center\"\n                         show-overflow-tooltip></el-table-column>\n        <el-table-column label=\"操作\" align=\"center\" width=\"120\" fixed=\"right\" show-overflow-tooltip>\n          <template slot-scope=\"scope\">\n            <div>\n              <el-link type=\"primary\" size=\"mini\" :underline=\"false\" @click=\"handleDetail(scope.row)\">\n                <span class=\"s_lt\">详情</span>\n              </el-link>\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n      <pagination\n        :total=\"total\"\n        :page.sync=\"searchForm.pageNo\"\n        :limit.sync=\"searchForm.pageSize\"\n        :pageSizes=\"[20,50,100,200]\"\n        @pagination=\"getList\"/>\n    </div>\n  </div>\n</template>\n\n<script>\nimport {mapGetters} from \"vuex\";\nimport {getRepairRecordPage} from \"@/api/xcnanr/record\";\n\nexport default {\n  components: {},\n  computed: {\n    ...mapGetters([\"permission\", \"userInfo\", 'userDetail'])\n  },\n  data() {\n    return {\n      userInfo: this.$store.state.user.userDetail,\n      // 查询对象\n      searchForm: {\n        pageNumber: 1,\n        pageSize: 10,\n      },\n      total: 0,\n   