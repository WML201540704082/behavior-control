ciId: '',\n        ciName: '',\n        ciLabel: ''\n      };\n    },\n    mounted() {\n      this.page = {currentPage: 1, pageSize: 20, total: 0,};\n      this.getList();\n    },\n    methods: {\n      getList() {\n        this.tableloading = true;\n        getList(this.page.currentPage, this.page.pageSize, this.queryParams).then(res => {\n          const data = res.data;\n          this.page.total = data.total;\n          this.tableData = data.records;\n          this.tableloading = false;\n        });\n      },\n      handelAdd() {\n        this.type = 'add';\n        this.showAddEdit = true;\n      },\n      handleEdit(row) {\n        this.type = 'edit';\n        this.showAddEdit = true;\n        this.fromValue = row;\n      },\n      handelDelete(id) {\n        if (id) {\n          this.$confirm(\"确定将选择数据删除?\", {\n            confirmButtonText: \"确定\",\n            cancelButtonText: \"取消\",\n            type: \"warning\"\n          }).then(() => {\n            return remove(id);\n          }).then(() => {\n            this.getList();\n            this.$message({\n              type: \"success\",\n              message: \"删除成功!\"\n            });\n          });\n        } else {\n          if (this.$refs.table.selection.length === 0) {\n            this.$message.warning(\"请选择至少一条数据\");\n            return;\n          }\n          this.$confirm(\"确定将选择数据删除?\", {\n            confirmButtonText: \"确定\",\n            cancelButtonText: \"取消\",\n            type: \"warning\"\n          }).then(() => {\n            let ids = this.$refs.table.selection.map((item, index) => {\n              return item.id\n            }).join(',');\n            return remove(ids);\n          }).then(() => {\n            this.getList();\n            this.$message({\n              type: \"success\",\n              message: \"操作成功!\"\n            });\n          });\n        }\n      },\n      handleYs(row) {\n        this.showArrt = true;\n        this.ciId = row.selectCiId;\n        this.ciName = row.selectCiName;\n        this.ciLabel = row.ciLabel;\n      },\n      getIsExistCascadeText(isExistCascadeText) {\n        if (isExistCascadeText == '0') {\n          return '否';\n        } else if (isExistCascadeText == '1') {\n          return '是';\n        }\n        return null;\n      },\n      Nindex(index) {\n        return index + 1 + (this.page.currentPage - 1) * this.page.pageSize;\n      },\n      reset() {\n        this.queryParams = {};\n        this.page = {currentPage: 1, pageSize: 20, total: 0,};\n        this.getList();\n      },\n    },\n  }\n</script>\n<style scoped lang=\"scss\">\n  .d_stext {\n    padding: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .d_stext span {\n    font-size: 14px;\n    color: #666666;\n  }\n\n  .d_sb {\n    display: flex;\n    justify-content: space-between;\n  }\n\n  .d_end {\n    display: flex;\n    justify-content: flex-end;\n  }\n</style>\n"],"mappings":"AA6EA,SAAAA,OAAA,IAAAA,QAAA;AACA,OAAAC,WAAA;AACA,OAAAC,cAAA;AACA,OAAAC,WAAA;AACA;AACA;EACAC,IAAA;EACAC,UAAA;IAAAF,WAAA,EAAAA,WAAA;IAAAD,cAAA,EAAAA,cAAA;IAAAD,WAAA,EAAAA;EAAA;EACAK,IAAA,WAAAA,KAAA;IACA;MACAC,YAAA;MACAC,WAAA;MACAC,IAAA;QACAC,WAAA;QACAC,QAAA;QACAC,KAAA;MACA;MACAC,SAAA;MAEAC,WAAA;MACAC,SAAA;MACAC,IAAA;MAEAC,QAAA;MACAC,IAAA;MACAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAZ,IAAA;MAAAC,WAAA;MAAAC,QAAA;MAAAC,KAAA;IAAA;IACA,KAAAZ,OAAA;EACA;EACAsB,OAAA;IACAtB,OAAA,WAAAA,QAAA;MAAA,IAAAuB,KAAA;MACA,KAAAhB,YAAA;MACAP,QAAA,MAAAS,IAAA,CAAAC,WAAA,OAAAD,IAAA,CAAAE,QAAA,OAAAH,WAAA,EAAAgB,IAAA,WAAAC,GAAA;QACA,IAAAnB,IAAA,GAAAmB,GAAA,CAAAnB,IAAA;QACAiB,KAAA,CAAAd,IAAA,CAAAG,KAAA,GAAAN,IAAA,CAAAM,KAAA;QACAW,KAAA,CAAAV,SAAA,GAAAP,IAAA,CAAAoB,OAAA;QACAH,KAAA,CAAAhB,YAAA;MACA;IACA;IACAoB,SAAA,WAAAA,UAAA;MACA,KAAAX,IAAA;MACA,KAAAF,WAAA;IACA;IACAc,UAAA,WAAAA,WAAAC,GAAA;MACA,KAAAb,IAAA;MACA,KAAAF,WAAA;MACA,KAAAC,SAAA,GAAAc,GAAA;IACA;IACAC,YAAA,WAAAA,aAAAC,EAAA;MAAA,IAAAC,MAAA;MACA,IAAAD,EAAA;QACA,KAAAE,QAAA