 </el-form-item>\n        </el-col>\n      </el-row>\n    </el-form>\n\n    <div class=\"page_body\">\n      <el-row>\n        <formTitle :titleText=\"'列表'\" :titleType=\"'page_title'\">\n          <div slot=\"rightBtnBox\">\n            <el-button\n              type=\"primary\"\n              size=\"small\"\n              icon=\"el-icon-search\"\n              @click=\"handleQuery\"\n            >查询\n            </el-button\n            >\n            <el-button\n              class=\"border-btn\"\n              size=\"small\"\n              icon=\"el-icon-refresh\"\n              @click=\"searchReset\"\n            >重置\n            </el-button\n            >\n          </div>\n        </formTitle>\n      </el-row>\n      <el-table\n        ref=\"deviceTable\"\n        :data=\"deviceList\"\n        v-loading=\"loading\"\n        size=\"small\"\n        height=\"360px\"\n      >\n        <el-table-column\n          type=\"index\"\n          label=\"序号\"\n          width=\"50\"\n          align=\"center\"\n        ></el-table-column>\n        <el-table-column\n          label=\"设备编码\"\n          prop=\"deviceCode\"\n          min-width=\"140\"\n          align=\"center\"\n        >\n        </el-table-column>\n        <el-table-column\n          prop=\"deviceType\"\n          label=\"设备类型\"\n          min-width=\"140\"\n          align=\"center\"\n        >\n          <template slot-scope=\"scope\">\n            <span>{{ showLabel(scope.row.deviceType, deviceTypeList) }}</span>\n          </template>\n        </el-table-column>\n\n        <el-table-column\n          prop=\"receiveDept\"\n          label=\"所在部门\"\n          min-width=\"80\"\n          align=\"center\"\n        >\n        </el-table-column>\n\n        <el-table-column\n          prop=\"deviceStatus\"\n          label=\"设备状态\"\n          min-width=\"80\"\n          align=\"center\"\n        >\n          <template slot-scope=\"scope\">\n            <span>{{\n                showLabel(scope.row.deviceStatus, deviceStatusList)\n              }}</span>\n          </template>\n        </el-table-column>\n\n        <el-table-column prop=\"user\" label=\"使用人\" min-width=\"80\" align=\"center\">\n        </el-table-column>\n\n        <el-table-column\n          prop=\"receivingPerson\"\n          label=\"使用责任人\"\n          min-width=\"160\"\n          align=\"center\"\n        >\n        </el-table-column>\n\n        <el-table-column\n          prop=\"receivingTel\"\n          label=\"使用责任人联系方式\"\n          min-width=\"160\"\n          align=\"center\"\n        >\n        </el-table-column>\n\n        <el-table-column\n          prop=\"disposeStatus\"\n          label=\"处置状态\"\n          min-width=\"80\"\n          align=\"center\"\n        >\n          <template slot-scope=\"scope\">\n            <div class=\"status_chuzhi\">\n              <div\n                class=\"cicle\"\n                :class=\"\n                  scope.row.disposeStatus === '1' ? 'approved' : 'unApprove'\n                \"\n              ></div>\n              <div>\n                {{ scope.row.disposeStatus == \"0\" ? \"待处置\" : \"已处置\" }}\n              </div>\n            </div>\n          </template>\n        </el-table-column>\n\n        <el-table-column\n          prop=\"address\"\n          label=\"处置结果\"\n          min-width=\"80\"\n          align=\"center\"\n        >\n          <template slot-scope=\"scope\">\n            <div style=\"display:flex;\">\n              <span>\n                {{ showLabel(scope.row.disposeResult, chuzhiList) }}\n              </span>\n              <el-tooltip placement=\"top\" v-if=\"scope.row.disposeResult == '4'\">\n                <div slot=\"content\">\n                  断网开始时间：{{ scope.row.offlineStartTime }} <br/>断网恢复时间：{{\n                    scope.row.offlineEndTime\n                  }}\n                </div>\n                <i class=\"el-icon-info\" style=\"color: #409eff\"> </i>\n              </el-tooltip>\n            </div>\n\n          </template>\n        </el-table-column>\n\n        <el-table-column\n          prop=\"installationSite\"\n          label=\"安装位置\"\n          min-width=\"160\"\n          align=\"center\"\n        >\n        </el-table-column>\n\n        <el-table-column label=\"操作\" width=\"160\" align=\"center\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button\n              type=\"text\"\n              class=\"list_btn\"\n              size=\"small\"\n              v-if=\"scope.row.disposeResult =='0' || scope.row.disposeResult =='3'\"\n              :disabled=\"scope.row.disposeResult =='3'\"\n              @click=\"tuiwang(scope.row.id)\"\n            >临时退网\n            </el-button>\n            <el-button\n              type=\"text\"\n              class=\"list_btn\"\n              size=\"small\"\n              v-if=\"scope.row.disposeResult =='5'\"\n              @click=\"ruwang(scope.row.id)\"\n            >恢复入网\n            </el-button>\n\n            <el-button\n              type=\"text\"\n              class=\"list_btn btn_red\"\n              size=\"small\"\n              v-if=\"scope.row.disposeResult =='5' || scope.row.disposeResult =='0'|| scope.row.disposeResult =='3'|| scope.row.disposeResult =='4'\"\n              :disabled=\"scope.row.disposeResult =='3'\"\n              @click=\"tuiyun(scope.row.id)\"\n            >退运\n            </el-button>\n            <el-button\n              type=\"text\"\n              class=\"list_btn\"\n              size=\"small\"\n              @click=\"$message.success('操作成功')\"\n            >设备变更\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <pagination\n        :total=\"total\"\n        :page.sync=\"searchForm.current\"\n        :limit.sync=\"searchForm.size\"\n        @pagination=\"getDeviceList\"\n      />\n\n    </div>\n\n  </div>\n</template>\n\n<script>\nimport xtTreeLzaySelect from \"@/components/xtTreeLzaySelect/index.vue\";\nimpo