age: \"操作成功!\"\n        });\n        //重新重新加载已经选择的数据。。。待实现\n      });\n    },\n    showDictLable: function showDictLable(code, dictList) {\n      //字典回显\n      if (dictList != null && code !== '') {\n        var items = dictList.filter(function (item) {\n          return item.dictKey == code;\n        });\n        if (items != null && items.length > 0) {\n          return items[0].dictValue;\n        }\n      }\n      return code;\n    },\n    showProcessStatus: function showProcessStatus(code, dictList) {\n      //字典回显\n      if (dictList != null && code !== '') {\n        var items = dictList.filter(function (item) {\n          return item.node == code;\n        });\n        if (items != null && items.length > 0) {\n          return items[0].nodeName;\n        } else {\n          return '暂存';\n        }\n      }\n      return code;\n    },\n    searchReset: function searchReset() {\n      //重置按钮\n      // this.$refs.searchForm.resetFields();\n      this.searchForm = {\n        current: 1,\n        size: 20,\n        applyUnitName: this.userDetail.ownerUnitName,\n        applyUnit: this.userDetail.ownerUnit\n      };\n      this.submitDates = undefined;\n      this.onLoad();\n    },\n    selectionChange: function selectionChange(selection) {\n      //点击选择事件\n      this.selectionList = selection.map(function (item) {\n        return item.id;\n      });\n    },\n    selectionClear: function selectionClear() {\n      //清除选择\n      this.selectionList = [];\n      this.$refs.dataTable.clearSelection();\n    },\n    dataPickerChange: function dataPickerChange(createTimes) {\n      //时间段选择\n      if (createTimes != null && createTimes.length > 0) {\n        this.searchForm.beginTime = createTimes[0] + ' 00:00:00';\n        this.searchForm.endTime = createTimes[1] + ' 23:59:59';\n      } else {\n        this.searchForm.beginTime = null;\n        this.searchForm.endTime = null;\n      }\n    },\n    onLoad: function onLoad() {\n      var _this5 = this;\n      //加载数据\n      