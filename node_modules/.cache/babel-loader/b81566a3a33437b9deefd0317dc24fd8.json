cess('添加成功');\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          } else if (this.type == 'edit') {\n            this.saveLoading = true;\n            update([this.formDetial]).then(res => {\n              this.saveLoading = false\n              this.$message.success('修改成功');\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          }\n        }\n      })\n    },\n    getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.d_end button {\n  width: 100px;\n}\n</style>\n"],"mappings":"AAoDA,SAAAA,GAAA,EAAAC,MAAA;AACA,SAAAC,OAAA;AACA,SAAAC,aAAA;AAEA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,WAAA;MACAC,QAAA;MACAC,KAAA;QACAC,UAAA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAC,UAAA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAE,QAAA;UAAAJ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAG,QAAA;UAAAL,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAI,GAAA;UAAAN,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAK,IAAA;UAAAP,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IACA;EACA;EACAM,QAAA;EACAC,OAAA,WAAAA,QAAA;IACA,UAAAC,UAAA;MACA,KAAAA,UAAA;IACA;IACA,KAAAC,SAAA;EACA;EACAC,OAAA;IACAD,SAAA,WAAAA,UAAA;MACA,KAAAd,QAAA;MACA,KAAAA,QAAA,CAAAgB,IAAA;QACAC,IAAA;QACAC,EAAA;MACA;MACA,KAAAlB,QAAA,CAAAgB,IAAA;QACAC,IAAA;QACAC,EAAA;MACA;IACA;IACAC,eAAA,WAAAA,gBAAAC,GAAA;MACA,KAAAC,aAAA,GAAAD,GAAA;IACA;IACAE,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,KAAA,CAAAC,UAAA,CAAAC,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACA,IAAAJ,KAAA,CAAAb,IAAA;YACAa,KAAA,CAAAxB,WAAA;YACAN,GAAA,EAAA8B,KAAA,CAAAV,UAAA,GAAAe,IAAA,WAAAC,GAAA;cACAN,KAAA,CAAAxB,WAAA;cACAwB,KAAA,CAAAO,QAAA,CAAAC,OAAA;cACAR,KAAA,CAAAS,KAAA;cACAT,KAAA,CAAAS,KAAA;YACA;UACA,WAAAT,KAAA,CAAAb,IAAA;YACAa,KAAA,CAAAxB,WAAA;YACAL,MAAA,EAAA6B,KAAA,CAAAV,UAAA,GAAAe,IAAA,WAAAC,