    <!-- <div class=\"submit_btn\">\n        <el-button size=\"small\" @click=\"$emit('close')\">取 消</el-button>\n      </div> -->\n    </el-dialog>\n\n\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => isShow2=false\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"isShow2\"\n      title=\"详情\"\n      width=\"1000px\"\n      top=\"15vh\"\n      v-el-drag-dialog\n    >\n      <div class=\"historyTable\">\n        <div class=\"historyHang\">\n          <div class=\"cell\"></div>\n          <div class=\"cell\">类型</div>\n          <div class=\"cell diffHeader\">\n            <div>修改前</div>\n            <div>修改后</div>\n          </div>\n        </div>\n\n        <div class=\"historyHang\"\n          v-for=\"row in details\"\n          :key=\"row.id\"\n        >\n          <div class=\"cell\">{{ row.label }}</div>\n          <div class=\"cell\">{{ row.type == \"globalattr\" ? '全局属性':'属性' }}</div>\n          <div class=\"cell diffHeader\">\n            <template v-if=\"row.type == 'globalattr'\"> \n              <div>{{ row.oldValue && row.oldValue.map(el=>el.value).join(',') }}</div>\n              <div>{{ row.newValue && row.newValue.map(el=>el.value).join(',') }}</div>\n            </template>\n            <template v-else>\n              <div>{{ row.oldValue && row.oldValue.actualValueList.join(',') }}</div>\n              <div>{{ row.newValue && row.newValue.actualValueList.join(',') }}</div>\n            </template>\n          </div>\n        </div>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { deleteConfig, transactionSearch, transactionGet } from \"@/api/cmdb/ciConfig\";\nimport { dateFormat } from \"@/util/date\";\n\nexport default {\n  props: ['isShow', \"configId\"],\n  data() {\n    return{\n      activities: [],\n      details: [],\n      isShow2: false\n    }\n  },\n  mounted() {\n    this.getList()\n  },\n  methods: {\n    handleDetail(row){\n      transactionGet({\n        ciEntityId: row.ciEntityId,\n        ciId: row.ciId,\n        transactionId: row.id\n      }).then(res=>{\n        this.details = res.Return.detail\n      })\n      this.isShow2 = true\n    },\n    dateFormat2(time){\n      return dateFormat( new Date(time), 'yyyy-MM-dd hh:mm' )\n    },\n    getList(){\n      transactionSearch({ \n        statusList: [\"commited\", \"recover\"],\n        pageSize: 100,\n        ciEntityId: this.configId \n      }).then(res=>{\n        // console.log(1, res.Return.tbodyList)\n        this.activities = res.Return.tbodyList\n      })\n    },\n    \n   \n  }\n}\n</script>\n<style lang=\"scss\" scoped>\n  .historyTable{\n    overflow-y: auto;\n    overflow-x: hidden;\n    padding-top: 0px;\n    max-height: calc((100vh - 254px) - 24px);\n    .historyHang{\n      display: grid;\n      grid-template-columns: 150px 80px auto;\n      .cell{\n        padding: 9px;\n        border-bottom: 1px solid #e5e5e5;\n      }\n      .diffHeader{\n        display: grid;\n        grid-template-columns: 50% 50%;\n        grid-gap: 10px;\n        word-break: break-all;\n      }\n    }\n  }\n\n\n\n  .content{\n    color: #333;\n    \n    .hang1{\n      span{\n        margin-right: 6px;\n      }\n    }\n    .hang2{\n      span{\n        margin-right: 6px;\n        color: #8c8c8c;\n      }\n    }\n    .hang3{\n      span{\n        margin-right: 6px;\n        color: #8c8c8c;\n      }\n      .span2{\n        margin-left: 6px;\n        color: #1670f0;\n        cursor: pointer;\n      }\n    }\n  }\n</style>"],"mappings":"AAwFA,SAAAA,YAAA,EAAAC,iBAAA,EAAAC,cAAA;AACA,SAAAC,UAAA;AAEA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;MACAC,OAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,OAAA;EACA;EACAC,OAAA;IACAC,YAAA,WAAAA,aAAAC,GAAA;MAAA,IAAAC,KAAA;MACAZ,cAAA;QACAa,UAAA,EAAAF,GAAA,CAAAE,UAAA;QACAC,IAAA,EAAAH,GAAA,CAAAG,IAAA;QACAC,aAAA,EAAAJ,GAAA,CAAAK;MACA,GAAAC,IAAA,WAAAC,GAAA;QACAN,KAAA,CAAAP,OAAA,GAAAa,GAAA,CAAAC,MAAA,CAAAC,MAAA;MACA;MACA,KAAAd,OA