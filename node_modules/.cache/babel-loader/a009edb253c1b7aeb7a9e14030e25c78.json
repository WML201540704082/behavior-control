: function handleImg(url) {\n      this.dialogVisible = true;\n      this.imgUrl = url;\n    },\n    // 渲染表格\n    showInfo: function showInfo() {\n      var _this = this;\n      this.formData.status = 0;\n      if (this.detailId) {\n        orderId(this.detailId).then(function (response) {\n          _this.formData = Object.assign({}, response.data);\n          // 获取 隐患分类二级列表\n          _this.changeHiddenCategory(_this.formData.hiddenCategory);\n          var filesArr = response.data.evidenceDTOList;\n          _this.filesArrImg1 = filesArr.filter(function (el) {\n            return el.textImages == 1 && (el.type == 2 || el.type == 0);\n          });\n          _this.filesArrFile1 = filesArr.filter(function (el) {\n            return el.textImages == 0 && (el.type == 2 || el.type == 0);\n          });\n          _this.filesArrImg2 = filesArr.filter(function (el) {\n            return el.textImages == 1 && el.type == 1;\n          });\n          _this.filesArrFile2 = filesArr.filter(function (el) {\n            return el.textImages == 0 && el.type == 1;\n          });\n        });\n      }\n    },\n    // 获取下拉列表\n    initData: function initData() {\n      var _this2 = this;\n      queryShortNameList({\n        parentId: this.companyCode.slice(0, 4)\n      }).then(function (response) {\n        _this2.basicUnitSeconds = response.data;\n      });\n      this.getDicts('hidden_source').then(function (response) {\n        _this2.hiddenSourceList = response.data;\n      });\n      this.getDicts('hidden_category').then(function (response) {\n        _this2.hiddenCategoryList = response.data;\n      });\n      securitySupervision().then(function (res) {\n        _this2.supervisionList = res.data;\n      });\n      allCategory().then(function (res) {\n        _this2.categoryList = res.data;\n      });\n    },\n    // 隐患分类选中\n    changeHiddenCategory: function changeHiddenCategory(value) {\n      if (value) {\n        var data;\n        if (value == 0) {\n          // 机房\n          data = this.categoryList;\n          data.forEach(function (el) {\n            return el.dictLabel = el.category;\n          });\n        } else {\n          data = this.supervisionList;\n          data.forEach(function (el) {\n            return el.dictLabel = el.supervision;\n          });\n        }\n        this.hiddenCategoryList2 = data;\n      } else {\n        this.hiddenCategoryList2 = [];\n      }\n    },\n    // 格式化数据\n    formatHiddenSource: function formatHiddenSource(row) {\n      return this.selectDictLabel(this.hiddenSourceList, row.hiddenSource);\n    },\n    formatHiddenCategory: function formatHiddenCategory(row) {\n      return this.selectDictLabel(this.hiddenCategoryList, row.hiddenCategory);\n    },\n    formatHiddenCategory2: function formatHiddenCategory2(row) {\n      if (this.hiddenCategoryList2.filter(function (el) {\n        return el.id == row.hiddenType;\n      })[0]) {\n        return this.hiddenCategoryList2.filter(function (el) {\n          return el.id == row.hiddenType;\n        })[0].dictLabel;\n      }\n    },\n    formatState: function formatState(row) {\n      return this.selectDictLabel(this.statusList, row.status);\n    },\n    formatRectificationStatus: function formatRectificationStatus(row) {\n      if (row.rectificationStatus == 0) {\n        return '未完成';\n      }\n      if (row.rectificationStatus == 1) {\n        return '已完成';\n      }\n    },\n    formatSecondCompany: function formatSecondCompany(row) {\n      if (!row.secondCompany) return '';\n      var data = this.basicUnitSeconds;\n      for (var i = 0; i < data.length; i++) {\n        if (row.secondCompany == data[i].orgId) {\n          return data[i].shortName;\n        }\n      }\n    }\n  }\n};",{"version":3,"names":["mapGetters","orderId","orderAdd","orderUpdate","queryShortNameList","createFlow","sendBpm","backToLastItem","queryNextFlowUsers","securitySupervision","allCategory","SecondSlot","name","components","computed","_objectSpread","srcList1","fil