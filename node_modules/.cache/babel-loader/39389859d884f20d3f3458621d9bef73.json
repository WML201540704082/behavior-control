n (err) {\n        console.log(err);\n        _this2.$message.error('下载报告失败');\n      });\n    },\n    exportFile: function exportFile(fileName) {\n      var _this3 = this;\n      var paramsInfo = this.paramsInfo;\n      var reportData = this.reportData;\n      var newFileName = paramsInfo.companyName + paramsInfo.objectName + '巡视报告(' + reportData.startDate + '至' + reportData.finishDate + ')';\n      exportReportFile(fileName).then(function (res) {\n        downloadFile(res, newFileName, 'docx');\n      }).catch(function (err) {\n        console.log(err);\n        _this3.$message.error('报告导出失败');\n      });\n    },\n    getViewData: function getViewData() {\n      var _this = this;\n      _this.reportData = {};\n      getReportData(this.paramsInfo).then(function (res) {\n        if (res.success) {\n          _this.reportData = res.data;\n        } else {\n          _this.$message.warning(res.msg);\n        }\n      }).catch(function (err) {\n        console.log(err);\n        _this.$message.error('获取报告数据失败');\n      });\n    }\n  }\n};",{"version":3,"names":["OrderBar","RoomPie","getReportData","createReportFile","exportReportFile","downloadFile","name","components","data","paramsInfo","inspectionMonth","companyId","companyName","deptName","objectId","objectName","type","reportData","startDate","finishDate","inspectCount","planCount","personNum","abnormalNum","solvedNum","unsolvedNum","planList","no","period","times","index","workerName","abnormalList","code","feedbackContent","feedbackPerson","configDetailName","personChartData","personName","orderNum","planOrderChartData","value","created","$route","query","getViewData","methods","handleDownload","_this2","_this","$message","success","then","res","exportFile","error","catch","err","console","log","fileName","_this3","newFileName","warning","msg"],"sources":["src/views/xcnanr/statisticalAnalysis/oldStatistics/report/index.vue"],"sourcesContent":["<template>\n  <basic-container>\n    <el-row type=\"flex\" class=\"row-bg\" justify=\"center\">\n      <el-col :span=\"12\">\n        <!-- 报告内容 -->\n        <el-row>\n          <el-col :span=\"24\" class=\"text-title\">{{ paramsInfo.companyName}}{{paramsInfo.objectName}}</el-col>\n          <el-col :span=\"24\" class=\"text-title\">巡视报告</el-col>\n        </el-row>\n        <p class=\"text-content\">\n          {{reportData.startDate}}至{{reportData.finishDate}}，{{paramsInfo.companyName}}{{paramsInfo.deptName}}共执行巡视{{paramsInfo.type == 1? '机房' : '设备'}}{{reportData.inspectCount}}次，\n          涉及{{reportData.planCount}}个巡视计划、{{reportData.personNum}}个巡视人员，巡视过程中发现异常{{reportData.abnormalNum}}处，\n          其中已解决{{reportData.solvedNum}}处，待解决{{reportData.unsolvedNum}}处。\n        </p>\n        <p class=\"text-content\">{{paramsInfo.objectName}}巡视计划如下：</p>\n        <el-row>\n          <el-table ref=\"planTable\" :data=\"reportData.planList\" size=\"small\">\n            <el-table-column type=\"index\" width=\"50\" align=\"center\"></el-table-column>\n            <el-table-column label=\"计划编号\" prop=\"no\" min-width=\"150\" align=\"center\"/>\n            <el-table-column label=\"计划类别\" prop=\"period\" min-width=\"150\" align=\"center\" />\n            <el-table-column label=\"巡视时间段\" prop=\"times\" min-width=\"150\" align=\"center\" />\n            <el-table-column label=\"巡视人\" prop=\"workerName\" min-width=\"150\" align=\"center\" />\n          </el-table>\n        </el-row>\n\n        <p class=\"text-content\">发现异常明细如下：</p>\n        <el-row>\n          <el-table ref=\"planTable\" :data=\"reportData.abnormalList\" size=\"small\">\n            <el-table-column type=\"index\" width=\"50\" align=\"center\"></el-table-column>\n            <el-table-column label=\"工单编号\" prop=\"code\" min-width=\"150\" align=\"center\" />\n            <el-table-column label=\"巡视人\" prop=\"feedbackPerson\" min-width=\"100\" align=\"center\" />\n            <el-table-column label=\"巡视项\" prop=\"configDetailName\" min-width=\"150\" align=\"center\" />\n            <el-table-column label=\"缺陷内容\" prop=\"feedbackContent\" min-width=\"200\" align=\"center\" />\n          </el-table>\n        </el-row>\n\n        <p class=\"text-content\">巡视人工单统计</p>\n        <el-row style=\"border:1px solid #d5d6d7;\">\n          <OrderBar ref=\"orderBar\" :width=\"'100%'\" :height=\"'300px'\" :module-data=\"reportData.personChartData\"/>\n        </el-row>\n        <el-row style=\"border:1px solid #d5d6d7;margin-top:10px;margin-bottom: 80px;\">\n          <RoomPie ref=\"roomPie\" :width=\"'100%'\" :height=\"'300px'\" :module-data=\"reportData.planOrderChartData\"/>\n        </el-row>\n\n      </el-col>\n    </el-row>\n    <el-button type=\"primary\" class=\"dowonload-btn\" size=\"large\" @click=\"handleDownload\">下载报告</el-button>\n  </basic-container>\n</template>\n\n<script>\nimport OrderBar from './orderBar.vue'\nimport RoomPie from './roomPie.vue'\nimport { getReportData,createReportFile,exportReportFile, downloadFile} from '@/api/xcnanr/report'\n\nexport default {\n  name: 'Report',\n  components:{OrderBar, RoomPie},\n  data() {\n    return {\n      paramsInfo: {\n        inspectionMonth: \"2024-12\",//巡视月份\n        companyId: 1,//公司ID\n        companyName: \"XX公司\",  //公司名称\n        deptName: 'XX信息运检班',//部门名称\n        objectId: 1,//对象ID\n        objectName: \"XX机房\",//机房名称\n        type: 1//类型 1机房 2设备\n      },\n      reportData: {\n        startDate: \"2024年12月1日\", //开始时间\n        finishDate: \"2024年12月31日\",//结束时间\n        inspectCount: 3,//巡视总数\n        planCount: 2,//涉及巡视计划总数\n        personNum: 2,//涉及巡视人员数量\n        abnormalNum: 3,//异常总数\n        solvedNum: 2,//已解决异常数量\n        unsolvedNum: 1,//未解决异常数量\n        planList: [//巡视计划列表\n          {\n            no: \"XSJH20241216000001\",//计划编号\n            period: \"周计划巡视\",//计划类别\n            times: \"15:00:00-16:00:00\\n17:00:00-18:00:00\",//巡视时间段\n            index: 1,\n            workerName: \"刘丽娟、张三\"//巡视人\n          },\n          {\n            no: \"XSJH20241216000002\",\n            period: \"月计划巡视\",\n            times: \"09:00:00-11:30:00\",\n            index: 2,\n            workerName: \"刘丽娟\"\n          }\n        ],\n        abnormalList: [//异常明细列表\n          {code: \"XSGD20241216000001\",feedbackContent: \"发现缺陷1处\",feedbackPerson: \"刘丽娟\",configDetailName: \"电脑巡视\",index: 1}\n        ],\n        personChartData: [//巡视人工单统计\n          {personName: \"李飞\",orderNum: 1 },\n          {personName: \"刘丽娟\",orderNum: 1},\n          {personName: \"张三\",orderNum: 1}\n        ],\n        planOrderChartData: [//机房巡视工单饼图数据\n          { name: \"计划工单\",value: 3},\n          { name: \"临时工单\",value: 0}\n        ]\n      }\n    }\n  },\n  created(){\n    this.paramsInfo = this.$route.query\n    this.getViewData()\n  },\n  methods: {\n    handleDownload() {\n      const _this = this\n      //下载报告\n      _this.$message.success('开始下载报告,请稍等...')\n      createReportFile(_this.paramsInfo).then(res => {\n        if(res.success && res.data) {\n          _this.$message.success('报告创建成功,正在下载...')\n          _this.exportFile(res.data)\n        }else {\n          _this.$message.error('报告创建失败')\n        }\n      }).catch(err => {\n        console.log(err)\n        this.$message.error('下载报告失败')\n      })\n    },\n    exportFile(fileName) {\n      const paramsInfo = this.paramsInfo\n      const reportData = this.reportData\n      const newFileName = paramsInfo.companyName + paramsInfo.objectName + '巡视报告('+reportData.startDate+'至'+reportData.finishDate+')'\n      exportReportFile(fileName).then(res => {\n        downloadFile(res,newFileName,'docx')\n      }).catch(err => {\n        console.log(err)\n        this.$message.error('报告导出失败')\n      })\n    },\n    getViewData() {\n      const _this = this\n      _this.reportData = {}\n      getReportData(this.paramsInfo).then(res => {\n        if(res.success){\n          _this.reportData = res.data\n        }else {\n          _this.$message.warning(res.msg)\n        }\n      }).catch(err => {\n        console.log(err)\n        _this.$message.error('获取报告数据失败')\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.text-title{\n  font-size: 22px;\n  font-weight: bold;\n  text-align: center;\n}\n.text-content{\n  //font-size: 16px;\n  //text-align: center;\n  text-indent: 2em;\n  margin-top: 30px;\n}\n.dowonload-btn{\n  position: fixed;\n  top: 150px;\n  right: 40px;\n}\n</style>\n"],"mappings":"AAmDA,OAAAA,QAAA;AACA,OAAAC,OAAA;AACA,SAAAC,aAAA,EAAAC,gBAAA,EAAAC,gBAAA,EAAAC,YAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAP,QAAA,EAAAA,QAAA;IAAAC,OAAA,EAAAA;EAAA;EACAO,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;QACAC,eAAA;QAAA;QACAC,SAAA;QAAA;QACAC,WAAA;QAAA;QACAC,QAAA;QAAA;QACAC,QAAA;QAAA;QACAC,UAAA;QAAA;QACAC,IAAA;MACA;MACAC,UAAA;QACAC,SAAA;QAAA;QACAC,UAAA;QAAA;QACAC,YAAA;QAAA;QACAC,SAAA;QAAA;QACAC,SAAA;QAAA;QACAC,WAAA;QAAA;QACAC,SAAA;QAAA;QACAC,WAAA;QAAA;QACAC,QAAA;QAAA;QACA;UACAC,EAAA;UAAA;UACAC,MAAA;UAAA;UACAC,KAAA;UAAA;UACAC,KAAA;UACAC,UAAA;QACA,GACA;UACAJ,EAAA;UACAC,MAAA;UACAC,KAAA;UACAC,KAAA;UACAC,UAAA;QACA,EACA;QACAC,YAAA;QAAA;QACA;UAAAC,IAAA;UAAAC,eAAA;UAAAC,cAAA;UAAAC,gBAAA;UAAAN,KAAA;QAAA,EACA;QACAO,eAAA;QAAA;QACA;UAAAC,UAAA;UAAAC,QAAA;QAAA,GACA;UAAAD,UAAA;UAAAC,QAAA;QAAA,GACA;UAAAD,UAAA;UAAAC,QAAA;QAAA,EACA;QACAC,kBAAA;QAAA;QACA;UAAAlC,IAAA;UAAAmC,KAAA;QAAA,GACA;UAAAnC,IAAA;UAAAmC,KAAA;QAAA;MAEA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAjC,UAAA,QAAAkC,MAAA,CAAAC,KAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACAC,cAAA,WAAAA,eAAA;MAAA,IAAAC,MAAA;MACA,IAAAC,KAAA;MACA;MACAA,KAAA,CAAAC,QAAA,CAAAC,OAAA;MACAhD,gBAAA,CAAA8C,KAAA,CAAAxC,UAAA,EAAA2C,IAAA,WAAAC,GAAA;QACA,IAAAA,GAAA,CAAAF,OAAA,IAAAE,GAAA,CAAA7C,IAAA;UACAyC,KAAA,CAAAC,QAAA,CAAAC,OAAA;UACAF,KAAA,CAAAK,UAAA,CAAAD,GAAA,CAAA7C,IAAA;QACA;UACAyC,KAAA,CAAAC,QAAA,CAAAK,KAAA;QACA;MACA,GAAAC,KAAA,WAAAC,GAAA;QACAC,OAAA,CAAAC,GAAA,CAAAF,GAAA;QACAT,MAAA,CAAAE,QAAA,CAAAK,KAAA;MACA;IACA;IACAD,UAAA,WAAAA,WAAAM,QAAA;MAAA,IAAAC,MAAA;MACA,IAAApD,UAAA,QAAAA,UAAA;MACA,IAAAQ,UAAA,QAAAA,UAAA;MACA,IAAA6C,WAAA,GAAArD,UAAA,CAAAG,WAAA,GAAAH,UAAA,CAAAM,UAAA,aAAAE,UAAA,CAAAC,SAAA,SAA