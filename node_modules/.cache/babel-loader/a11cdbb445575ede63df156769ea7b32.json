{\n      this.showOperate = false\n      this.$closePage('/personalDesk/desk');\n    },\n    loadLogOptDataList() {\n      //加载操作记录\n      getLogOptList(1, 99, {logId: this.$route.query.id}).then(res => {\n        this.optList = res.data.records;\n      });\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n\n</style>\n"],"mappings":"AA4JA,SAAAA,WAAA;AACA,SAAAC,aAAA,EAAAC,UAAA,EAAAC,UAAA;AACA,SAAAC,eAAA,EAAAC,iBAAA,EAAAC,iBAAA,EAAAC,wBAAA;AACA,SAAAC,aAAA;AACA,OAAAC,IAAA;AACA,OAAAC,WAAA;AAEA;EACAC,UAAA;IAAAF,IAAA,EAAAA,IAAA;IAAAC,WAAA,EAAAA;EAAA;EACAE,IAAA,WAAAA,KAAA;IACA;MACAC,WAAA;MACAC,UAAA;MACAC,OAAA;MACA;MACAC,aAAA;MACAC,QAAA,EAAAhB,aAAA,CAAAiB,SAAA;MACA;MACAC,cAAA;MACAC,eAAA;MACAC,SAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,OAAA;MACAC,WAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA;IACA,KAAAC,oBAAA;IACA,KAAAC,OAAA;IACA,KAAAC,kBAAA;IACA,KAAAC,SAAA;EACA;EACAC,OAAA;IACAD,SAAA,WAAAA,UAAA;MAAA,IAAAE,KAAA;MACA,KAAAnB,WAAA;MACAP,iBAAA;QAAA2B,EAAA,OAAAX,MAAA,CAAAC,KAAA,CAAAU;MAAA,GAAAC,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAAlB,UAAA,GAAAqB,GAAA,CAAAvB,IAAA;QACA,IAAAoB,KAAA,CAAAlB,UAAA,CAAAsB,UAAA;UACAJ,KAAA,CAAAf,QAAA,GAAAhB,aAAA,CAAAiB,SAAA;QACA,WAAAc,KAAA,CAAAlB,UAAA,CAAAsB,UAAA;UACAJ,KAAA,CAAAf,QAAA,GAAAf,UAAA,CAAAgB,SAAA;QACA,WAAAc,KAAA,CAAAlB,UAAA,CAAAsB,UAAA;UACAJ,KAAA,CAAAf,QAAA,GAAAd,UAAA,CAAAe,SAAA;QACA;QACAc,KAAA,CAAAnB,WAAA;MACA;MACAN,wBAAA;QAAA8B,QAAA,OAAAf,MAAA,CAAAC,KAAA,CAAAU;MAAA,GAAAC,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAAhB,aAAA,GAAAmB,GAAA,CAAAvB,IAAA,CAAA0B,OAAA;MACA;IACA;IACAV,OAAA,WAAAA,QAAA;MAAA,IAAAW,MAAA;MACA,IAAAC,IAAA;MAAA,IAAAC,KAAA,YAAAA,MAAAC,CAAA,EACA;QACA1C,WAAA,CAAAwC,IAAA,CAAAE,CAAA,GAAAR,IAAA,WAAAC,GAAA;UACA,IAAAK,IAAA,CAAAE,CAAA,qBAAAH,MAAA,CAAApB,cAAA,GAAAgB,GAAA,CAAAvB,IAAA,MACA,IAAA4B,IAAA,CAAAE,CAAA,sBAAAH,MAAA,CAAAnB,eAAA,GAAAe,GAAA,CAAAvB,IAAA;QACA;MACA;MALA,SAAA8B,CAAA,MAAAA,CAAA,GAAAF,IAAA,CAAAG,MAAA,EAAAD,CAAA;QAAAD,KAAA,CAAAC,CAAA;MAAA;IAMA;IACAE,WAAA,WAAAA,YAAA;MACA,SAAAtB,MAAA,CAAAC,KAAA,CAAAsB,UAAA;QACA,YAAAC,UAAA,MAAAxB,MAAA,CAAAC,KAAA,CAAAsB,