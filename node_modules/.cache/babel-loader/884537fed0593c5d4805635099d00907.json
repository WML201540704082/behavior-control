保存\n    save() {\n      this.$refs.submitForm.validate((valid) => {\n        if(valid) {\n          this.saveLoading = true\n          globalattrSave(this.submitForm).then(res => {\n            this.saveLoading = false\n            this.$message({\n              type: 'success',\n              message: '保存成功！'\n            });\n            this.$emit('saveGlobalArrt')\n          }).catch(() => {\n            this.saveLoading = false\n          })\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n\n</style>\n"],"mappings":"AAiFA,SAAAA,gBAAA,EAAAC,cAAA;AAEA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;QACAC,QAAA;MACA;MACAC,KAAA;QACAC,IAAA,GACA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAC,KAAA,GACA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAE,WAAA;MACAC,WAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,SAAA;EACA;EACAC,OAAA;IACA;IACAD,SAAA,WAAAA,UAAA;MAAA,IAAAE,KAAA;MACA,SAAAC,QAAA;QACA,KAAAN,WAAA;QACAZ,gBAAA;UAAAmB,EAAA,OAAAC;QAAA,GAAAC,IAAA,WAAAC,GAAA;UACAL,KAAA,CAAAL,WAAA;UACAK,KAAA,CAAAb,UAAA,GAAAkB,GAAA,CAAAC,MAAA;QACA,GAAAC,KAAA;UACAP,KAAA,CAAAL,WAAA;QACA;MACA;IACA;IACA;IACAa,OAAA,WAAAA,QAAA;MACA,KAAArB,UAAA,CAAAC,QAAA,CAAAqB,IAAA;QACAC,KAAA;MACA;IACA;IACA;IACAC,OAAA,WAAAA,QAAAC,GAAA;MACA,KAAAzB,UAAA,CAAAC,QAAA,CAAAyB,MAAA,CAAAD,GAAA,CAAAE,SAAA;IACA;IACA;IACAC,iBAAA,WAAAA,kBAAAC,IAAA;MAAA,IAAAJ,GAAA,GAAAI,IAAA,CAAAJ,GAAA;QAAAK,QAAA,GAAAD,IAAA,CAAAC,QAAA;MACAL,GAAA,CAAAE,SAAA,GAAAG,QAAA;IACA;IACA;IACAC,IAAA,WAAAA,KAAA;MAAA,IAAAC,MAAA;MACA,KAAAC,KAAA,CAAAjC,UAAA,CAAAkC,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACAH,MAAA,CAAAvB,WAAA;UACAZ,cAAA,CAAAmC,MAAA,CAAAhC,UAAA,EAAAiB,IAAA,WAAAC,GAAA;YACAc,MAAA,CAAAvB,WAAA;YACAuB,MAAA,CAAAI,QAAA;cACAC,IAAA;cACAhC,OAAA;YACA;YACA2B,MAAA,CAAAM,KAAA;UACA,GAAAlB,KAAA;YACAY,MAAA,CAAAvB,WAAA;UACA;QACA;MACA;IACA;EACA;AACA"}]}