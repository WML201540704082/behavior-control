placeholder=\"请输入用户区域\"\n                clearable\n                v-model=\"searchForm.regionName\"\n              >\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"三方系统\" prop=\"tripleType\">\n              <el-select v-model=\"searchForm.tripleType\" placeholder=\"请选择三方系统\" clearable>\n                <el-option v-for=\"dict in tripleTypeList\" :key=\"dict.dictKey\" :label=\"dict.dictValue\"\n                           :value=\"dict.dictKey\"></el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"操作类型\" prop=\"value\">\n              <el-select v-model=\"searchForm.value\" placeholder=\"请选择操作类型\" clearable>\n                <el-option v-for=\"dict in valueList\" :key=\"dict.dictKey\" :label=\"dict.dictValue\"\n                           :value=\"dict.dictKey\"></el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"ip地址\" prop=\"ip\">\n              <el-input placeholder=\"请输入ip地址\" clearable v-model=\"searchForm.ip\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"参数值\" prop=\"text\">\n              <el-input placeholder=\"请输入参数值\" clearable v-model=\"searchForm.text\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div class=\"page_body\">\n      <el-row>\n        <formTitle :titleText=\"'查询结果列表'\" :titleType=\"'page_title'\">\n          <div slot=\"rightBtnBox\">\n            <el-button type=\"primary\"\n                       @click=\"handleQuery\">查询\n            </el-button>\n            <el-button style=\"margin-left: 5px;\" type=\"primary\" plain\n                       @click=\"handleReset\">重置\n            </el-button>\n          </div>\n        </formTitle>\n      </el-row>\n      <el-table\n        ref=\"dataTable\"\n        stripe\n        size=\"small\"\n        :data=\"dataList\"\n        :height=\"tableHeight\"\n        v-loading=\"tableLoading\"\n        @selection-change=\"selectionChange\"\n      >\n        <el-table-column type=\"selection\" width=\"30\" fixed=\"left\"></el-table-column>\n        <el-table-column type=\"index\" label=\"序号\" width=\"50\" align=\"center\"></el-table-column>\n\n        <!-- <el-table-column prop=\"success\" label=\"是否成功\" width=\"100\" align=\"center\" :formatter=\"changeStatus\" show-overflow-tooltip></el-table-column> -->\n        <el-table-column prop=\"\" label=\"接口使用次数\" width=\"130\" align=\"center\" show-overflow-tooltip>\n          <template slot-scope=\"scope\">\n            <span>0</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"\" label=\"接口有效性\" width=\"130\" align=\"center\" show-overflow-tooltip>\n          <template slot-scope=\"scope\">\n            <span>有效</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"className\" label=\"类名\" width=\"300\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"ip\" label=\"ip地址\" width=\"150\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"regionName\" label=\"用户区域\" width=\"150\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"text\" label=\"参数值\" width=\"300\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"tripleType\" label=\"三方系统\" width=\"200\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"value\" label=\"操作类型\" width=\"200\" align=\"center\" show-overflow-tooltip></el-table-column>\n        \n        <el-table-column label=\"操作\" width=\"200\" align=\"center\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button\n              type=\"text\"\n              size=\"small\"\n              class=\"list_btn\"\n              icon=\"el-icon-view\"\n              @click=\"handleView(scope.row, scope.index)\">查看\n            </el-button>\n            <!-- <el-button\n              type=\"text\"\n              size=\"small\"\n              class=\"list_btn btn_red\"\n              icon=\"el-icon-delete\"\n              @click=\"handleDeleteOne(scope.row.id)\">删除\n            </el-button> -->\n          </template>\n        </el-table-column>\n      </el-table>\n      <pagination\n        :total=\"total\"\n        :page.sync=\"searchForm.current\"\n        :limit.sync=\"searchForm.size\"\n        @pagination=\"getList\"/>\n    </div>\n\n    <!-- 详情弹窗 -->\n    <threelogDetail\n      v-if=\"showDialog\"\n      :isShow=\"showDialog\"\n      :itemId=\"itemId\"\n      @close=\"showDialog = false\"\n    ></threelogDetail>\n  </basic-container>\n</template>\n\n<script>\n  import {getTripleapilogList} from \"@/api/dataSharing/dataLog\";\n  import {getDictList} from \"@/api/dict\";\n  import threelogDetail from './components/dataLog/threelogDetail'\n\n  export default {\n    components: {threelogDetail},\n    data() {\n      return {\n        searchForm: {\n          current: 1,\n          size: 20\n        },\n\n        successList: [{\n          \"dictKey\": 0,\n          \"dictValue\": \"成功\"\n        }, {\n          \"dictKey\": 1,\n          \"dictValue\": \"失败\"\n        }],\n        dataList: [],\n        tableLoading: false, //表格加载\n        tableHeight: undefined,\n        total: 0,\n        selectionList: [],\n        valueList: [],\n        tripleTypeList: [],\n\n        showDialog: false,\n        itemId: '',\n      };\n    },\n    computed: {\n      ids() {\n        let ids = [];\n        this.selectionList.forEach(ele => {\n          ids.push(ele.id);\n        });\n        return ids.join(\",\");\n      }\n    },\n    mounted() {\n      // 设置页面元素高度\n      this.setPageContentHeight()\n      this.setTableHeight()\n      this.getDictList(\"threeLogValue\");\n      this.getDictList(\"tripleTypeList\");\n      this.getList();\n\n    },\n    methods: {\n      changeStatus(row) {\n        if (row.success === 0) {\n          return \"成功\"\n        } else if (row.success === 1) {\n          return \"失败\"\n        }\n      },\n\n      getDictList(code) {\n        //加载字典\n        getDictList(code).then(res => {\n          if (code === 'threeLogValue') {\n            this.valueList = res.data;\n          } else if (code === 'tripleTypeList') {\n            this.tripleTypeList = res.data;\n          }\n        });\n      },\n      // 设置表格高度\n      setTableHeight() {\n        let pageBody = document.getElementsByClassName('page_body')\n        this.tableHeight = pageBody[0].offsetHeight - 61 - 47 + 'px'\n      },\n      handleView(row) {\n        this.showDialog = true\n        this.itemId = row.id\n      },\n      handleReset() {\n        this.searchForm = {\n          current: 1,\n          size: 20,\n        };\n        this.getList()\n      },\n      getList() {\n        this.tableLoading = true\n        getTripleapilogList(this.searchForm).then(res => {\n          this.dataList = res.data.records\n          this.total = res.data.total\n          this.tableLoading = false\n        })\n      },\n      handleQuery() {\n        this.searchForm.current = 1\n        this.getList()\n      },\n      handleDeleteOne(id) {\n        //删除按钮\n        let ids = id;\n        this.handleDeleteConfirm(ids);\n        this.selectionList.filter(item => item != id);\n      },\n      handleDeleteConfirm(ids) {\n        this.$confirm(\"点击确认将永久删除数据且无法恢复，请谨慎选择。\", \"确定将选择数据删除?\", {\n          confirmButtonText: \"确定删除\",\n          cancelButtonText: \"取消\",\n          type: \"warning\"\n        })\n          .then(() => {\n            return remove(ids);\n          })\n          .then(() => {\n            this.$message({\n              type: \"success\",\n              message: \"操作成功!\"\n            });\n            this.getList()\n          });\n      },\n      selectionChange(list) {\n        this.selectionList = list;\n      },\n    }\n  };\n</script>\n\n<style lang=\"scss\" scoped>\n  .list_btn {\n    padding: 9px 5px !important;\n  }\n\n  .btn_red {\n    color: red;\n  }\n</style>\n"],"mappings":";AAoIA,SAAAA,mBAAA;AACA,SAAAC,WAAA,IAAAA,YAAA;AACA,OAAAC,cAAA;AAEA;EACAC,UAAA;IAAAD,cAAA,EAAAA;EAAA;EACAE,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;QACAC,OAAA;QACAC,IAAA;MACA;MAEAC,WAAA;QACA;QACA;MACA;QACA;QACA;MACA;MACAC,QAAA;MACAC,YAAA;MAAA;MACAC,WAAA,EAAAC,SAAA;MACAC,KAAA;MACAC,aAAA;MACAC,SAAA;MACAC,cAAA;MAEAC,UAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACAC,GAAA,WAAAA,IAAA;MACA,IAAAA,GAAA;MACA,KAAAN,aAAA,CAAAO,OAAA,WAAAC,GAAA;QACAF,GAAA,CAAAG,IAAA,CAAAD,GAAA,CAAAE,EAAA;MACA;MACA,OAAAJ,GAAA,CAAAK,IAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA;IACA,KAAAC,oBAAA;IACA,KAAAC,cAAA;IACA,KAAA3B,WAAA;IACA,KAAAA,WAAA;IACA,KAAA4B,OAAA;EAEA;EACAC,OAAA;IACAC,YAAA,WAAAA,aAAAC,GAAA;MACA,IAAAA,GAAA,CAAAC,OAAA;QACA;MACA,WAAAD,GAAA,CAAAC,OAAA;QACA;MACA;IACA;IAEAhC,WAAA,WAAAA,YAAAiC,IAAA;MAAA,IAAAC,KAAA;MACA;MACAlC,YAAA,CAAAiC,IAAA,EAAAE,IAAA,WAAAC,GAAA;QACA,IAAAH,IAAA;UACAC,KAAA,CAAApB,SAAA,GAAAsB,GAAA,CAAAjC,IAAA;QACA,WAAA8B,IAAA;UACAC,KAAA,CAAAnB,cAAA,GAAAqB,GAAA,CAAAjC,IAAA;QACA;MACA;IACA;IACA;IACAwB,cAAA,WAAAA,eAAA;MACA,IAAAU,QAAA,GAAAC,QAAA,CAAAC,sBAAA;MACA,KAAA7B,WAAA,GAAA2B,QAAA,IAAAG,YAAA;IACA;IACAC,UAAA,WAAAA,WAAAV,GAAA;MACA,KAAAf,UAAA;MACA,KAAAC,MAAA,GAAAc,GAAA,CAAAR,EAAA;IACA;IACAmB,WAAA,WAAAA,YAAA;MACA,KAAAtC,UAAA;QACAC,OAAA;QACAC,IAAA;MACA;MACA,KAAAsB,OAAA;IACA;IACAA,OAAA,WAAAA,QAAA;MAAA,IAAAe,MAAA;MACA,KAAAlC,YAAA;MACAV,mBAAA,MAAAK,UAAA,EAAA+B,IAAA,WAAAC,GAAA;QACAO,MAAA,CAAAnC,QAAA,GAAA4B,GAAA,CAAAjC,IAAA,CAAAyC,OAAA;QACAD,MAAA,CAAA/B,KAAA,GAAAwB,GAAA,CAAAjC,IAAA,CAAAS,KAAA;QACA+B,MAAA,CAAAlC,YAAA;MACA;IACA;IACAoC,WAAA,WAAAA,YAAA;MACA,KAAAzC,UAAA,CAAAC,OAAA;MACA,KA