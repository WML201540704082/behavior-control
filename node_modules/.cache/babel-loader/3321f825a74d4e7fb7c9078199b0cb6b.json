se {\n                this.$message.fail('添加失败');\n              }\n              this.saveLoading = false;\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          } else if (this.type == 'edit') {\n            this.saveLoading = true;\n            update(this.submitParams).then(res => {\n              if (res.code === 200 ) {\n                this.$message.success('修改成功');\n              } else {\n                this.$message.fail('修改失败');\n              }\n              this.saveLoading = false;\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          }\n        }\n      })\n    },\n    chooseClick(arg) {\n      this.submitParams.ciIcon = arg.icon;\n    },\n    iconClear() {\n      this.$forceUpdate()\n    },\n    getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    },\n  },\n}\n</script>\n<style lang=\"scss\" scoped>\n.btn_box {\n  text-align: center;\n}\n</style>\n"],"mappings":"AA6DA,SAAAA,GAAA,EAAAC,MAAA;AACA,SAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,YAAA;MACAC,KAAA;QACAC,IAAA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAC,QAAA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAE,WAAA;UAAAJ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAG,MAAA;UAAAL,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAI,WAAA;MACAC,SAAA;MAEAC,cAAA;MACAC,YAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,SAAAC,IAAA;MACA,KAAAd,YAAA,GAAAe,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAAC,SAAA;IACA;IAEA,KAAAC,OAAA;EACA;EACAC,OAAA;IACA;IACAD,OAAA,WAAAA,QAAA;MAAA,IAAAE,KAAA;MACAzB,WAAA,uBAAA0B,IAAA,WAAAC,GAAA;QACAF,KAAA,CAAAT,YAAA,GAAAW,GAAA,CAAAxB,IAAA;MACA;IACA;IAEAyB,MAAA,WAAAA,OAAA;MAAA,IAAAC,MAAA;MACA,KAAAC,KAAA,CAAAC,UAAA,CAAAC,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACA,IAAAJ,MAAA,CAAAX,IAAA;YACAW,MAAA,CAAAhB,WAAA;YACAf,GAAA,CAAA+B,MAAA,CAAAzB,YAAA,EAAAsB,IAAA,WAAAC,GAAA;cACA,IAAAA,GAAA,CAAAO