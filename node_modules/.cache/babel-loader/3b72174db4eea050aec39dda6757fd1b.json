rk","saveLoading","computed","typeList","id","mounted","JSON","parse","stringify","fromValue","methods","submit","_this","$refs","submitForm","validate","valid","then","res","$message","success","$emit","getTitle"],"sources":["src/views/cmdb/components/treeManage/components/pzsx/addedit.vue"],"sourcesContent":["<template>\n  <el-dialog\n    :close-on-click-modal=\"false\"\n    :before-close=\"() => $emit('close')\"\n    :show-close=\"true\"\n    append-to-body\n    :visible.sync=\"isShow\"\n    :title=\"getTitle(type)\"\n    width=\"700px\"\n    top=\"20vh\"\n    v-el-drag-dialog\n  >\n    <el-form\n      ref=\"submitForm\"\n      class=\"xt_form\"\n      :model=\"submitParams\"\n      :rules=\"rules\"\n      label-suffix=\":\"\n      label-width=\"120px\"\n      size=\"small\">\n      <el-row>\n        <el-col :span=\"24\">\n          <el-form-item label=\"属性ID\" prop=\"value\">\n            <el-input v-model=\"submitParams.value\" placeholder=\"请输入属性ID\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"属性英文名\" prop=\"name\">\n            <el-input v-model=\"submitParams.name\" placeholder=\"请输入属性英文名\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"属性类型\" prop=\"type\">\n            <el-select v-model=\"submitParams.type\" placeholder=\"请选择属性类型\" clearable>\n              <el-option v-for=\"(item,index) in typeList\"\n                         :key=\"item.name\"\n                         :label=\"item.name\"\n                         :value=\"item.id\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"属性描述\" prop=\"remark\">\n            <el-input v-model=\"submitParams.remark\" placeholder=\"请输入属性描述\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n      </el-row>\n    </el-form>\n    <div class=\"btn_box\">\n      <el-button type=\"primary\" error @click=\"submit\" :loading=\"saveLoading\">{{ getTitle(type) }}</el-button>\n      <el-button type=\"danger\" plain @click=\"$emit('close')\">关 闭</el-button>\n    </div>\n  </el-dialog>\n</template>\n\n<script>\nimport {update, save} from \"@/api/treeManager/pzsx\";\n\nexport default {\n  name: \"pzsxAddEdit\",\n  props: ['fromValue', 'isShow', 'type'],\n  data() {\n    return {\n      submitParams: {},\n      rules: {\n        value: [{\n          required: true, message: '', trigger: 'blur', validator: (rule, value, callback) => {\n            if (value) {\n              // 1 开头的默认是手机号，进行校验\n              let reg = /^[0-9]*$/\n              if (reg.test(value) === false) {\n                callback(new Error('属性ID只允许输入数字'))\n              } else {\n                callback()\n              }\n            } else {\n              callback('请输入属性ID')\n            }\n          }\n        }],\n        name: [{required: true, message: '属性英文名不能为空', trigger: 'blur'}],\n        type: [{required: true, message: '属性类型不能为空', trigger: 'blur'}],\n        remark: [{required: true, message: '属性描述不能为空', trigger: 'blur'}],\n      },\n      saveLoading: false,\n    };\n  },\n  computed: {\n    typeList() {\n      return [\n        {name: '属性', id: 0},\n        {name: '配置', id: 1},\n        {name: '模型', id: 2},\n        {name: '字典模型', id: 3}\n      ];\n    },\n  },\n  mounted() {\n    if (this.type == 'edit') {\n      this.submitParams = JSON.parse(JSON.stringify(this.fromValue));\n    }\n  },\n  methods: {\n    submit() {\n      this.$refs.submitForm.validate((valid) => {\n        if (valid) {\n          if (this.type == 'add') {\n            this.saveLoading = true;\n            save(this.submitParams).then(res => {\n              this.saveLoading = false\n              this.$message.success('添加成功');\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          } else if (this.type == 'edit') {\n            this.saveLoading = true;\n            update(this.submitParams).then(res => {\n              this.saveLoading = false\n              this.$message.success('修改成功');\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          }\n        }\n      })\n    },\n    getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    },\n  },\n}\n</script>\n<style lang=\"scss\" scoped>\n.btn_box {\n  text-align: center;\n}\n</style>\n"],"mappings":"AAwDA,SAAAA,MAAA,EAAAC,IAAA;AAEA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,YAAA;MACAC,KAAA;QACAC,KAAA;UACAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;UAAAC,SAAA,WAAAA,UAAAC,IAAA,EAAAL,KAAA,EAAAM,QAAA;YACA,IAAAN,KAAA;cACA;cACA,IAAAO,GAAA;cACA,IAAAA,GAAA,CAAAC,IAAA,CAAAR,KAAA;gBACAM,QAAA,KAAAG,KAAA;cACA;gBACAH,QAAA;cACA;YACA;cACAA,QAAA;YACA;UACA;QACA;QACAX,IAAA;UAAAM,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAO,IAAA;UAAAT,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAQ,MAAA;UAAAV,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAS,WAAA;IACA;EACA;EACAC,QAAA;IACAC,QAAA,WAAAA,SAAA;MACA,QACA;QAAAnB,IAAA;QAAAoB,EAAA;MAAA,GACA;QAAApB,IAAA;QAAAoB,EAAA;MAAA,GACA;QAAApB,IAAA;QAAAoB,EAAA;MAAA,GACA;QAAApB,IAAA;QAAAoB,EAAA;MAAA,EACA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,SAAAN,IAAA;MACA,KAAAZ,YAAA,GAAAmB,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAAC,SAAA;IACA;EACA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,KAAA,CAAAC,UAAA,CAAAC,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACA,IAAAJ,KAAA,CAAAb,IAAA;YACAa,KAAA,CAAAX,WAAA;YACAlB,IAAA,CAAA6B,KAAA,CAAAzB,YAAA,EAAA8B,IAAA,WAAAC,GAAA;cACAN,KAAA,CAAAX,WAAA;cACAW,KAAA,CAAAO,QAAA,CAAAC,OAAA;cACAR,KAAA,CAAAS,KAAA;cACAT,KAAA,CAAAS,KAAA;YACA;UACA,WAAAT,KAAA,CAAAb,IAAA;YACAa,KAAA,CAAAX,WAAA;YACAnB,MAAA,CAAA8B,KAAA,CAAAzB,YAAA,EAAA8B,IAAA,WAAAC,GAAA;cACAN,KAAA,CAAAX,WAAA;cACAW,KAAA,CAAAO,QAAA,CAAAC,OAAA;cACAR,KAAA,CAAAS,KAAA;cACAT,KAAA,CAAAS,KAAA;YACA;UA