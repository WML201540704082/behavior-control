p=\"10vh\"\n    v-el-drag-dialog\n  >\n    <el-form\n      ref=\"searchForm\"\n      :model=\"searchForm\"\n      label-suffix=\":\"\n      label-width=\"100px\"\n      class=\"xt_search_form\"\n    >\n      <el-row v-if=\"repairType === '1'\">\n        <el-col :span=\"8\">\n          <el-form-item label=\"使用人\" prop=\"xx\">\n            <el-input v-model=\"searchForm.xx\" clearable placeholder=\"请输入使用人\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"IP地址\" prop=\"ip\">\n            <el-input v-model=\"searchForm.IP\" clearable placeholder=\"请输入IP地址\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"MAC地址\" prop=\"mac\">\n            <el-input v-model=\"searchForm.MAC\" clearable placeholder=\"请输入MAC地址\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"设备编码\" prop=\"deviceCode\">\n            <el-input v-model=\"searchForm.deviceCode\" clearable placeholder=\"请输入设备编码\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"出厂序列号\" prop=\"sn\">\n            <el-input v-model=\"searchForm.sn\" clearable placeholder=\"请输入出场序列号\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"设备来源\" prop=\"deviceSource\">\n            <el-select v-model=\"searchForm.deviceSource\"  placeholder=\"请选择设备来源\" clearable  >\n              <el-option  v-for=\"dict in deviceSourceList\" :key=\"dict.dictKey\"  :label=\"dict.dictValue\" :value=\"dict.dictValue\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n      </el-row>\n      <el-row v-else-if=\"repairType === '2'\">\n        <el-col :span=\"8\">\n          <el-form-item label=\"设备编码\" prop=\"deviceCode\">\n            <el-input v-model=\"searchForm.deviceCode\" clearable placeholder=\"请输入设备编码\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"出厂序列号\" prop=\"sn\">\n            <el-input v-model=\"searchForm.sn\" clearable placeholder=\"请输入出场序列号\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"设备来源\" prop=\"deviceSource\">\n            <el-select v-model=\"searchForm.deviceSource\"  placeholder=\"请选择设备来源\" clearable  >\n              <el-option  v-for=\"dict in deviceSourceList\" :key=\"dict.dictKey\"  :label=\"dict.dictValue\" :value=\"dict.dictValue\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n      </el-row>\n      <el-row v-else-if=\"repairType === '3'\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"设备分类\" prop=\"deviceCategory\">\n              <el-select v-model=\"searchForm.deviceCategory\"  placeholder=\"请选择设备分类\" clearable @change=\"deviceCategoryChange\">\n                <el-option  v-for=\"dict in deviceCategoryList\" :key=\"dict.dictValue\"  :label=\"dict.dictValue\" :value=\"dict.dictValue\"></el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"设备类型\" prop=\"status\" >\n              <el-select v-model=\"searchForm.deviceType\"  placeholder=\"请输入设备类型\" clearable >\n                <el-option  v-for=\"dict in deviceTypeList\" :key=\"dict.dictValue\"  :label=\"dict.dictValue\" :value=\"dict.dictValue\"></el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"设备编码\" prop=\"deviceCode\">\n            <el-input v-model=\"searchForm.deviceCode\" clearable placeholder=\"请输入设备编码\"></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"8\">\n          <el-form-item label=\"出厂序