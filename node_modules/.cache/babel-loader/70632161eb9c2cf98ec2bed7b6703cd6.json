;\n      }\n    },\n    handleFileError: function handleFileError(response, file, fileList) {\n      this.$message.error(response);\n    },\n    handleRemove: function handleRemove(file) {\n      var _this3 = this;\n      if (!file.id) {\n        this.resObj = {};\n        return;\n      }\n      //删除旧文件\n      this.fileList = [];\n      var data = {\n        ids: file.id\n      };\n      attachRemove(data).then(function (response) {\n        if (response.code === 200) {\n          _this3.fileList = [];\n        } else {\n          _this3.$message.error(response.msg);\n        }\n      });\n      this.resObj = {};\n    },\n    handleExceed: function handleExceed() {\n      this.$message.warning('图片上传数量已上限！');\n    },\n    getAccept: function getAccept() {\n      var acc = '';\n      for (var i = 0; i < this.upload.accept.length; i++) {\n        acc += \".\".concat(this.upload.accept[i]);\n        if (i < this.upload.accept.length - 1) {\n          acc += ',';\n        }\n      }\n      return acc;\n    },\n    getTitle: function getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    }\n  }\n};",{"version":3,"names":["add","add2","update","Message","attrrelUpdate","Base64","website","getToken","attachRemove","removeFile","uploadFile1","props","data","saveLoading","statusList","title","upload","accept","open","isUploading","updateSupport","headers","Authorization","concat","encode","clientId","clientSecret","url","imageUrl","fileList","fileSize","loading","resObj","rules","uploadFileName","required","message","trigger","fileOrder","fileUrl","status","computed","mounted","formDetial","initTypes","methods","uploadFile2","params","file","formData","FormData","append","then","res","onSuccess","catch","error","onError","push","name","id","aDowload","fileName","x","window","XMLHttpRequest","responseType","onload","url2","URL","createObjectURL","response","a","document",