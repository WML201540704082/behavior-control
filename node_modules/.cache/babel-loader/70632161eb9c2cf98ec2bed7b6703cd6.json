dleRemove(file) {\n      if (!file.id) {\n        this.resObj = {}\n        return\n      }\n      //删除旧文件\n      this.fileList = []\n      let data = {\n        ids: file.id\n      }\n      attachRemove(data).then(response => {\n        if (response.code === 200) {\n          this.fileList = []\n        } else {\n          this.$message.error(response.msg)\n        }\n      })\n      this.resObj = {}\n    },\n    handleExceed() {\n      this.$message.warning('图片上传数量已上限！')\n    },\n    getAccept() {\n      let acc = '';\n      for (let i = 0; i < this.upload.accept.length; i++) {\n        acc += `.${this.upload.accept[i]}`;\n        if (i < this.upload.accept.length - 1) {\n          acc += ','\n        }\n      }\n      return acc;\n    },\n    getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.d_end button {\n  width: 100px;\n}\n</style>\n"],"mappings":";;;AAmFA,SAAAA,GAAA,EAAAC,IAAA,EAAAC,MAAA;AACA,SAAAC,OAAA;AACA,SAAAC,aAAA;AACA,SAAAC,MAAA;AACA,OAAAC,OAAA;AACA,SAAAC,QAAA;AACA,SAAAC,YAAA,EAAAC,UAAA;AACA,SAAAC,WAAA;AAEA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,WAAA;MACAC,UAAA;MAEAC,KAAA;MAEA;MACAC,MAAA;QACAC,MAAA;QACA;QACAC,IAAA;QACA;QACAH,KAAA;QACA;QACAI,WAAA;QACA;QACAC,aAAA;QACA;QACAC,OAAA;UACAC,aAAA,WAAAC,MAAA,CAAAlB,MAAA,CAAAmB,MAAA,IAAAD,MAAA,CAAAjB,OAAA,CAAAmB,QAAA,OAAAF,MAAA,CAAAjB,OAAA,CAAAoB,YAAA;UACA,6BAAAnB,QAAA;QACA;QACA;QACAoB,GAAA;QACAC,QAAA;MACA;MAEAT,WAAA;MAEAU,QAAA;MACAC,QAAA;MAAA;;MAEAC,OAAA;MACAC,MAAA;MAEAC,KAAA;QACAC,cAAA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAC,SAAA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAE,OAAA;UAAAJ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAG,MAAA;UAAAL,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IAGA;EACA;EACAI,QAAA;EACAC,OAAA,WAAAA,QAAA;IACA,UAAAC,UAAA;MACA,KAAAA,UAAA;IACA;IACA,KAAAC,SAAA;EACA;EACAC,OAA