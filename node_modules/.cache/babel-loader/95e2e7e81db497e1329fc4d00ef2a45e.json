enwu\");\n    },\n  },\n};\n</script>\n<style lang=\"scss\" scoped>\n.devRenCon {\n  width: 100%;\n  height: 100%;\n}\n.formLabel {\n  line-height: 16px;\n  display: block;\n}\n\n.head_p{\n\n  height: 160px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  .headContent{\n    display: flex;\n    flex-direction: row;\n    justify-content: center;\n    align-items: center;\n    margin-right: 40px;\n    height:80px;\n    img{\n      width:68px;\n      height:71px;\n    }\n    .num_content{\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      margin: 10px;\n      .title{\n        font-size: 14px;\n      }\n      .num{\n        color: #409EFF;\n        font-size: 20px;\n        font-weight: 500;\n      }\n    }\n\n  }\n}\n</style>\n"],"mappings":";;;;;;AAkFA,SAAAA,WAAA;AACA,SAAAC,aAAA;AACA,SAAAC,eAAA;AACA,SAAAC,cAAA;AACA,SAAAC,UAAA;AACA,OAAAC,UAAA;AACA,OAAAC,gBAAA;AACA,OAAAC,eAAA;AACA,OAAAC,gBAAA;AACA,SAAAC,iBAAA;AAEA;EACAC,UAAA;IAAAL,UAAA,EAAAA,UAAA;IAAAC,gBAAA,EAAAA,gBAAA;IAAAC,eAAA,EAAAA,eAAA;IAAAC,gBAAA,EAAAA;EAAA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;MACAC,gBAAA;MACAC,OAAA;MACAC,gBAAA;MACAC,IAAA;MACAC,OAAA;MACAb,UAAA;MACAc,cAAA;QAAAC,IAAA;MAAA;MACAC,MAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA,EAAAC,aAAA,KACApB,UAAA,iBACA;EACAqB,OAAA,WAAAA,QAAA;IACA;IACA,KAAAC,oBAAA;IACA;IACA;IACA,IAAAC,MAAA,QAAAC,MAAA,CAAAC,KAAA;IACA,KAAAP,MAAA,GAAAK,MAAA,CAAAL,MAAA;IACA,KAAAD,MAAA,GAAAM,MAAA,CAAAG,KAAA;IAEA,IAAAH,MAAA,CAAAL,MAAA;MACA,KAAAD,MAAA,GAAAM,MAAA,CAAAG,KAAA;MACA,KAAAC,UAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAA,WAAAA,YAAA;MACA,KAAAF,UAAA;MACA,KAAAG,KAAA,CAAAC,IAAA,CAAAC,aAAA;MACA;MACA,KAAAF,KAAA,CAAAG,IAAA,CAAAD,aAAA;MACA,KAAAF,KAAA,CAAAI,IAAA,CAAAF,aAAA;IACA;IACAG,OAAA,WAAAA,QAAA;MACA,KAAAR,UAAA;IACA;IACAA,UAAA,WAAAA,WAAA;MAAA,IAAAS,KAAA;MACA/B,iBAAA;QAAAgC,EAAA,OAAAnB;MAAA,GAAAoB,IAAA,WAAAC,GAAA;QACAC,OAAA,CAAAC,GAAA,KAAAF,GAAA;QACA,IAAAA,GAAA,CAAAG,IAAA;UACAN,KAAA,CAAAvB,IAAA,GAAA0B,G