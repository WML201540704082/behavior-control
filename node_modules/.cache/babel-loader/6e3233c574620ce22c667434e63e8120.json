\"el-icon-refresh\" @click=\"searchReset\">重置</el-button>\n            <el-button size=\"small\" type=\"primary\"  @click=\"handleAdd\">新增</el-button>\n          </div>\n        </formTitle>\n      </el-row>\n      <el-table\n        ref=\"dataTable\"\n        stripe\n        size=\"small\"\n        :data=\"dataList\"\n        :height=\"tableHeight\"\n      >\n        <el-table-column type=\"index\" label=\"序号\" width=\"50\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"ip\" label=\"IP\" min-width=\"150\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"status\" label=\"终端状态\" min-width=\"90\" align=\"center\" show-overflow-tooltip>\n          <template  slot-scope=\"scope\">\n            <span>{{filterStatus(scope.row.status,deviceStatusList)}}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"mac\" label=\"MAC地址\" min-width=\"150\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"gateway\" label=\"网关\" min-width=\"150\" align=\"center\" show-overflow-tooltip></el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" align=\"center\" fixed=\"right\">\n          <template  slot-scope=\"scope\">\n            <!-- <el-button type=\"text\"\n                       class=\"list_btn\"\n                      size=\"small\"\n                      icon=\"el-icon-view\"\n                      @click=\"handleView(scope.row,scope.index)\">查看\n            </el-button> -->\n            <el-button type=\"text\"\n                       class=\"list_btn\"\n                      size=\"small\"\n                      icon=\"el-icon-edit\"\n                      @click=\"handleEdit(scope.row,scope.index)\">编辑\n            </el-button>\n            <el-button type=\"text\"\n                       class=\"list_btn btn_red\"\n                      size=\"small\"\n                      icon=\"el-icon-delete\"\n                     