      :placeholder=\"$hussarT('hussar-todoList.taskContent')\"\n            class=\"jxd_ins_elInput default\"\n            clearable style=\"width:200px;margin-right: 8px\"\n            type=\"text\"/>\n          <el-date-picker\n            size=\"mini\"\n            :rows=\"5\"\n            v-model=\"listQuery.startTime\"\n            :placeholder=\"$hussarT('hussar-common.startTime')\"\n            :picker-options=\"startPickerOptions\"\n            :class=\"listQuery.startTime?'dateIcon':''\"\n            type=\"datetime\"\n            prefix-icon=\"font_family icon-hussar_calendar\"\n            popper-class=\"lcdp-date-pop\"\n            class=\"jxd_ins_elDateTimePicker default\"\n            value-format=\"yyyy-MM-dd HH:mm:ss\"\n            style=\"margin-right: 8px;\"/>\n          <el-date-picker\n            size=\"mini\"\n            :rows=\"5\"\n            v-model=\"listQuery.endTime\"\n            :placeholder=\"$hussarT('hussar-common.endTime')\"\n            :class=\"listQuery.endTime?'dateIcon':''\"\n            :picker-options=\"endPickerOptions\"\n            type=\"datetime\"\n            prefix-icon=\"font_family icon-hussar_calendar\"\n            popper-class=\"lcdp-date-pop\"\n            class=\"jxd_ins_elDateTimePicker default\"\n            value-format=\"yyyy-MM-dd HH:mm:ss\"\n            style=\"margin-right: 8px;\"/>\n\n            <el-button\n              size=\"mini\"\n              type=\"primary\"\n              @click=\"queryList(true)\">{{ $hussarT('hussar-common.search') }}\n            </el-button>\n            <el-button\n              size=\"mini\"\n              type=\"button\"\n              @click=\"clearData()\">\n              {{ $hussarT('hussar-common.reset') }}\n            </el-button>\n\n        </div>\n        <div\n          class=\"jxd_ins_elTable default\"\n          style=\"margin-top: 10px;\">\n          <el-table\n            v-loading=\"listLoading\"\n            ref=\"tableRow\"\n            :data=\"list\"\n            :element-loading-text=\"$hussarT('hussar-common.loading')\"\n            class=\"currTable lcdp-table\"\n            height=\"calc(100vh - 200px)\"\n            fit>\n            <el-table-column\n              :label=\"$hussarT('hussar-common.no')\"\n              :index=\"indexMethod\"\n              type=\"index\"\n              width=\"80\"\n              align=\"center\"/>\n            <el-table-column\n              :label=\"this.$hussarT('hussar-todoList.process')\"\n              prop=\"processName\"\n              align=\"center\">\n              <template slot-scope=\"scope\">\n                <el-link class=\"jxd_ins_elLink default newPage\" style=\"cursor:pointer;\"><span @click=\"showPic(scope.row)\">{{ scope.row.processName }}</span></el-link>\n              </template>\n            </el-table-column>\n            <el-table-column\n              :label=\"this.$hussarT('hussar-todoList.node')\"\n              prop=\"taskDefinitionName\"\n              align=\"center\">\n              <template slot-scope=\"scope\">\n                <el-link class=\"jxd_ins_elLink default\">\n                  <span\n                    v-if=\"scope.row.web !== undefined && scope.row.web !== ''\"\n                    :title=\"getNodeName(scope.row)\"\n                    class=\"newPage\"\n                    @click=\"openRoute(scope.row)\"> {{ getNodeName(scope.row) }}</span>\n                  <span\n                    v-else\n                    :title=\"getNodeName(scope.row)\">{{ getNodeName(scope.row) }}</span>\n                </el-link>\n              </template>\n            </el-table-column>\n            <el-table-column\n              :label=\"this.$hussarT('hussar-todoList.sender')\"\n              prop=\"sendUserName\"\n              align=\"center\"/>\n            <el-table-column\n              :label=\"this.$hussarT('hussar-todoList.creationTime')\"\n              prop=\"startTime\"\n              align=\"center\"/>\n            <el-table-column\n              :label=\"this.$hussarT('hussar-todoList.taskContent')\"\n              prop=\"message\"\n              title=\"message\"\n              align=\"center\">\n              <template slot-scope=\"scope\">\n                <span :title=\"scope.row.message\">{{ scope.row.message }}</span>\n              </template>\n            </el-table-column>\n          </el-table>\n          <div class=\"page\">\n            <el-pagination\n              style=\"text-align: right;margin-top: 10px;\"\n              :current-page.sync=\"page.currentPage\"\n              :page-sizes=\"[10, 20, 30, 50]\"\n              :page-size=\"listQuery.size\"\n              :pager-count=\"pageCount\"\n              :total=\"total\"\n              layout=\"total, sizes, prev, pager, next\"\n              background\n              @size-change=\"handleSizeChange\"\n              @current-change=\"handleCurrentChange\"/>\n          </div>\n        </div>\n        <!-- 选择发送人 -->\n        <consignorDialog\n          :consignor-dialog-visible=\"resetFormVisible\"\n          @close=\"closeConsignorDialog\"\n          @confirm=\"confirmConsignorDialog\"/>\n\n        <el-dialog :visible.sync=\"showPicFlag\"\n                   width=\"1200px\"\n                   title=\"流程图\">\n          <flowfile\n            :processInsId=\"showPicProcessInstanceId\"\n            :businessId=\"showPicBusinessId\"\n            class=\"workflow\"\n            @close=\"close\" />\n        </el-dialog>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\n  import  flowfile  from '../components/flowFile/flowfile';\n\n  import  TreeIcon  from '../components/icon'\nimport {TodoTaskApi} from \"@/api/workflow/taskManagement/todo\";\nimport hussarRequest from '@/views/workflow/util/request'\n\nimport consignorDialog from '../components/consignorDialog/index';\nexport default {\n  name: 'todoList',  // 待办任务界面\n  components: {\n    flowfile,\n    consignorDialog,\n  },\n  data() {\n    return {\n      show