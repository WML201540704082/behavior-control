nalyse/quantitativeAnalysis/processrejectAnalysis/index.vue"],"sourcesContent":["<!--流程驳回分析-->\n<template>\n  <div id=\"rejectContent\" class=\"content-box\">\n    <!--顶部条件选择框-->\n    <date-picker-tabs\n      :remarks=\"remarks\"\n      :set-width=\"'calc(100% - 755px)'\"\n      @isShowList=\"showOrHideList\"\n      @getQueryList=\"setQueryParams\"\n    />\n    <!--列表-->\n    <div v-show=\"showList\" class=\"content-body\">\n      <el-table\n        v-loading=\"tableLoading\"\n        :data=\"tableData\"\n        height=\"100%\"\n        class=\"lcdp-table\"\n        stripe\n      >\n        <el-table-column\n          type=\"index\"\n          width=\"150\"\n          label=\"序号\"\n          align=\"center\"\n          show-overflow-tooltip\n        />\n        <el-table-column\n          label=\"流程名称\"\n          align=\"center\"\n          min-width=\"150\"\n          prop=\"processName\"\n          show-overflow-tooltip\n        />\n        <el-table-column\n          min-width=\"150\"\n          label=\"驳回次数\"\n          align=\"center\"\n          show-overflow-tooltip\n        >\n          <template #default=\"scope\">\n            <span\n              class=\"table-link-text\"\n              @click=\"\n                showRejectNode(scope.row.processKey, scope.row.processName)\n              \"\n            >{{ scope.row.rejectCount }}</span\n            >\n          </template>\n        </el-table-column>\n        >\n      </el-table>\n    </div>\n    <!--饼图-->\n    <div v-show=\"!showList\" class=\"content-body\">\n      <div\n        v-show=\"pieData.length !== 0 || !isGetResult\"\n        id=\"rejcetPie\"\n        class=\"fill\"\n      />\n      <div v-show=\"pieData.length === 0 && isGetResult\" class=\"fill empty-text\">\n        暂无数据\n      </div>\n    </div>\n\n    <el-dialog\n      :visible.sync=\"processDialog\"\n      :before-close=\"handleProcessClose\"\n      :close-on-click-modal=\"false\"\n      :title=\"`${processName}的节点工作量统计`\"\n      class