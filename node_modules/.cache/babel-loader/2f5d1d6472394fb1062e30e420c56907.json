ullName;\n      this.$forceUpdate();\n    },\n    // 设置表格高度\n    setTableHeight: function setTableHeight() {\n      var pageBody = document.getElementsByClassName('page_body');\n      this.tableHeight = pageBody[0].offsetHeight - 50 - 60 + 'px';\n    },\n    showProcessStatus: function showProcessStatus(code, dictList) {\n      //字典回显\n      if (dictList != null && code !== '') {\n        var items = dictList.filter(function (item) {\n          return item.dictKey == code;\n        });\n        if (items != null && items.length > 0) {\n          return items[0].dictValue;\n        } else {\n          return '';\n        }\n      }\n      return code;\n    },\n    handleQuery: function handleQuery() {\n      this.searchForm.current = 1;\n      this.onLoad();\n    },\n    handleDeleteOne: function handleDeleteOne(id) {\n      //删除按钮\n      var ids = id;\n      this.handleDeleteConfirm(ids);\n      // this.selectionList.filter(item => item!=id);\n    },\n    handleDelete: function handleDelete() {\n      //顶部删除\n      if (this.selectionList.length === 0) {\n        this.$message.warning(\"请选择至少一条数据\");\n        return;\n      }\n      var selectionArr = this.selectionList.filter(function (item) {\n        return item.processStatus != '1';\n      });\n      if (selectionArr.length > 0) {\n        this.$message.warning(\"当前选中盘点任务不能删除\");\n        return;\n      }\n      this.handleDeleteConfirm(this.ids);\n    },\n    handleDeleteConfirm: function handleDeleteConfirm(ids) {\n      var _this3 = this;\n      this.$confirm(\"点击确认将永久删除数据且无法恢复，请谨慎选择。\", \"确定将选择数据删除?\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(function () {\n        return taskRemove(ids + '');\n      }).then(function () {\n        _this3.onLoad();\n        _this3.$message({\n          type: \"success\",\n          message: \"操作成功!\"\n        });\n        //重新重新加载已经选择的数据。。。待实现\n      });\n    },\n    showDictLable: function showDictLable(code, dictList) {\n      //字典回显\n      if (dictList != null && code != '') {\n        var items = dictList.filter(function (item) {\n          return item.dictKey == code;\n        });\n        if (items != null && items.length > 0) {\n          return items[0].dictValue;\n        }\n      }\n      return code;\n    },\n    searchReset: function searchReset() {\n      //重置按钮\n      this.$refs.searchForm.resetFields();\n      this.onLoad();\n    },\n    dataPickerStartChange: function dataPickerStartChange(createTimes) {\n      //时间段选择\n      if (createTimes != null && createTimes.length > 0) {\n        this.searchForm.taskStartTimeS = createTimes[0];\n        this.searchForm.taskEndTimeS = createTimes[1];\n      } else {\n        this.searchForm.taskStartTimeS = null;\n        this.searchForm.taskEndTimeS = null;\n      }\n    },\n    dataPickerEndChange: function dataPickerEndChange(createTimes) {\n      //时间段选择\n      if (createTimes != null && createTimes.length > 0) {\n        this.searchForm.taskStartTimeE = createTimes[0];\n        this.searchForm.taskEndTimeE = createTimes[1];\n      } else {\n        this.searchForm.taskStartTimeE = null;\n        this.searchForm.taskEndTimeE = null;\n      }\n    },\n    handleView: function handleView(id) {\n      // 页面\n      this.$router.push({\n        path: '/detailRoute',\n        query: {\n          id: id,\n          componentName: 'pandianTaskProcessDetail',\n          routerTitle: '盘点任务详情'\n        }\n      });\n    },\n    handleApprove: function handleApprove(item) {\n      //  this.orderDeatil = row;\n      this.orderDeatil.filingNo = item.filingNo;\n      this.orderDeatil.id = item.id;\n      this.showOperate = true;\n    },\n    submitOperate: function submitOperate() {\n      this.showOperate = false;\n      this.handleQuery();\n    },\n    handleEdit: function handleEdit(id) {\n      this.$router.push({\n        path: '/detailRoute',\n        query: {\n          id: id,\n          componentName: 'pandianTaskAdd',\n          routerTitle: '盘点任务编辑'\n        }\n      });\n    },\n    handleAdd: function handleAdd() {\n      //新增 页面\n      this.$router.push({\n        path: '/detailRoute',\n        query: {\n          componentName: 'pandianTaskAdd',\n          routerTitle: '盘点任务新增'\n        }\n      });\n    },\n    handleExport: function handleExport(command) {\n      var _this4 = this;\n      if (command == \"export\") {\n        //导出\n        this.download(\"/api/idevelop-device/device/check-task/export\", {}, \"盘点任务列表.xlsx\");\n      }\n      if (command == \"visit\") {\n        // 在线预览\n        online().then(function (res) {\n          _this4.src = res.data;\n          _this4.iframeDialog = true;\n        });\n      }\n    }\n  }\n};",{"version":3,"names":["mapGetters","processDict","taskList","taskRemove","online","getDictList","operateForm","components","data","iframeDialog","src","searchForm","current","size","createSTimes","createETimes","dataList","selectionList","loading","tableHeight","undefined","total","username","statusList","pyStatusList","node","nodeName","pkStatusList","showOperate","orderDeatil","filingNo","computed","_objectSpread","ids","forEach","ele","push","id","join","mounted","console","log","permission","userDetail","setPageContentHeight","setTableHeight","getTaskStatusList","onLoad","methods","selectionChange","selection","selectionClear","$refs","dataTable","clearSelection","textColor","noCheckNum","parseInt","goDetail","index","taskId","processStatus","$message","warning","$router","path","query","componentName","routerTitle","_this","then","res","records","code","_this2","getuseApplyDept","val","applyDept","applyDeptName","fullName","$forceUpdate","pageBody","document","getElementsByClassName","offsetHeight","showProcessStatus","dictList","items","filter","item","dictKey","length","dictValue","handleQuery","handleDeleteOne","handleDeleteConfirm","handleDelete","selectionArr","_this3","$confirm","confirmButtonText","cancelButtonText","type",