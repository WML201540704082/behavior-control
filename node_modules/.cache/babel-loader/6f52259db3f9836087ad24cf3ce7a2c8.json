td>\n          指定应用的 api 路由 （非必填，默认空）<br>\n        例如：例如生成 token 时 effectiveUrl 填写/test；<br>\n        http://10.99.223.139:30000/test/api/v1 则校验成功<br>\n        http://10.99.223.139:30000/test1/api/v1 则校验失败。<br>\n        为空则不限制 api 路由\n        </td>\n      </tr>\n    </table>\n    调用生成 Token 接口时，请求头需要增加下面两个参数，否则在在线操作员列表将查不到该登录信息。<br>\n    1）request.setHeader(\"Online\", \"true\");<br>\n    2）request.setHeader(\"X-Forwarded-For\", \"浏览器客户端 ip\");<br>\n\n    <br>\n    5. 目前支持的 token 校验方式<br>\n    （1） url 参数格式 ?token= （适用浏览器单点登录访问，不要用来 API 调用携带）<br>\n    例如： http://10.99.223.139:30000/api/v1?token=<br>\n    （2） 请求头携带 X-Auth-Token<br>\n    （3） Cookie 携带 X-Subject-Token (API 接口调用推荐使用)<br>\n    推荐使用第三种\n  </basic-container>\n</template>\n\n<script>\nimport {mapGetters} from \"vuex\";\nimport request from \"@/router/axios\";\n\nexport default {\n  data() {\n    return {\n      form: {},\n      query: {},\n      loading: true,\n      selectionList: [],\n    }\n  },\n  computed: {\n    ...mapGetters([\"permission\"]),\n  },\n  methods: {\n    onLoad() {\n      this.loading = true;\n      request({\n        url: '/api/idevelop-data/h3c/application/submit',\n        method: 'post',\n        data: {}\n      }).then(res => {\n        const data = res.data;\n        this.page.total = data.total;\n        this.data = data.records;\n        this.loading = false;\n        this.selectionClear();\n      });\n    }\n  }\n};\n</script>\n<style lang=\"scss\" scoped>\ntd{   border: 1px solid; }\n</style>\n"],"mappings":";;;;;;AA6DA,SAAAA,UAAA;AACA,OAAAC,OAAA;AAEA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,IAAA;MACAC,KAAA;MACAC,OAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA,EAAAC,aAAA,KACAR,UAAA,iBACA;EACAS,OAAA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MACA,KAAAN,OAAA;MACAJ,OAAA;QACAW,GAAA;QACAC,MAAA;QACAX,IAAA;MACA,GAAAY,IAAA,WAAAC,GAAA;QACA,IAAAb,IAAA,GAAAa,GAAA,CAAAb,IAAA;QACAS,KAAA,CAAAK,IAAA,CAAAC,KAAA,GAAAf,IAAA,CAAAe,KAAA;QACAN,KAAA,CAAAT,IAAA,GAAAA,IAAA,CAAAgB,OAAA;QACAP,KAAA,CAAAN,OAAA;QACAM,KAAA,CAAAQ,c