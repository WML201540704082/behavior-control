n        label-suffix=\":\"\n        label-width=\"100px\"\n        @submit.native.prevent\n      >\n        <el-row>\n          <el-col :span=\"6\">\n            <el-form-item label=\"知识标题\" prop=\"title\">\n              <el-input v-model=\"searchForm.title\" placeholder=\"请输入\" @keyup.enter.native=\"search\" size=\"small\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"6\">\n            <el-form-item label=\"审核状态\" prop=\"status\">\n              <el-select v-model=\"searchForm.status\" clearable placeholder=\"请选择\" size=\"small\">\n                  <el-option\n                    v-for=\"item in statusList\"\n                    :value=\"item.dictKey\"\n                    :key=\"item.dictKey\"\n                    :label=\"item.dictValue\"\n                  >\n                  </el-option>\n                </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\" class=\"btn_box\">\n            <el-button size=\"mini\" type=\"primary\" @click=\"search\">查询</el-button>\n            <el-button size=\"mini\" type=\"primary\" plain @click=\"restForm\">重置</el-button>\n\n          </el-col>\n        </el-row>\n      </el-form>\n      <div class=\"table_box\">\n        <el-table\n          ref=\"questionList\"\n          :data=\"tableData\"\n          :height=\"'600px'\"\n          border\n          stripe\n          size=\"mini\"\n          v-loading=\"tableLoading\"\n        >\n          <el-table-column type=\"index\" label=\"序号\" width=\"80\" align=\"center\"></el-table-column>\n          <el-table-column label=\"知识标题\" prop=\"title\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"知识描述\" prop=\"problem\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <!-- <el-table-column label=\"审核状态\" prop=\"status\" align=\"center\" show-overflow-tooltip></el-table-column> -->\n          <el-table-column label=\"审核状态\" prop=\"status\" show-overflow-tooltip width=\"80\">\n              <template  slot-scope=\"scope\">\n                <span>{{ showDictLable(scope.row.status) }}</span>\n              </template>\n            </el-table-column>\n          <el-table-column label=\"审核意见\" prop=\"comment\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"创建时间\" prop=\"createTime\" align=\"center\" show-overflow-tooltip width=\"120\"></el-table-column>\n          <el-table-column label=\"操作\" align=\"center\" width=\"140\">\n            <template slot-scope=\"scope\">\n              <el-link type=\"primary\" :underline=\"false\" @click=\"handle1(scope.row)\" v-if=\"scope.row.status == '0'\" style=\"margin-right: 12px\">编辑</el-link>\n              <el-link type=\"primary\" :underline=\"false\" @click=\"submit(scope.row)\" v-if=\"scope.row.status == '0'\" style=\"margin-right: 12px\">提交</el-link>\n              <el-link type=\"danger\" :underline=\"false\" @click=\"delBtn(scope.row)\" v-if=\"scope.row.status == '0'\">删除</el-link>\n            </template>\n          </el-table-column>\n        </el-table>\n        <!-- 分页 -->\n        <pagination\n          :total=\"total\"\n          :page.sync=\"searchForm.current\"\n          :limit.sync=\"searchForm.size\"\n          @pagination=\"getList\"\n        />\n      </div>\n    </el-dialog>\n\n    <!-- 新建知识弹窗 -->\n    <addKnowledge\n      v-if=\"showUpload2\"\n      :questionId=\"questionId\"\n      :isShow=\"showUpload2\"\n      @close=\"lll\"\n    ></addKnowledge>\n  </div>\n</template>\n\n<script>\nimport { myKnowledge, knowledgeDelete, knowledgeSubmit } from \"@/api/ictOperation/index\"\nimport addKnowledge from './addKnowledge'\n// 文件上传\nimport website from '@/config/website';\nimport {Base64} from 'js-base64';\nimport {getToken} from '@/util/auth'\nimport { formatDate } from '@/util/date'\n\nexport default {\n  components: {addKnowledge},\n  props: ['isShow'],\n  data() {\n    return{\n      statusList: [\n        {\n          dictKey: 1,\n          dictValue: '待审核'\n        },\n        {\n          dictKey: 2,\n          dictValue: '已审核'\n        },\n        {\n          dictKey: 0,\n          dictValue: '暂存'\n        },\n      ],\n\n      searchForm: {\n        current: 1,\n        size: 20,\n        title: '',\n      },\n      tableData: [],\n      total: 0,\n      tableLoading: false,\n      \n      questionId: undefined,\n      showUpload2: false\n    }\n  },\n  mounted() {\n    this.getList()\n  },\n  methods: {\n    submit(row){\n      this.$confirm(\"是否确认提交!\",\"提示\",{\n        confirmButtonText:\"确认\",\n        cancelButtonText:\"取消\",\n        type:\"warning\"\n      }).then( async ()=>{\n        \n        // this.saveLoading = true;\n        knowledgeSubmit(row).then((res) => {\n          this.$message({\n            message: \"提交成功！\",\n            type: \"success\",\n          });\n          // this.saveLoading = false;\n          this.getList()\n        });\n\n      })\n      \n    },\n    lll(){\n      this.showUpload2 = false\n      this.getList()\n    },\n    showDictLable(status){\n      switch (status) {\n        case '0':\n          return '暂存'\n          // break;\n        case '1':\n          return '待审核'\n          // break;\n        case '2':\n          return '已审核'\n          // break;\n        // default:\n        //   break;\n      }\n    },\n    getList() {\n      this.tableLoading = true\n      myKnowledge(this.searchForm).then(res => {\n        this.tableData = res.data.records\n        this.total = res.data.total\n        this.tableLoading = false\n      })\n    },\n\n    search() {\n      this.searchForm.current = 1\n      this.getList()\n    },\n    restForm() {\n      this.searchForm = {\n        current: 1,\n        size: 20,\n        resourceCondition: '',\n      }\n      this.getList()\n    },\n    handle1(item){\n      this.questionId = item.id\n      this.showUpload2 = true\n    },\n    delBtn(row) {\n      this.$confirm('确定删除该典型经验?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        knowledgeDelete({id: row.id}).then(res => {\n          this.$message({\n            message: '删除成功！',\n            type: 'success'\n          });\n          this.getList()\n        })\n      })\n    },\n\n  },\n}\n</script>\n\n<style lang=\"scss\" scoped>\n::v-deep .btn_box{\n  height: 40px;\n  display: flex;\n  align-items: center;\n  padding-left: 20px;\n}\n</style>\n"],"mappings":";;AAgGA,SAAAA,WAAA,EAAAC,eAAA,EAAAC,eAAA;AACA,OAAAC,YAAA;AACA;AACA,OAAAC,OAAA;AACA,SAAAC,MAAA;AACA,SAAAC,QAAA;AACA,SAAAC,UAAA;AAEA;EACAC,UAAA;IAAAL,YAAA,EAAAA;EAAA;EACAM,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA,GACA;QACAC,OAAA;QACAC,SAAA;MACA,GACA;QACAD,OAAA;QACAC,SAAA;MACA,GACA;QACAD,OAAA;QACAC,SAAA;MACA,EACA;MAEAC,UAAA;QACAC,OAAA;QACAC,IAAA;QACAC,KAAA;MACA;MACAC,SAAA;MACAC,KAAA;MACAC,YAAA;MAEAC,UAAA,EAAAC,SAAA;MACAC,WAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,OAAA;EACA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAAC,GAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA,eAAAC,iBAAA,eAAAC,kBAAA,CAAAC,IAAA,UAAAC,QAAA;QAAA,OAAAF,kBAAA,CAAAG,IAAA,UAAAC,SAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,IAAA,GAAAD,QAAA,CAAAE,IAAA;YAAA;cAEA;cACAzC,eAAA,CAAA0B,GAAA,EAAAM,IAAA,WAAAU,GAAA;gBACAf,KAAA,CAAAgB,QAAA;kBACAC,OAAA;kBACAb,IAAA;gBACA;gBACA;gBACAJ,KAAA,CAAAJ,OAAA;cACA;YAAA;YAAA;cAAA,OAAAgB,QAAA,CAAAM,IAAA;UAAA;QAAA,GAAAT,OAAA;MAAA,CAEA;IAEA;IACAU,GAAA,WAAAA,IAAA;MACA,KAAAzB,WAAA;MACA,KAAAE,OAAA;IACA;IACAwB,aAAA,WAAAA,cAAAC,MAAA;MACA,QAAAA,MAAA;QACA;UACA;QACA;QACA;UACA;QACA;QACA;UACA;QACA;QACA;QACA;MACA;IACA;IACAzB,OAAA,WAAAA,QAAA;MAAA,IAAA0B,MAAA;MACA,KAAA/B,YAAA;MACApB,WAAA,MAAAc,UAAA,EAAAoB,IAAA,WAAAU,GAAA;QACAO,MAAA,CAAAjC,SAAA,GAAA0B,GAAA,CAAAlC,IAAA,CAAA0C,OAAA;QACAD,MAAA,CAAAhC,KAAA,GAAAyB,GAAA,CAAAlC,IAAA,CAAAS,KAAA;QACAgC,MAAA,CAAA/B,YAAA;MACA;IACA;IAEAiC,MAAA,WAAAA,OAAA;MACA,KAAAvC,UAAA,CAAAC,OAAA;MACA,KAAAU,OAAA;IACA;IACA6B,QAAA,