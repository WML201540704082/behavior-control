eId\">\n            <el-input v-model=\"submitParams.ciTypeId\" placeholder=\"请输入\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"模型图标\" prop=\"ciIcon\">\n            <!--            <el-input v-model=\"submitParams.ciIcon\" placeholder=\"请选择\" @focus=\"iconClick\" @clear=\"iconClear\" clearable></el-input>-->\n            <el-input v-model=\"submitParams.ciIcon\" placeholder=\"请选择\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"是否需要级联\" prop=\"isExistCascade\">\n            <el-select v-model=\"submitParams.isExistCascade\" placeholder=\"请选择\" clearable filterable>\n              <el-option v-for=\"(item,index) in yesNoList\"\n                         :key=\"index\"\n                         :label=\"item.name\"\n                         :value=\"item.code\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"查询模型ID\" prop=\"selectCiId\">\n            <el-input v-model=\"submitParams.selectCiId\" placeholder=\"请输入\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"24\">\n          <el-form-item label=\"查询模型英文名\" prop=\"selectCiName\">\n            <el-input v-model=\"submitParams.selectCiName\" placeholder=\"请输入\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n\n        <el-col :span=\"24\">\n          <el-form-item label=\"级联模型信息\" prop=\"cascadeCiInfo\">\n            <el-input v-model=\"submitParams.cascadeCiInfo\" placeholder=\"请输入\" clearable></el-input>\n          </el-form-item>\n        </el-col>\n      </el-row>\n    </el-form>\n    <div class=\"btn_box\">\n      <el-button type=\"primary\" error @click=\"submit\" :loading=\"saveLoading\">{{ getTitle(type) }}</el-button>\n      <el-button type=\"danger\" plain @click=\"$emit('close')\">关 闭</el-button>\n    </div>\n\n    <icon-choose v-if=\"showIconChoose\"\n                 :isShow=\"showIconChoose\"\n                 @close=\"showIconChoose = false\"\n                 @chooseClick=\"chooseClick\"></icon-choose>\n  </el-dialog>\n</template>\n\n<script>\nimport {save, update} from \"@/api/treeManager/cmdbres\";\nimport IconChoose from \"@/components/iconChoose/index.vue\";\n\nexport default {\n  name: \"CmdbResAddEdit\",\n  components: {IconChoose},\n  props: ['fromValue', 'isShow', 'type'],\n  data() {\n    return {\n      submitParams: {},\n      rules: {\n        ciId: [{required: true, message: '模型ID不能为空', trigger: 'blur'}],\n        ciLabel: [{required: true, message: '模型中文名不能为空', trigger: 'blur'}],\n        ciName: [{required: true, message: '模型英文名不能为空', trigger: 'blur'}],\n\n        selectCiId: [{required: true, message: '查询模型ID不能为空', trigger: 'blur'}],\n        selectCiName: [{required: true, message: '查询模型英文名不能为空', trigger: 'blur'}],\n      },\n      saveLoading: false,\n      yesNoList: null,\n\n      showIconChoose: false,\n    };\n  },\n  mounted() {\n    if (this.type == 'edit') {\n      this.submitParams = JSON.parse(JSON.stringify(this.fromValue));\n    }\n\n    this.initDict();\n  },\n  methods: {\n    initDict() {\n      this.yesNoList = [{\n        name: '是',\n        code: 1\n      }, {\n        name: '否',\n        code: 0\n      },];\n    },\n    submit() {\n      this.$refs.submitForm.validate((valid) => {\n        if (valid) {\n          if (this.type == 'add') {\n            this.saveLoading = true;\n            save(this.submitParams).then(res => {\n              this.saveLoading = false\n              this.$message.success('添加成功');\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          } else if (this.type == 'edit') {\n            this.saveLoading = true;\n            update(this.submitParams).then(res => {\n              this.saveLoading = false\n              this.$message.success('修改成功');\n              this.$emit(\"close\");\n              this.$emit(\"refreshData\");\n            });\n          }\n        }\n      })\n    },\n    iconClick() {\n      this.showIconChoose = true;\n    },\n    chooseClick(arg) {\n      this.submitParams.ciIcon = arg.icon;\n    },\n    iconClear() {\n      this.$forceUpdate()\n    },\n    getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    },\n  },\n}\n</script>\n<style lang=\"scss\" scoped>\n.btn_box {\n  text-align: center;\n}\n</style>\n"],"mappings":"AA6FA,SAAAA,IAAA,EAAAC,MAAA;AACA,OAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF,UAAA,EAAAA;EAAA;EACAG,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,YAAA;MACAC,KAAA;QACAC,IAAA;UAAAC,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAC,OAAA;UAAAH,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAE,MAAA;UAAAJ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QAEAG,UAAA;UAAAL,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAI,YAAA;UAAAN,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAK,WAAA;MACAC,SAAA;MAEAC,cAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,SAAAC,IAAA;MACA,KAAAd,YAAA,GAAAe,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAAC,SAAA;IACA;IAEA,KAAAC,QAAA;EACA;EACAC,OAAA;IACAD,QAAA,WAAAA,SAAA;MACA,KAAAR,SAAA;QACAf,IAAA;QACAyB,IAAA;MACA;QACAzB,IAAA;QACAyB,IAAA;MACA;IACA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,KAAA,CAAAC,UAAA,CAAAC,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACA,IAAAJ,KAAA,CAAAT,IAAA;YACAS,KAAA,CAAAb,WAAA;YACAjB,IAAA,CAAA8B,KAAA,CAAAvB,YAAA,EAAA4B,IAAA,WAAAC,GAAA;cACAN,KAAA,CAAAb,WAAA;cACAa,KAAA,CAAAO,QAAA,CAAAC,OAAA;cACAR,KAAA,CAAAS,KAAA;cACAT,KAAA,CAAAS,KAAA;YACA;UACA,WAAAT,KAAA,CAAAT,IAAA;YACAS,KAAA,CAAAb,WAAA;YACAhB,MAAA,CAAA6B,KAAA,CAAAvB,YAAA,EAAA4B,IAAA,WAAAC,GAAA;cACAN,KAAA,CAAAb,WAAA;cACAa,KAAA,CAAAO,QAAA,CAAAC,OAAA;cACAR,KAAA,CAAAS,KAAA;cACAT,KAAA,CAAAS,KAAA;YACA;UACA;QACA;MACA;IACA;IACAC,SAAA,WAAAA,UAAA;MACA,KAAArB,cAAA;IACA;IACAsB,WAAA,WAAAA,YAAAC,GAAA;MACA,KAAAnC,YAAA,CAAAoC,MAAA,GAAAD,GAAA,