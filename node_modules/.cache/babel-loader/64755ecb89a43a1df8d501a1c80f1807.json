  </el-row>\n        <el-table\n          ref=\"dataTable\"\n          stripe\n          size=\"small\"\n          :data=\"dataList\"\n          :height=\"tableHeight\"\n        >\n          <el-table-column type=\"index\" label=\"序号\" min-width=\"50\" align=\"center\"></el-table-column>\n          <el-table-column prop=\"ip\" label=\"终端IP\" min-width=\"150\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column prop=\"userName\" label=\"登录用户\" min-width=\"100\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <!-- <el-table-column prop=\"department\" label=\"用户部门\" min-width=\"100\" align=\"center\" show-overflow-tooltip></el-table-column> -->\n          <el-table-column prop=\"openTime\" label=\"开机时间\" min-width=\"100\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column prop=\"showdownTime\" label=\"关机时间\" min-width=\"100\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column prop=\"onlineLength\" label=\"在线时长\" min-width=\"90\" align=\"center\" show-overflow-tooltip>\n            <template  slot-scope=\"scope\">\n              <span>{{formatSecondsToHMS(scope.row.onlineLength)}}</span>\n            </template>\n          </el-table-column>\n        </el-table>\n        <pagination\n          :total=\"total\"\n          :page.sync=\"searchForm.current\"\n          :limit.sync=\"searchForm.size\"\n          @pagination=\"onLoad\"\n        />\n      </div>\n  \n    </basic-container>\n  </template>\n  \n  <script>\n  import {getTerminalMonitoringList} from \"@/api/terminal\";\n  import moment from \"moment\";\n  export default {\n    data() {\n      return {\n        // 搜索相关\n        searchForm: {\n          ip: undefined,\n          status: undefined,\n          current: 1,\n          size: 20,\n        },\n        // 表格相关\n        dataList: [],\n        loading: false,\n        tableHeight: undefined,\n        total: 0,\n      };\n    },\n    components: {moment},\n    mounted(){\n      // 设置页面元素高度\n      this.setPageContentHeight()\n      // 设置表格高度\n      this.setTableHeight()\n      //加载数据\n      this.onLoad();\n    },\n    methods: {\n      // 设置表格高度\n      setTableHeight() {\n        let pageBody = document.getElementsByClassName('page_body')\n        this.tableHeight = pageBody[0].offsetHeight - 61 - 47 + 'px'\n      },\n      handleQuery() {\n        this.searchForm.current = 1\n        this.onLoad();\n      },\n      searchReset() {\n        //重置按钮\n        this.searchForm = {\n          ip: undefined,\n          status: undefined,\n          current: 1,\n          size: 20,\n        }\n        this.onLoad();\n      },\n      onLoad() {\n        //加载数据\n        this.loading = true;\n        getTerminalMonitoringList(this.searchForm).then(res => {\n          const data = res.data;\n          this.total = data.total;\n          this.dataList = data.records.map(item=> {\n            return {\n              ...item,\n              openTime: moment(item.openTime).format(\"YYYY-MM-DD HH:mm:ss\"),\n              showdownTime: moment(item.showdownTime).format(\"YYYY-MM-DD HH:mm:ss\"),\n            }\n          });\n          this.loading = false;\n        });\n      },\n    }\n  };\n  </script>\n  "],"mappings":";;;;;;AA+DA,SAAAA,yBAAA;AACA,OAAAC,MAAA;AACA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,UAAA;QACAC,EAAA,EAAAC,SAAA;QACAC,MAAA,EAAAD,SAAA;QACAE,OAAA;QACAC,IAAA;MACA;MACA;MACAC,QAAA;MACAC,OAAA;MACAC,WAAA,EAAAN,SAAA;MACAO,KAAA;IACA;EACA;EACAC,UAAA;IAAAZ,MAAA,EAAAA;EAAA;EACAa,OAAA,WAAAA,QAAA;IACA;IACA,KAAAC,oBAAA;IACA;IACA,KAAAC,cAAA;IACA;IACA,KAAAC,MAAA;EACA;EACAC,OAAA;IACA;IACAF,cAAA,WAAAA,eAAA;MACA,IAAAG,QAAA,GAAAC,QAAA,CAAAC,sBAAA;MACA,KAAAV,WAAA,GAAAQ,QAAA,IAAAG,YAAA;IACA;IACAC,WAAA,WAAAA,YAAA;MACA,KAAApB,UAAA,CAAAI,OAAA;MACA,KAAAU,MAAA;IACA;IACAO,WAAA,WAAAA,YAAA;MACA;MACA,KAAArB,UAAA;QACAC,EAAA,EAAAC,SAAA;QACAC,MAAA,EAAAD,SAAA;QACAE,OAAA;QACAC,IAAA;MACA;MACA,KAAAS,MAAA;IACA;IACAA,MAAA,WAAAA,OAAA;MAAA,IA