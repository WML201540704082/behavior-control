const data = res.data;\n          this.optList = data.records;\n        });\n      },\n\n      loadDetail(id) {\n        scrapDetail(id).then(res => {\n          this.form = res.data;\n          this.form.isScrap = res.data.isScrap == 0 ? '是' : '否'\n          this.deviceList = res.data.scrapListVOS.sort((a, b) => {\n            return parseInt(a.sort) - parseInt(b.sort);\n          });\n\n          this.getApprovePersons();\n\n        });\n      },\n\n      getApprovePersons() {\n        if (!this.form.useKeepDept) {\n          this.$message.warning('请先选择实物保管部门')\n          return;\n        }\n        scrapGetApprove(this.form.useKeepDept, 1).then(res => {\n          if (res.code == 200) {\n            this.approvePersons = res.data;\n          }\n        });\n        scrapGetApprove(this.form.useKeepDept, 0).then(res => {\n          if (res.code == 200) {\n            this.submitPersons = res.data;\n          }\n        });\n      },\n\n      //返回\n      back() {\n        this.$closePage('/operation/devReturned')\n      },\n    }\n  };\n</script>\n<style lang=\"scss\" scoped>\n  .devRenCon {\n    width: 100%;\n    height: 100%;\n  }\n\n  .formLabel {\n    line-height: 16px;\n    display: block;\n  }\n\n  .description {\n    p {\n      text-align: left !important;\n    }\n  }\n</style>\n"],"mappings":";;;;;;;AAsPA,OAAAA,SAAA;AACA,OAAAC,YAAA;AACA,OAAAC,gBAAA;AACA,SAAAC,WAAA,EAAAC,eAAA;AACA,SAAAC,aAAA;AACA,OAAAC,IAAA;AACA,SAAAC,eAAA;AACA,OAAAC,WAAA;AACA,SAAAC,cAAA;AACA,SAAAC,UAAA;AAEA;EACAC,UAAA;IAAAV,YAAA,EAAAA,YAAA;IAAAC,gBAAA,EAAAA,gBAAA;IAAAI,IAAA,EAAAA,IAAA;IAAAE,WAAA,EAAAA,WAAA;IAAAR,SAAA,EAAAA;EAAA;EACAY,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;MAEAC,gBAAA;MACAC,OAAA;MACAC,gBAAA;MACAC,IAAA;MACAC,OAAA;MACAC,UAAA;MACAC,WAAA;MACAC,cAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA,EAAAC,aAAA,KACAhB,UAAA,iBACA;EACAiB,OAAA,WAAAA,QAAA;IACA;IACA;IACA;IACA,KAAAC,EAAA;IACA;IACA,IAAAC,MAAA,QAAAC,WAAA;IACA,KAAAF,EAAA,GAAAC,MAAA,CAAAD,EAAA;IAEA,IAAAC,MAAA,CAAAD,EAAA;MACA,KA