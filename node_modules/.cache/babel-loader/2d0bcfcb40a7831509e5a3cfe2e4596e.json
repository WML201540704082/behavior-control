ceptDetail = [{required: true, message: '未采纳原因不能为空', trigger: 'blur'}]\n      // }\n    },\n    deptChange: function deptChange(val) {\n      var current = this.deptList.filter(function (ele) {\n        return ele.id == val;\n      })[0];\n      this.formDetial.deptName = current.fullName;\n    },\n    getDictList: function getDictList(code) {\n      var _this4 = this;\n      //加载字典\n      _getDictList(code).then(function (res) {\n        if (code === 'back_isAccept') {\n          _this4.isAcceptOptions = res.data;\n        } else if (code === 'back_type') {\n          _this4.backTypeOptions = res.data;\n        }\n      });\n    },\n    selectDeviceFileHandler: function selectDeviceFileHandler(file123, fileList) {\n      //新增文件\n      // this.form.orderFile = undefined\n      // if(file123){\n      //   this.form.orderFile = file123\n      // }\n      // console.log(111, file123, fileList)\n\n      var arr = fileList.map(function (ele) {\n        if (ele.response) {\n          return ele.response.data.link;\n        } else {\n          return ele.url;\n        }\n      });\n      this.formDetial.img = arr.join(',');\n      this.$refs.submitForm.validateField('img');\n    },\n    getDeptList: function getDeptList() {\n      var _this5 = this;\n      getDept({}).then(function (res) {\n        _this5.deptList = res.data;\n      });\n    },\n    selectionChange: function selectionChange(val) {\n      this.selectionList = val;\n    },\n    submit: function submit() {\n      var _this6 = this;\n      this.$refs.submitForm.validate(function (valid) {\n        if (valid) {\n          if (_this6.type == 'add') {\n            _this6.saveLoading = true;\n            feedbackSave(_this6.formDetial).then(function (res) {\n              _this6.saveLoading = false;\n              _this6.$message.success('添加成功');\n              _this6.$emit(\"close\");\n              _this6.$emit(\"refreshData\");\n            });\n          } else if (_this6.type == 'edit') {\n            _this6.saveLoading = true;\n            feedbackUpdate(_this6.formDetial).then(function (res) {\n              _this6.saveLoading = false;\n              _this6.$message.success('修改成功');\n              _this6.$emit(\"close\");\n              _this6.$emit(\"refreshData\");\n            });\n          } else if (_this6.type == 'adopt') {\n            _this6.saveLoading = true;\n            feedbackAccept(_this6.formDetial).then(function (res) {\n              _this6.saveLoading = false;\n              _this6.$message.success('操作成功');\n              _this6.$emit(\"close\");\n              _this6.$emit(\"refreshData\");\n            });\n          } else if (_this6.type == 'finshed') {\n            _this6.saveLoading = true;\n            feedbackFinish(_this6.formDetial).then(function (res) {\n              _this6.saveLoading = false;\n              _this6.$message.success('操作成功');\n              _this6.$emit(\"close\");\n              _this6.$emit(\"refreshData\");\n            });\n          }\n        }\n      });\n    },\n    getTitle: function getTitle(type) {\n      if (type == 'add') {\n        return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      } else if (type == 'check') {\n        return '查 看';\n      } else if (type == 'adopt') {\n        return '采 纳';\n      } else if (type == 'finshed') {\n        return '完 成';\n      }\n      return null;\n    }\n  }\n};",{"version":3,"names":["getList","getDept","feedbackSave","feedbackUpdate","feedbackDetail","feedbackAccept","feedbackFinish","feedbackLoad","add","update","Message","getDictList","getDictCmdbList","getDictCmdbListPid","props","components","data","makerList","brandList","deptList","formDetial","isFinish","backType","maker","makerCode","brand","brandCode","series","model","isView","fileList","isAcceptOptions","isFinishOptions","dictKey","dictValue","backTypeOptions","saveLoading","typeList","rules","backNum","required","message","trigger","dept","userName","createTime","phone","backDeta