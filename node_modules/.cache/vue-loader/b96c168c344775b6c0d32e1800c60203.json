  <el-input\n                  v-model=\"inputSelect\"\n                  prefix-icon=\"el-icon-search\"\n                  placeholder=\"按Enter键搜索\"\n                  clearable\n\n                  @focus=\"inpFocus\"\n                  @blur=\"isbg = false\"\n                  @keyup.enter.native=\"changeFilter\"\n                />\n\n\n              </div>\n              <div class=\"pop-box\">\n                <div\n                  v-for=\"(group, index) in options\"\n                  :key=\"index\">\n                  <div class=\"div-label\">\n                    <span>{{ group.label }}</span>\n                    <span\n                      v-if=\"group.options.length > 5\"\n                      class=\"label-btn\"\n                      @click=\"group.show = !group.show\"\n                    >\n                      {{ group.show ? \"收起\" : \"更多\" }}\n                    </span>\n                  </div>\n                  <div v-if=\"group.show\">\n                    <div\n                      v-for=\"item in group.options\"\n                      :key=\"item.id\">\n                      <div\n                        class=\"div-label div-pop\"\n                        @click=\"changeInput(item)\"\n                      >\n                        <span\n                          v-for=\"(it, ind) in item.label\"\n                          :key=\"'span' + ind\"\n                          :style=\"{color: inputSelect.indexOf(it) > -1 ? 'var(--theme-color)' : ''}\">{{ it }}</span>\n                      </div>\n                    </div>\n                  </div>\n                  <div v-else>\n                    <div\n                      v-for=\"item in group.options.slice(0, 5)\"\n                      :key=\"item.id\"\n                    >\n                      <div\n                        class=\"div-label div-pop\"\n                        @click=\"changeInput(item)\"\n                      >\n                        <span\n                          v-for=\"(it, ind) in item.label\"\n                          :key=\"'span' + ind\"\n                          :style=\"{color: inputSelect.indexOf(it) > -1 ? 'var(--theme-color)' : ''}\">{{ it }}</span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-popover>\n          </div>\n          <!-- 树结构 -->\n          <div\n            v-if=\"treeData.length\"\n            class=\"cont-tree-box\">\n            <el-tree\n              ref=\"tree-normal\"\n              :data=\"treeData\"\n              :indent=\"8\"\n              :props=\"props\"\n              :default-expand-all=\"true\"\n              :render-content=\"renderContent\"\n              :highlight-current=\"true\"\n              class=\"roleTree lcdp-tree work-tree work-tree1\"\n              node-key=\"id\"\n              @node-click=\"handleNodeClick\"/>\n          </div>\n          <!-- 懒加载树 -->\n          <div\n            v-else\n            class=\"cont-tree-box\">\n            <el-tree\n              ref=\"tree-lazy\"\n              :key=\"treeKey\"\n              :indent=\"8\"\n              :props=\"props\"\n              :load=\"loadNode\"\n              :render-content=\"renderContent\"\n              :highlight-current=\"true\"\n              class=\"roleTree lcdp-tree work-tree work-tree2\"\n              node-key=\"id\"\n              lazy\n              @node-click=\"handleNodeClick\"/>\n          </div>\n        </div>\n        <!-- 用户名称和部门列表 -->\n        <div class=\"cont-table\">\n          <div class=\"table-tit\">\n            <span\n              :title=\"JSON.stringify(tableItem) !== '{}' ? tableItem.label : ''\"\n              class=\"organ-name\">\n              {{ tableList.length && JSON.stringify(tableItem) !== \"{}\" ? tableList[0].parentName : (JSON.stringify(tableItem) !== \"{}\" ? tableItem.label : '') }}\n            </span>\n            <span v-if=\"tableList.length && JSON.stringify(tableItem) !== '{}'\">（{{ totalCount }}）</span>\n            <span v-else-if=\"JSON.stringify(tableItem) !== '{}'\">（0）</span>\n          </div>\n          <div\n            class=\"jxd_ins_elTable default\"\n            style=\"height: calc(100% - 50px);width:auto;\">\n            <el-table\n              v-loading=\"tableLoading\"\n              ref=\"multipleTable\"\n              :data=\"tableList\"\n              :row-key=\"getRowKey\"\n              highlight-current-row\n              height=\"calc(100% - 53px)\"\n              tooltip-effect=\"dark\"\n              style=\"width: 100%\"\n              class=\"lcdp-table\"\n              @current-change=\"tableChange\"\n            >\n              <el-table-column\n                label=\" \"\n                width=\"50\">\n                <template slot-scope=\"scope\">\n                  <el-radio\n                    v-model=\"selection\"\n                    :label=\"scope.row\"\n                  ><i/></el-radio>\n                </template>\n              </el-table-column>\n              <el-table-column\n                :show-overflow-tooltip=\"true\"\n                prop=\"label\"\n                label=\"用户名称\"/>\n              <el-table-column\n                :show-overflow-tooltip=\"true\"\n                prop=\"parentName\"\n                label=\"部门\"/>\n            </el-table>\n            <!-- 翻页 -->\n            <div class=\"page\">\n              <el-pagination\n                :current-page.sync=\"currentPage\"\n                :page-size=\"PageSize\"\n                :page-sizes=\"pageSizes\"\n                :total=\"totalCount\"\n                layout=\"total, sizes, prev, pager, next\"\n                popper-class=\"lcdp-page-select\"\n                @current-change=\"handleCurrentChange\"\n                @size-change=\"handleSizeChange\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- 已选 -->\n      <div clas