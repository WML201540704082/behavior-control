{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/cmdb/components/configFormComponent/cientityList.vue?vue&type=script&lang=js","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/cmdb/components/configFormComponent/cientityList.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/babel-loader/lib/index.js","mtime":456789000000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\nimport { globalattrDetail, globalattrSave } from \"@/api/system/relationManage\";\nimport { attrrelSearch } from \"@/api/cmdb/ciConfig\";\n\nexport default {\n  props: ['isShow', 'ciId', 'showType'],\n  data() {\n    return{\n      attrRelList: []\n\n    }\n  },\n  mounted() {\n    this.getDetail()\n  },\n  methods: {\n    // 详情\n    getDetail() {\n      attrrelSearch({ciId: this.ciId}).then(res => {\n        this.attrRelList = res.Return;\n      })\n    },\n    selectExportItem(item) {\n      this.$set(item, 'selected', !item.selected);\n    },\n    selectAllExportItem() {\n      this.attrRelList.forEach(element => {\n        this.$set(element, 'selected', true);\n      });\n    },\n    // 保存\n    save() {\n      let selectArr = this.attrRelList.filter(el=> el.selected)\n\n      let params = {\n        ciId: this.ciId,\n        showAttrRelList: selectArr.map(el => el.uid)\n      }\n      this.download(\n        \"/api/idevelop-cmdb/ci/cmdb/cientity/export\",\n        params,\n        this.ciId + \"_配置项.xlsx\"\n      );\n      this.$emit('close')\n\n    }\n  }\n}\n",{"version":3,"sources":["cientityList.vue"],"names":[],"mappings":";AAoCA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA","file":"cientityList.vue","sourceRoot":"src/views/cmdb/components/configFormComponent","sourcesContent":["<template>\n  <div>\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"isShow\"\n      title=\"请选择需要导出的属性\"\n      width=\"700px\"\n      top=\"10vh\"\n      v-el-drag-dialog\n    >\n      <div class=\"exportItemContainer\">\n        <div\n          v-for=\"(item, index) in attrRelList\"\n          :key=\"index\"\n          class=\"exportItem overflow padding-xs\"\n          @click=\"selectExportItem(item)\"\n        >\n          <i v-if=\"item.selected\" class=\"el-icon-success text-success selected\"></i>\n          <div>{{ item.label }}</div>\n          <div class=\"text-grey\">{{ item.name }}</div>\n        </div>\n\n      </div>\n      <div class=\"btn-line\">\n        <el-button type=\"primary\" plain @click=\"$emit('close')\">取消</el-button>\n        <el-button type=\"primary\" @click=\"selectAllExportItem\">全选</el-button>\n        <el-button type=\"primary\" @click=\"save\">确认</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { globalattrDetail, globalattrSave } from \"@/api/system/relationManage\";\nimport { attrrelSearch } from \"@/api/cmdb/ciConfig\";\n\nexport default {\n  props: ['isShow', 'ciId', 'showType'],\n  data() {\n    return{\n      attrRelList: []\n\n    }\n  },\n  mounted() {\n    this.getDetail()\n  },\n  methods: {\n    // 详情\n    getDetail() {\n      attrrelSearch({ciId: this.ciId}).then(res => {\n        this.attrRelList = res.Return;\n      })\n    },\n    selectExportItem(item) {\n      this.$set(item, 'selected', !item.selected);\n    },\n    selectAllExportItem() {\n      this.attrRelList.forEach(element => {\n        this.$set(element, 'selected', true);\n      });\n    },\n    // 保存\n    save() {\n      let selectArr = this.attrRelList.filter(el=> el.selected)\n\n      let params = {\n        ciId: this.ciId,\n        showAttrRelList: selectArr.map(el => el.uid)\n      }\n      this.download(\n        \"/api/idevelop-cmdb/ci/cmdb/cientity/export\",\n        params,\n        this.ciId + \"_配置项.xlsx\"\n      );\n      this.$emit('close')\n\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n  .exportItemContainer {\n    display: grid;\n    grid-template-columns: 25% 25% 25% 25%;\n  }\n  .exportItemContainer .exportItem {\n    cursor: pointer;\n    font-size: 12px;\n    border-radius: 4px;\n    position: relative;\n  }\n  .exportItemContainer .exportItem .selected {\n      position: absolute;\n      right: 5px;\n      top: 5px;\n  }\n  .btn-line{\n    text-align: right;\n    margin-top: 10px;\n  }\n  .text-success {\n      color: #25b864;\n  }\n  .padding-xs {\n      padding: 6px;\n  }\n</style>\n"]}]}