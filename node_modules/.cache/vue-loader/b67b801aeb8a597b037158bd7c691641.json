tleText}}</span>\n    </div>\n   \n   <div class=\"right_b\" v-if='showBtn'>\n        <el-button type=\"primary\" v-if=\"titleText=='全局配置'\" @click='saveClick'>保存</el-button>\n        <el-button type=\"primary\" v-else  @click=\"editClick\" plain>{{title}}</el-button>\n   </div>\n\n\n   </div>\n</template>\n\n<script>\nexport default {\n  props: {\n    titleText:{\n      type:String,\n      default:'',\n    },\n    showBtn:{\n      type:Boolean,\n      default:true,\n    }\n  },\n  data() {\n    return{\n      title:'修改',\n    }\n  },\n  methods:{\n    editClick(){\n           let text = this.titleText;\n           if(this.title === '修改'){\n            this.$emit('edit',text);\n            this.title = '保存';\n           }else{\n            this.$emit('save',text);\n           }\n    },\n    saveClick(){\n      let text = this.titleText;\n      this.$emit('save',text);\n      \n    },\n\n    setBtnTitleC(){\n      this.title = '修改';\n    },\n  },\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.page_set_title{\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-top:10px;\n    span{\n        font-size: 14px;\n        margin-left: 8px;\n        font-size: 15px;\n       color: #374c78;\n       font-weight: 700;\n    }\n\n  /deep/ .el-icon-s-tools:before{\n        color: #3a86ff;\n    }\n\n    .t_content{\n      text-align: left;\n    }\n    .right_b{\n      text-align: right;\n    }\n\n}\n</style>\n"]}]}