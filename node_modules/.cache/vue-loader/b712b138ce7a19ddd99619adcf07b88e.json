le=\"font-size: 25px;cursor: pointer;\"\n              :class=\"item\"\n              @click=\"changeIcon(item)\"\n            ></i>\n          </el-col>\n        </scrollbarBox>\n        \n      </el-row>\n      <div class=\"submit_btn\">\n        <el-button type=\"primary\" size=\"small\" @click=\"save\">确 定</el-button>\n        <el-button size=\"small\" @click=\"$emit('close')\">取 消</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { getIconList } from \"@/api/system/ciModel\";\n\nexport default {\n  props: ['isShow', 'selectIcon'],\n  data() {\n    return{\n      iconList: [],\n      activeIcon: ''\n    }\n  },\n  mounted() {\n    this.initData()\n  },\n  methods: {\n    initData() {\n      this.activeIcon = this.selectIcon\n      getIconList({type: ['cmdb']}).then(res => {\n        // console.log(res)\n        this.iconList = res.Return\n      })\n    },\n    changeIcon(item) {\n      this.activeIcon = item\n    },\n    save() {\n      this.$emit('submitIcon', this.activeIcon)\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.icon_item{\n  text-align: center;\n}\n</style>\n"]}]}