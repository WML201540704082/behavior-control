});\n    },\n  }\n};\n</script>\n<style lang=\"scss\" scoped>\n  ::v-deep .el-input.is-disabled .el-input__inner{\n    color: #606266;\n  }\n  .oldList{\n    width: 320px;\n    margin: 0 auto;\n    p{\n      display: flex;\n      margin: 0;\n    }\n    .labell{\n      width: 120px;\n      text-align: right;\n    }\n    .valuer{\n      flex: 1;\n      color: #a9b4ca;\n      text-align: left;\n      margin-left: 10px;\n    }\n  }\n  ::v-deep .newList{\n    width: 300px;\n    margin: 0 auto;\n    .el-form-item__label{\n      font-size: 12px;\n    }\n    .el-form-item--mini.el-form-item{\n      margin-bottom: 3px;\n    }\n  }\n</style>\n"]}]}