      isJiejue: false,\n      listApi: myQuestionList,\n      searchForm: {\n        deptId: undefined,\n        deptName: undefined,\n        type: undefined,\n        status: undefined,\n        current: 1,\n        size: 20\n      },\n      questionData: [],\n      total: 0,\n      tableLoading: false,\n      questionId: '',\n      showOperate: false,\n      showSolve: false,\n      showDetail: false,\n      showUpdateForm: false,\n\n    }\n  },\n  computed: {\n    ...mapGetters([\"permission\", \"userDetail\"]),\n    permissionList() {\n      return {\n        questionTodo: this.vaildData(this.permission.question_todo, false),\n        questionDone: this.vaildData(this.permission.question_done, false),\n      };\n    },\n    isRoleAlias(){\n      return this.$store.state.user.userDetail.roleAlias.includes('control_solver')\n    }\n  },\n  mounted() {\n    this.getDict()\n    this.getList()\n  },\n  methods: {\n    getEntityUnit(val) {\n      //选择单位 部门\n      this.searchForm.deptId = val.id\n      this.searchForm.deptName = val.fullName\n      this.$refs.searchForm.$forceUpdate()\n      this.$forceUpdate()\n    },\n    handleSearch(){\n      this.getList()\n    },\n    handleExport() {\n      //导出\n      let types1 = {\n        '0': \"我的问题\",\n        '1': \"待办任务\",\n        '2': \"已办任务\",\n        '3': \"需求\",\n      }\n      let types2 = {\n        '0': \"my\",\n        '1': \"todo\",\n        '2': \"done\",\n        '3': \"demand\",\n      }\n\n      \n      this.$confirm(\"是否导出数据?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(() => {\n        this.download(\n          \"/api/idevelop-control/question/download/exportNew\",\n          this.searchForm,\n          \"全部问题.xlsx\"\n        )\n      });\n      \n    },\n\n    // 字典值\n    getDict() {\n      let dict = ['control_question_type']\n      for(let i=0; i<dict.length; i++) {\n        getDictList(dict[i]).then(res => {\n          if(dict[i] == 'control_question_type') { //问题类型\n            this.typeList = res.data\n          }\n        })\n      }\n    },\n\n    getList() {\n      // this.tableLoading = true\n      // this.listApi(this.searchForm).then(res => {\n      //   this.questionData = res.data.records\n      //   this.total = res.data.total\n      //   this.tableLoading = false\n      // })\n\n      this.tableLoading = true\n      questionList(this.searchForm).then(res => {\n        this.questionData = res.data.records\n        this.total = res.data.total\n        this.tableLoading = false \n      })\n    },\n    handleClick(tabs) {\n      this.listApi = myQuestionList\n      this.getList()\n    },\n    // seeDetail(row) {\n    //   this.questionId = row.id\n    //   if(row.status == 0) {\n    //     this.showUpdateForm = true\n    //   }else {\n    //     this.showDetail = true\n    //   }\n    // },\n\n    seeDetail(row, isJiejue) {\n      this.questionId = row.id\n      if(row.status == 0) {\n        this.showUpdateForm = true\n      }else {\n        this.isJiejue = isJiejue\n        this.showDetail = true\n      }\n    },\n\n\n\n    handleEdit(row){\n      // this.isEdit = true\n      this.questionId = row.id\n      this.showUpdateForm = true\n    },\n    async handleOperate(row) {\n      if(row.status == 0) {\n        let createRes = await processCreate({id: row.id})\n      }\n      this.questionId = row.id\n\n      if(this.isRoleAlias){ // 处理人\n        this.showOperate = true\n      }else{ // 提报人\n        questionSubmit({\n          userName: this.userDetail.userName,\n          comment: \"问题提交\",\n          id: row.id\n        }).then(res => {\n          this.submitProcess()\n        })\n      } \n    },\n\n    async handleSolve(row) {\n      this.questionId = row.id\n      this.showSolve = true\n    },\n\n\n    delOrder(row) {\n      this.$confirm('确定删除该问题?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        questionDelete({id: row.id}).then(() => {\n          this.$message({\n            message: '删除成功！',\n            type: 'success'\n          });\n          this.getList()\n        })\n      })\n    },\n   \n    cancel() {\n      this.$emit('backQuestion')\n    },\n    submitProcess() {\n      this.showOperate = false\n      this.showSolve = false\n      this.$message({\n        message: '处理成功！',\n        type: 'success'\n      });\n      this.getList()\n    },\n    typeFormatter(row) {\n      return this.selectDictLabel(this.typeList, row.type)\n    },\n    isResolveFormatter(row){\n      if(row.isResolve == 1){\n        return '已解决'\n      }else{\n        return '未解决'\n      }\n    },\n    backQuestion() {\n      this.showUpdateForm = false\n      this.getList()\n    }\n  }\n}\n",{"version":3,"sources":["questionBook.vue"],"names":[],"mappings":";AAuJA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;;AAGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;;;AAIA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;;AAGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"questionBook.vue","sourceRoot":"src/views/ictOperation/components/questionComponents","sourcesContent":["<template>\n  <div class=\"question_list\">\n    <div class=\"list_title\">\n      <!-- <img src=\"../../img/myquestion.png\" alt=\"\"> -->\n    </div>\n    <!-- <div class=\"back_btn\">\n      <el-button type=\"primary\" size=\"mini\" plain icon=\"el-icon-arrow-left\" @click=\"cancel\">返回</el-button>\n    </div> -->\n    <div class=\"list_content\">\n      <div class=\"list_content_search\">\n        <el-form\n          ref=\"searchForm\"\n          :model=\"searchForm\"\n          label-suffix=\":\"\n          label-width=\"100px\"\n          class=\"xt_search_form xt_search_form3\"\n        >\n          <el-row :gutter=\"6\">\n            <el-col :span=\"6\">\n              <el-form-item label=\"提报单位\" prop=\"deptName\">\n                <xt-tree-lzay-select :formValue=\"searchForm.deptName\"\n                                   :selectType=\"'CORP'\"\n                                   @getTreeItem=\"getEntityUnit\"\n                ></xt-tree-lzay-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-form-item label=\"问题类型\" prop=\"type\">\n                <el-select v-model=\"searchForm.type\" clearable placeholder=\"请选择问题状态\">\n                  <el-option\n                    v-for=\"item in typeList\"\n                    :value=\"item.dictKey\"\n                    :key=\"item.dictKey\"\n                    :label=\"item.dictValue\"\n                  >\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-form-item label=\"处理状态\" prop=\"status\">\n                <el-select v-model=\"searchForm.status\" clearable placeholder=\"请选择问题状态\">\n                  <el-option\n                    v-for=\"item in statusList\"\n                    :value=\"item.dictKey\"\n                    :key=\"item.dictKey\"\n                    :label=\"item.dictValue\"\n                  >\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"6\" style=\"text-align: right;line-height: 38px;\">\n              <el-button type=\"primary\" size=\"small\" @click=\"handleSearch\">查询</el-button>\n              <el-button class=\"border-btn\" size=\"small\" @click=\"handleExport\">导出</el-button>\n              <el-button class=\"border-btn\" size=\"small\" icon=\"el-icon-arrow-left\" @click=\"cancel\">返回</el-button>\n            </el-col>\n          </el-row>\n        </el-form>\n      </div>\n      <!-- <div class=\"list_content_t\">\n        <el-tabs v-model=\"activeName\" @tab-click=\"handleClick\">\n          <el-tab-pane label=\"我的问题\" name=\"0\"></el-tab-pane>\n          <el-tab-pane label=\"待办任务\" name=\"1\" v-if=\"isRoleAlias\"></el-tab-pane>\n          <el-tab-pane label=\"已办任务\" name=\"2\" v-if=\"isRoleAlias\"></el-tab-pane>\n          <el-tab-pane label=\"需求\" name=\"3\" v-if=\"isRoleAlias\"></el-tab-pane>\n          <el-tab-pane label=\"催办列表\" name=\"4\" v-if=\"!isRoleAlias\"></el-tab-pane>\n        </el-tabs>\n\n        <el-button class=\"border-btn\" size=\"small\" @click=\"handleExport\">导出</el-button>\n      </div> -->\n      <div class=\"table_box\" >\n        <el-table\n          ref=\"questionList\"\n          :data=\"questionData\"\n          :height=\"'calc(100% - 35px)'\"\n          border\n          stripe\n          size=\"mini\"\n\n          v-loading=\"tableLoading\"\n        >\n          <el-table-column type=\"index\" label=\"序号\" width=\"50\"></el-table-column>\n          <el-table-column label=\"问题名称\" prop=\"title\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"问题提报人\" prop=\"filler\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"发布时间\" prop=\"createTime\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"问题类型\" prop=\"type\" align=\"center\" show-overflow-tooltip :formatter=\"typeFormatter\"></el-table-column>\n          <el-table-column label=\"处理状态\" prop=\"statusValues\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"处理人\" prop=\"handler\" align=\"center\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"操作\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-button type=\"text\" @click=\"seeDetail(scope.row)\">查看</el-button>\n              <!-- <el-button type=\"text\" @click=\"handleEdit(scope.row)\" v-if=\"activeName == 2\">编辑</el-button> -->\n              <el-button type=\"text\" @click=\"handleOperate(scope.row)\" v-if=\"scope.row.status != 2 && scope.row.view == 1\">处理</el-button>\n              <el-button type=\"text\" v-if=\"scope.row.status == 0 || isRoleAlias\" @click=\"delOrder(scope.row)\">删除</el-button>\n            </template>\n          </el-table-column>\n        </el-table>\n\n        <!-- 分页 -->\n        <pagination\n          :total=\"total\"\n          :page.sync=\"searchForm.current\"\n          :limit.sync=\"searchForm.size\"\n          @pagination=\"getList\"\n        />\n      </div>\n    </div>\n\n    <operateForm\n      v-if=\"showOperate\"\n      :isShow=\"showOperate\"\n      :questionId=\"questionId\"\n      @close=\"showOperate = false\"\n      @submitProcess=\"submitProcess\"\n    />\n\n    <solveForm\n      v-if=\"showSolve\"\n      :isShow=\"showSolve\"\n      :questionId=\"questionId\"\n      @close=\"showSolve = false\"\n      @submitProcess=\"submitProcess\"\n    />\n\n    <questionDetailForm\n      v-if=\"showDetail\"\n      :isShow=\"showDetail\"\n      :questionId=\"questionId\"\n      :isJiejue=\"isJiejue\"\n      @close=\"showDetail = false\"\n      @submitProcess=\"submitProcess\"\n    />\n\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"showUpdateForm\"\n      v-if=\"showUpdateForm\"\n      title=\"问题表单\"\n      width=\"1000px\"\n      v-el-drag-dialog\n      top=\"5vh\"\n    >\n      <questionForm :showType=\"'修改'\" :questionId=\"questionId\" :isYiban=\"activeName==2\" @backQuestion=\"backQuestion\"></questionForm>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport {\n  myQuestionList,\n  questionList,\n  questionDoneList,\n  hasten,\n  listDemand,\n  questionDelete,\n  processCreate,\n  questionSubmit,\n  getNextUser,\n  questionSend\n} from \"@/api/ictOperation/index\"\nimport operateForm from './operateForm'\nimport solveForm from './solveForm'\nimport questionDetailForm from './questionDetailForm'\nimport xtTreeLzaySelect from \"@/components/xtTreeLzaySelect/index.vue\";\nimport { getDictList } from \"@/api/dict\";\nimport questionForm from './questionForm';\nimport {mapGetters,mapState} from \"vuex\";\n\nexport default {\n  components: { operateForm, questionDetailForm, questionForm, solveForm, xtTreeLzaySelect },\n  data() {\n    return{\n      typeList: [],\n      statusList: [\n        {\n          dictKey: '0',\n          dictValue: '已提交'\n        },\n        {\n          dictKey: '1',\n          dictValue: '处理中'\n        },\n        {\n          dictKey: '2',\n          dictValue: '已解决'\n        },\n        {\n          dictKey: '3',\n          dictValue: '纳入需求'\n        },\n      ],\n\n      isEdit: false,\n      isJiejue: false,\n      listApi: myQuestionList,\n      searchForm: {\n        deptId: undefined,\n        deptName: undefined,\n        type: undefined,\n        status: undefined,\n        current: 1,\n        size: 20\n      },\n      questionData: [],\n      total: 0,\n      tableLoading: false,\n      questionId: '',\n      showOperate: false,\n      showSolve: false,\n      showDetail: false,\n      showUpdateForm: false,\n\n    }\n  },\n  computed: {\n    ...mapGetters([\"permission\", \"userDetail\"]),\n    permissionList() {\n      return {\n        questionTodo: this.vaildData(this.permission.question_todo, false),\n        questionDone: this.vaildData(this.permission.question_done, false),\n      };\n    },\n    isRoleAlias(){\n      return this.$store.state.user.userDetail.roleAlias.includes('control_solver')\n    }\n  },\n  mounted() {\n    this.getDict()\n    this.getList()\n  },\n  methods: {\n    getEntityUnit(val) {\n      //选择单位 部门\n      this.searchForm.deptId = val.id\n      this.searchForm.deptName = val.fullName\n      this.$refs.searchForm.$forceUpdate()\n      this.$forceUpdate()\n    },\n    handleSearch(){\n      this.getList()\n    },\n    handleExport() {\n      //导出\n      let types1 = {\n        '0': \"我的问题\",\n        '1': \"待办任务\",\n        '2': \"已办任务\",\n        '3': \"需求\",\n      }\n      let types2 = {\n        '0': \"my\",\n        '1': \"todo\",\n        '2': \"done\",\n        '3': \"demand\",\n      }\n\n      \n      this.$confirm(\"是否导出数据?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(() => {\n        this.download(\n          \"/api/idevelop-control/question/download/exportNew\",\n          this.searchForm,\n          \"全部问题.xlsx\"\n        )\n      });\n      \n    },\n\n    // 字典值\n    getDict() {\n      let dict = ['control_question_type']\n      for(let i=0; i<dict.length; i++) {\n        getDictList(dict[i]).then(res => {\n          if(dict[i] == 'control_question_type') { //问题类型\n            this.typeList = res.data\n          }\n        })\n      }\n    },\n\n    getList() {\n      // this.tableLoading = true\n      // this.listApi(this.searchForm).then(res => {\n      //   this.questionData = res.data.records\n      //   this.total = res.data.total\n      //   this.tableLoading = false\n      // })\n\n      this.tableLoading = true\n      questionList(this.searchForm).then(res => {\n        this.questionData = res.data.records\n        this.total = res.data.total\n        this.tableLoading = false \n      })\n    },\n    handleClick(tabs) {\n      this.listApi = myQuestionList\n      this.getList()\n    },\n    // seeDetail(row) {\n    //   this.questionId = row.id\n    //   if(row.status == 0) {\n    //     this.showUpdateForm = true\n    //   }else {\n    //     this.showDetail = true\n    //   }\n    // },\n\n    seeDetail(row, isJiejue) {\n      this.questionId = row.id\n      if(row.status == 0) {\n        this.showUpdateForm = true\n      }else {\n        this.isJiejue = isJiejue\n        this.showDetail = true\n      }\n    },\n\n\n\n    handleEdit(row){\n      // this.isEdit = true\n      this.questionId = row.id\n      this.showUpdateForm = true\n    },\n    async handleOperate(row) {\n      if(row.status == 0) {\n        let createRes = await processCreate({id: row.id})\n      }\n      this.questionId = row.id\n\n      if(this.isRoleAlias){ // 处理人\n        this.showOperate = true\n      }else{ // 提报人\n        questionSubmit({\n          userName: this.userDetail.userName,\n          comment: \"问题提交\",\n          id: row.id\n        }).then(res => {\n          this.submitProcess()\n        })\n      } \n    },\n\n    async handleSolve(row) {\n      this.questionId = row.id\n      this.showSolve = true\n    },\n\n\n    delOrder(row) {\n      this.$confirm('确定删除该问题?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        questionDelete({id: row.id}).then(() => {\n          this.$message({\n            message: '删除成功！',\n            type: 'success'\n          });\n          this.getList()\n        })\n      })\n    },\n   \n    cancel() {\n      this.$emit('backQuestion')\n    },\n    submitProcess() {\n      this.showOperate = false\n      this.showSolve = false\n      this.$message({\n        message: '处理成功！',\n        type: 'success'\n      });\n      this.getList()\n    },\n    typeFormatter(row) {\n      return this.selectDictLabel(this.typeList, row.type)\n    },\n    isResolveFormatter(row){\n      if(row.isResolve == 1){\n        return '已解决'\n      }else{\n        return '未解决'\n      }\n    },\n    backQuestion() {\n      this.showUpdateForm = false\n      this.getList()\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n::v-deep .xt_search_form3 .el-input__inner {\n    background-color: #FFF;\n    border-color: #DCDFE6;\n}\n\n\n.list_content_t{\n  position: relative;\n}\n.border-btn{\n  // position: absolute;\n  // top: 5px;\n  // right: 2px;\n}\n.question_list{\n  position: relative;\n  height: 50vh;\n  box-shadow: 0 4px 25px 0 #e9f0ff;\n  padding: 0 40px;\n  position: relative;\n  .back_btn{\n    margin-bottom: 15px;\n    position: absolute;\n    top: 0px;\n    left: 40px;\n  }\n  .list_title{\n    text-align: center;\n    margin-bottom: 20px;\n  }\n  .list_content{\n    height: calc(100% - 20px);\n  }\n  .table_box{\n    height: calc(100% - 54px);\n  }\n}\n</style>\n"]}]}