p class=\"table_text\">认证方式：{{ scope.row.is802 }}</p>\n            </div>\n          </template>\n        </el-table-column>\n        <!-- 只有是交换机时展示 -->\n        <el-table-column prop=\"userCard\" label=\"特有信息\" v-if=\"deviceList[0] && deviceList[0].deviceType == '1135308294128009'\">\n          <template slot-scope=\"scope\">\n            <div class=\"tableItem\">\n              <p class=\"table_text\">机房：{{ scope.row.roomName }}</p>\n              <p class=\"table_text\">机柜：{{ scope.row.cabinetsName }}</p>\n              <p class=\"table_text\">设备起始高度(U)：{{ scope.row.deviceStartHeight }}</p>\n              <p class=\"table_text\">设备终止高度(U)：{{ scope.row.deviceEndHeight }}</p>\n              <p class=\"table_text\">SNMP读字符串：{{ scope.row.snmpRead }}</p>\n              <p class=\"table_text\">SNMP写字符串：{{ scope.row.snmpWrite }}</p>\n              <p class=\"table_text\">工作Vlan：{{ scope.row.vlanNumber }}</p>\n              <p class=\"table_text\">用途：{{ scope.row.purpose }}</p>\n            </div>\n          </template>\n        </el-table-column>\n         <!-- v-if=\"deviceList[0] && deviceList[0].deviceCategory == '1097756774301696'\" -->\n         <!-- 认证信息只有网络分类终端设备有 -->\n        <el-table-column prop=\"address\" label=\"认证信息\" width=\"210px\" v-if=\"deviceList[0] && deviceList[0].deviceCategory == '1097756774301696'\">\n          <template slot-scope=\"scope\">\n            <div class=\"tableItem\">\n              <p class=\"table_text\">认证账号：{{ scope.row.authAccount }}</p>\n              <p class=\"table_text\">认证密码：{{ scope.row.authPassword }}</p>\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\" fixed=\"right\" v-if=\"showAudit\">\n          <template slot-scope=\"scope\">\n            <el-button\n              type=\"text\"\n              size=\"small\"\n              icon=\"el-icon-edit\"\n              v-if=\"showAudit\"\n              @click=\"handleDevEdit(scope.row,scope.$index)\"\n            >编辑</el-button>\n            <!-- <el-button\n              type=\"text\"\n              size=\"small\"\n              icon=\"el-icon-edit\"\n              v-if=\"form.oldToNew == '0'\"\n              @click=\"handleOldDev(scope.row,scope.$index)\"\n            >选择旧设备</el-button> -->\n          </template>\n        </el-table-column>\n      </el-table>\n\n\n      <el-row type=\"flex\">\n        <!-- 底部左侧审批记录 开始-->\n        <el-col :span=\"12\">\n          <formTitle :titleText=\"'审批记录'\" :titleType=\"'page_title'\"></formTitle>\n          <div style=\"margin-left: 10px;\">\n            <step\n              :processKey=\"'bpm_sbsqckty'\"\n              :orderId=\"form.id\"\n              v-if=\"form.id\"\n              :stepType=\"true\"\n              :currentSteps=\"form.processStatus\"\n              :orderNo=\"form.operationNo\"\n              :status=\"form.processStatus == 'hussar_12'\"\n              :stepHeight=\"'160px'\"\n              :orderCode=\"form.applyNo\"\n            ></step>\n          </div>\n        </el-col>\n        <!-- 底部右侧操作 开始-->\n        <el-col :span=\"12\">\n          <formTitle :titleText=\"'操作记录'\" :titleType=\"'page_title'\"></formTitle>\n          <el-table\n            ref=\"optTable\"\n            :data=\"optList\"\n            size=\"small\"\n            v-loading=\"loading\"\n          >\n            <el-table-column type=\"index\" label=\"序号\" width=\"50\" align=\"center\"></el-table-column>\n            <el-table-column prop=\"optRole\" label=\"角色\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"optName\" label=\"操作人\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"160\"></el-table-column>\n            <el-table-column prop=\"title\" label=\"操作内容\" ></el-table-column>\n          </el-table>\n        </el-col>\n      </el-row>\n    </el-scrollbar>\n\n    <!-- 底部返回按钮-->\n    <div class=\"audit_box\" v-if=\"showAudit\">\n      <formTitle :titleText=\"'审核信息'\" :titleType=\"'page_title'\"></formTitle>\n      <el-input v-model=\"comment\" type=\"textarea\" :rows=\"3\"></el-input>\n    </div>\n\n    <div class=\"form-btn\">\n       <!-- :loading=\"btnLoading\" -->\n      <el-button v-if=\"showAudit\" type=\"primary\" size=\"small\" @click=\"handleAudited\">审 批</el-button>\n      <el-button class=\"border-btn\" size=\"small\" @click=\"handleReset\">返 回</el-button>\n    </div>\n  </div>\n\n  <!-- 审批弹窗 -->\n  <operateForm\n    v-if=\"showOperate\"\n    :isShow=\"showOperate\"\n    :orderDeatil=\"form\"\n    :orderType=\"'投运工单'\"\n    :processKeys=\"'bpm_sbsqckty'\"\n    @close=\"showOperate = false\"\n    @submitOperate=\"submitOperate\"\n  ></operateForm>\n\n  <!-- 修改设备 -->\n  <devOperationDeviceEdit\n    v-if=\"showDevEdit\"\n    types='editDevice'\n    :isShow.sync=\"showDevEdit\"\n    :deviceSource=\"form.deviceSource\"\n    :operationType=\"form.operationType\"\n    :devItemDetail=\"devItemDetail\"\n    :deviceList=\"deviceList\"\n    @close=\"showDevEdit = false\"\n    @setVal=\"editDeviceHandler\"\n  ></devOperationDeviceEdit>\n\n  <!-- 选择旧设备 -->\n  <devOldList\n    v-if=\"showOldDev\"\n    :isShow.sync=\"showOldDev\"\n    :devItemDetail=\"devItemDetail\"\n    @close=\"showOldDev = false\"\n    @setVal=\"getOldDev\"\n  ></devOldList>\n</basic-container>\n",null]}