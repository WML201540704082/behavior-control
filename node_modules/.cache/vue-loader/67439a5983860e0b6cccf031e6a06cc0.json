{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/safeDanger/networkSecure/components/importDetail.vue?vue&type=style&index=0&id=acc70f80&lang=scss&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/safeDanger/networkSecure/components/importDetail.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n.el-cascader{\n  width: 100%;\n}\n.el-select{\n  width: 100%;\n}\n.el-input{\n  width: 100%;\n}\n.el-date-editor.el-input, .el-date-editor.el-input__inner {\n  width: 100% !important;\n}\n\n::v-deep .el-form-item {\n  margin-bottom: 18px;\n}\n.rowSelect2 .el-select{\n  width: 48.5%;\n}\n\n",{"version":3,"sources":["importDetail.vue"],"names":[],"mappings":";AAmPA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA","file":"importDetail.vue","sourceRoot":"src/views/safeDanger/networkSecure/components","sourcesContent":["<template>\n  <div>\n    <div v-if=\"!isInfo\" style=\"margin-bottom: 10px\">\n      <el-button type=\"primary\" size=\"mini\" style=\"margin-right: 5px;\" icon=\"el-icon-check\" @click=\"submitForm\">保存</el-button>        \n    </div>\n    <div>\n      <el-form :disabled=\"isInfo\" style=\"padding-right: 5px\" :rules=\"rules\"  label-width=\"140px\" ref=\"form\" :model=\"formData\"  :status-icon=\"true\">\n            <el-row>\n             \n              <el-col :span=\"18\">\n                <el-form-item label=\"责任单位:\" prop=\"secondCompany\">\n                    <el-cascader\n                      :disabled=\"Boolean(detailId)\"\n                      size=\"mini\"\n                      v-model=\"formData.secondCompany\"\n                      :options=\"basicUnitSeconds\"\n                      :props=\"defaultProps\"\n                      @change=\"secondCompanyChange\"\n                      style=\"width: 100%\"\n                      placeholder=\"\"\n                      clearable>\n                    </el-cascader>\n                  \n                </el-form-item>\n              </el-col>\n\n    \n            </el-row>\n            <el-row>\n              <el-col :span=\"18\">\n                <el-form-item label=\"责任人:\" prop=\"userIdList\">\n                  <el-select v-model=\"formData.userIdList\" multiple filterable size=\"mini\" placeholder=\"\" :disabled=\"!formData.secondCompany || formData.secondCompany.length == 0\">\n                    <el-option\n                      v-for=\"item in userList\"\n                      :value=\"item.userId\"\n                      :key=\"item.userId\"\n                      :label=\"item.nickName\"\n                    >\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n             \n            </el-row>\n      </el-form>\n    </div>\n\n \n\n\n  </div>\n</template>\n\n<script>\nimport { mapGetters } from 'vuex'\nimport Upload from '@/components/safeDanger/Upload/index'\nimport { orderId, orderAdd, orderUpdate, queryShortNameList, createFlow, backToLastItem, queryNextFlowUsers } from \"@/api/safeDanger/report\"\nimport { securitySupervision } from \"@/api/safeDanger/networkSecure\"\nimport { getAreaTree, selectShoutUser, machineroomuserId, machineRoomUserAdd, machineRoomUserEdit } from \"@/api/safeDanger/networkSecure\"\nimport { updateHidden } from \"@/api/safeDanger/rectificationImport\"\n\nexport default {\n  name: \"networkSecureImportDetail\",\n  components: {Upload},\n  computed: {\n    ...mapGetters([\n      'nickName',\n      'companyId',\n      'companyCode',\n      'userId'\n    ]),\n  },\n  props: {\n    roomId: {\n      type: Number,\n    },\n    detailId: {\n      type: Number,\n    },\n    detailObj: {\n      type: Object\n    },\n    isEdit: {\n      type: Boolean,\n      default: false\n    },\n    isInfo: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      defaultProps: {\n        value: 'code',\n        label: 'shortName',\n        leaf: 'leaf',\n        children: 'children',\n        // checkStrictly: true,\n        // emitPath: false,\n        expandTrigger: 'hover'\n      },\n\n      // 表单参数\n      formData: {\n        secondCompany: undefined,\n        userIdList: [],\n      },\n\n      //校验\n      rules:{\n\n        secondCompany:[{required:true, type: 'array', message:'请选择责任单位', trigger:'change'}],\n        userIdList:[{required:true, message:'请选择责任人', trigger:'change'}],\n\n      },\n      \n\n\n      // 下拉列表\n      basicUnitSeconds: [],\n      userList: [],\n\n    }\n  },\n  created() {\n    this.initData()\n    this.showInfo();\n  },\n  mounted() {\n\n  },\n  methods: {\n    secondCompanyChange(val){\n      this.formData.userIdList = []\n      if(val.length > 0){\n        let code = val[2] || val[1]\n        selectShoutUser({ regionCode: code }).then(res=>{\n          this.userList = res.data\n        })\n      }\n    },\n    // 渲染表格\n    showInfo() {\n      if(this.detailId){\n        machineroomuserId({ networkId: this.roomId, firstCompany: this.detailObj.firstCompany, secondCompany: this.detailObj.secondCompany }).then(res=>{\n          let data = res.data\n          this.formData.secondCompany = [ data.orgCode, data.firstCompany, data.secondCompany ]\n          // this.secondCompanyChange(this.formData.secondCompany)\n          // this.formData.userIdList = data.hiddenOrderUserVOS.map(el=> el.userId)\n          selectShoutUser({ regionCode: data.secondCompany }).then(res=>{\n            this.userList = res.data\n            this.formData.userIdList = data.hiddenOrderUserVOS.map(el=> el.userId)\n          })\n        })\n      }\n    },\n    \n    /** 提交按钮 */\n    submitForm: function() {\n      // this.formData.firstCompany = this.companyCode.slice(0, 4)\n      this.$refs[\"form\"].validate(valid => {\n        if (valid) {\n          let params = {\n            networkId: this.roomId,\n            orgCode: this.formData.secondCompany[0],\n            firstCompany: this.formData.secondCompany[1],\n            secondCompany: this.formData.secondCompany[2],\n            userIdList: this.formData.userIdList\n          }\n\n          if(this.detailId){\n            params.id = this.detailId\n            machineRoomUserEdit(params).then(res=>{\n              this.$message.success(res.msg)\n              this.$emit('closeRoom')\n            })\n          }else{\n            machineRoomUserAdd(params).then(res=>{\n              this.$message.success(res.msg)\n              this.$emit('closeRoom')\n            })\n          }\n\n\n          // let forms = JSON.parse(JSON.stringify(this.formData))\n\n          // updateHidden(forms).then(response => {\n          //   if (response.code === 200) {\n          //     this.$message.success(\"修改成功\");\n          //     this.$emit('closeRoom', response.data)\n          //   } else {\n          //     this.msgError(response.msg);\n          //   }\n          // });\n        }\n      });\n    },\n\n    // 获取下拉列表\n    initData(){\n      getAreaTree({code: '37'}).then(res=>{\n        this.basicUnitSeconds = res.data\n      })\n\n      // setTimeout(() => {\n      //     this.formData.secondCompany = ['05', '0503', '050332']\n      //     console.log(this.formData)\n      // }, 2000);\n    },\n\n\n\n\n\n\n  }\n}\n</script>\n\n<style lang='scss' scoped>\n  .el-cascader{\n    width: 100%;\n  }\n  .el-select{\n    width: 100%;\n  }\n  .el-input{\n    width: 100%;\n  }\n  .el-date-editor.el-input, .el-date-editor.el-input__inner {\n    width: 100% !important;\n  }\n\n  ::v-deep .el-form-item {\n    margin-bottom: 18px;\n  }\n  .rowSelect2 .el-select{\n    width: 48.5%;\n  }\n\n</style>\n"]}]}