       <el-option\n                v-for=\"dict in deviceTypeList\"\n                :key=\"dict.dictKey\"\n                :label=\"dict.dictValue\"\n                :value=\"dict.dictKey\"\n              ></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n\n        <el-col :span=\"6\">\n          <el-form-item label=\"处置状态\" prop=\"disposeStatus\">\n            <el-select\n              v-model=\"searchForm.disposeStatus\"\n              clearable\n              placeholder=\"请选择处置状态\"\n            >\n              <el-option\n                v-for=\"dict in pyStatusList\"\n                :key=\"dict.node\"\n                :label=\"dict.nodeName\"\n                :value=\"dict.node\"\n              ></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n\n        <el-col :span=\"6\">\n          <el-form-item label=\"责任人\" prop=\"receivingPerson\">\n            <el-input\n              v-model=\"searchForm.receivingPerson\"\n              placeholder=\"请输入责任人\"\n            ></el-input>\n          </el-form-item>\n        </el-col>\n\n        <el-col :span=\"6\">\n          <el-form-item label=\"是否信创\" prop=\"isInformation\">\n            <el-select\n              v-model=\"searchForm.isInformation\"\n              clearable\n              placeholder=\"请选择设备状态\"\n            >\n              <el-option\n                v-for=\"dict in dataList\"\n                :key=\"dict.dictKey\"\n                :label=\"dict.dictValue\"\n                :value=\"dict.dictKey\"\n              ></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n      </el-row>\n    </el-form>\n\n    <div class=\"page_body\">\n      <el-row>\n        <formTitle :titleText=\"'列表'\" :titleType=\"'page_title'\">\n          <div slot=\"rightBtnBox\">\n            <el-button\n              type=\"primary\"\n              size=\"small\"\n              icon=\"el-icon-search\"\n              @click=\"handleQuery\"\n            >查询\n            </el-button\n            >\n            <el-button\n              class=\"border-btn\"\n              size=\"small\"\n              icon=\"el-icon-refresh\"\n              @click=\"searchReset\"\n            >重置\n            </el-button\n            >\n          </div>\n        </formTitle>\n      </el-row>\n      <el-table\n        ref=\"deviceTable\"\n        :data=\"deviceList\"\n        v-loading=\"loading\"\n        size=\"small\"\n        height=\"360px\"\n      >\n        <el-table-column\n          type=\"index\"\n          label=\"序号\"\n          width=\"50\"\n          align=\"center\"\n        ></el-table-column>\n        <el-table-column\n          label=\"设备编码\"\n          prop=\"deviceCode\"\n          min-width=\"140\"\n          align=\"center\"\n        >\n        </el-table-column>\n        <el-table-column\n          prop=\"deviceType\"\n          label=\"设备类型\"\n          min-width=\"140\"\n          align=\"center\"\n        >\n          <template slot-scope=\"scope\">\n            <span>{{ showLabel(scope.row.deviceType, deviceTypeList) }}</span>\n          </template>\n        </el-table-column>\n\n        <el-table-column\n          prop=\"receiveDept\"\n          label=\"所在部门\"\n          min-width=\"80\"\n          align=\"center\"\n        >\n        </el-table-column>\n        <el-table-column prop=\"user\" label=\"使用人\" min-width=\"80\" align=\"center\">\n        </el-table-column>\n        <el-table-column\n          prop=\"receivingPerson\"\n          label=\"使用责任人\"\n          min-width=\"100\"\n          align=\"center\"\n        >\n        </el-table-column>\n        <el-table-column\n          prop=\"receivingTel\"\n          label=\"使用责任人联系方式\"\n          min-width=\"160\"\n          align=\"center\"\n        >\n        </el-table-column>\n        <el-table-column prop=\"ip\" label=\"ip地址\" min-width=\"120\" align=\"center\">\n        </el-table-column>\n        <el-table-column prop=\"mac\" label=\"MAC地址\" min-width=\"120\" align=\"center\">\n        </el-table-column>\n        <el-table-column\n          prop=\"installationSite\"\n          label=\"安装位置\"\n          min-width=\"160\"\n          align=\"center\"\n        >\n        </el-table-column>\n        <el-table-column\n          prop=\"disposeResult\"\n          label=\"处置结果\"\n          min-width=\"80\"\n          align=\"center\"\n        >\n          <template slot-scope=\"scope\">\n            <span>{{ showLabel(scope.row.disposeResult, chuzhiList) }}</span>\n          </template>\n        </el-table-column>\n\n        <el-table-column\n          prop=\"disTime\"\n          label=\"处置时间\"\n          min-width=\"80\"\n          align=\"center\"\n        ></el-table-column>\n\n        <el-table-column\n          prop=\"disPerson\"\n          label=\"处置人\"\n          min-width=\"80\"\n          align=\"center\"\n        ></el-table-column>\n\n        <el-table-column label=\"操作\" width=\"100\" align=\"center\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button\n              type=\"text\"\n              class=\"list_btn\"\n              size=\"small\"\n              v-if=\"scope.row.disposeResult =='1' || scope.row.disposeResult =='2'\"\n              @click=\"handleView(scope.row.id,scope.row.disposeStatus)\"\n            >查看\n            </el-button>\n            <el-button\n              type=\"text\"\n              class=\"list_btn\"\n              size=\"small\"\n              v-if=\"scope.row.disposeResult =='0'\"\n              @click=\"handleEdit(scope.row.id,scope.row.filingNo)\"\n            >处置\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <pagination\n        :total=\"total\"\n        :page.sync=\"searchForm.current\"\n        :limit.sync=\"searchForm.size\"\n        @pagination=\"getDeviceList\"\n      />\n    </div>\n\n    <pandian-exception-dialog-vue\n      v-if=\"showDialog\" @clo