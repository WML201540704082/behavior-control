{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/cmdb/components/configFormComponent/configDelForm.vue?vue&type=script&lang=js","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/cmdb/components/configFormComponent/configDelForm.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/babel-loader/lib/index.js","mtime":456789000000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\nimport { deleteConfig } from \"@/api/cmdb/ciConfig\";\n\nexport default {\n  props: ['isShow', \"configId\"],\n  data() {\n    return{\n      description: '',\n      saveLoading: false\n    }\n  },\n  mounted() {},\n  methods: {\n    // 删除并提交\n    delConfig(val) {\n      let form = {\n        id: this.configId,\n        description: this.description,\n        needCommit: val\n      }\n      this.saveLoading = true\n      deleteConfig(form).then(res => {\n        this.$message({\n          type: 'success',\n          message: '保存成功！'\n        });\n        this.saveLoading = false\n        this.$emit('submitDelConfig')\n      }).catch(() => {\n        this.saveLoading = false\n      })\n    },\n   \n  }\n}\n",{"version":3,"sources":["configDelForm.vue"],"names":[],"mappings":";AA4BA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA","file":"configDelForm.vue","sourceRoot":"src/views/cmdb/components/configFormComponent","sourcesContent":["<template>\n  <div>\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"isShow\"\n      title=\"删除确认\"\n      width=\"700px\"\n      top=\"30vh\"\n      v-el-drag-dialog\n    >\n      <div>\n        是否确认删除当前选中配置项？\n      </div>\n      <el-divider></el-divider>\n      <el-input v-model=\"description\" type=\"textarea\" :rows=\"5\"></el-input>\n      <div class=\"submit_btn\">\n        <el-button type=\"danger\" size=\"small\" @click=\"delConfig(true)\" :loading=\"saveLoading\">删 除</el-button>\n        <!-- <el-button type=\"danger\" size=\"small\" @click=\"delConfig(false)\" :loading=\"saveLoading\">删 除</el-button> -->\n        <el-button size=\"small\" @click=\"$emit('close')\">取 消</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { deleteConfig } from \"@/api/cmdb/ciConfig\";\n\nexport default {\n  props: ['isShow', \"configId\"],\n  data() {\n    return{\n      description: '',\n      saveLoading: false\n    }\n  },\n  mounted() {},\n  methods: {\n    // 删除并提交\n    delConfig(val) {\n      let form = {\n        id: this.configId,\n        description: this.description,\n        needCommit: val\n      }\n      this.saveLoading = true\n      deleteConfig(form).then(res => {\n        this.$message({\n          type: 'success',\n          message: '保存成功！'\n        });\n        this.saveLoading = false\n        this.$emit('submitDelConfig')\n      }).catch(() => {\n        this.saveLoading = false\n      })\n    },\n   \n  }\n}\n</script>\n"]}]}