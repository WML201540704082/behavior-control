{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/h3c/tokengenerate.vue?vue&type=style&index=0&id=e2b6c926&lang=scss&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/h3c/tokengenerate.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\ntd{   border: 1px solid; }\n",{"version":3,"sources":["tokengenerate.vue"],"names":[],"mappings":";AA+FA","file":"tokengenerate.vue","sourceRoot":"src/views/h3c","sourcesContent":["<template>\n  <basic-container>\n    1、获取 token /token/generate <br>\n    请求方式：POST<br>\n    参数：{\n    \"userName\" : \"zj\",\n    \"passWord\" : \"\"\n    }<br>\n    响应体：{<br>\n    \"token\": \"xxx\",<br>\n    \"createTime\": \"2020-08-02T08:34:57.454+0000\",<br>\n    \"expire\": null,<br>\n    \"userName\": \"zj\",<br>\n    \"password\": null,<br>\n    \"effectiveTime\": 7200,<br>\n    \"effectiveUrl\": null,<br>\n    \"ucTargetUrl\": null<br>\n    }<br>\n    请求体参数说明：<br>\n    <table>\n      <tr>\n        <td>属性</td>\n        <td>描述</td>\n      </tr>\n      <tr>\n        <td>userName</td>\n        <td>用户名， 必填</td>\n      </tr>\n      <tr>\n        <td>passWord</td> <td>用户密码，必填</td>\n      </tr>\n      <tr>\n        <td>effectiveTime</td>\n        <td>Token 有效期，秒单位（非必填，默认两个小时），</td>\n      </tr>\n      <tr>\n        <td>effectiveUrl</td>\n        <td>\n          指定应用的 api 路由 （非必填，默认空）<br>\n        例如：例如生成 token 时 effectiveUrl 填写/test；<br>\n        http://10.99.223.139:30000/test/api/v1 则校验成功<br>\n        http://10.99.223.139:30000/test1/api/v1 则校验失败。<br>\n        为空则不限制 api 路由\n        </td>\n      </tr>\n    </table>\n    调用生成 Token 接口时，请求头需要增加下面两个参数，否则在在线操作员列表将查不到该登录信息。<br>\n    1）request.setHeader(\"Online\", \"true\");<br>\n    2）request.setHeader(\"X-Forwarded-For\", \"浏览器客户端 ip\");<br>\n\n    <br>\n    5. 目前支持的 token 校验方式<br>\n    （1） url 参数格式 ?token= （适用浏览器单点登录访问，不要用来 API 调用携带）<br>\n    例如： http://10.99.223.139:30000/api/v1?token=<br>\n    （2） 请求头携带 X-Auth-Token<br>\n    （3） Cookie 携带 X-Subject-Token (API 接口调用推荐使用)<br>\n    推荐使用第三种\n  </basic-container>\n</template>\n\n<script>\nimport {mapGetters} from \"vuex\";\nimport request from \"@/router/axios\";\n\nexport default {\n  data() {\n    return {\n      form: {},\n      query: {},\n      loading: true,\n      selectionList: [],\n    }\n  },\n  computed: {\n    ...mapGetters([\"permission\"]),\n  },\n  methods: {\n    onLoad() {\n      this.loading = true;\n      request({\n        url: '/api/idevelop-data/h3c/application/submit',\n        method: 'post',\n        data: {}\n      }).then(res => {\n        const data = res.data;\n        this.page.total = data.total;\n        this.data = data.records;\n        this.loading = false;\n        this.selectionClear();\n      });\n    }\n  }\n};\n</script>\n<style lang=\"scss\" scoped>\ntd{   border: 1px solid; }\n</style>\n"]}]}