{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/cmdb/components/modelManageComponent/modelFom.vue?vue&type=template&id=74fbc2c2&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/cmdb/components/modelManageComponent/modelFom.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/babel-loader/lib/index.js","mtime":456789000000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n  <div>\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      append-to-body\n      :visible.sync=\"isShow\"\n      title=\"添加模型\"\n      width=\"700px\"\n      top=\"10vh\"\n      v-el-drag-dialog\n    >\n      <scrollbarBox>\n        <el-form\n          ref=\"submitForm\"\n          :model=\"submitForm\"\n          :rules=\"rules\"\n          size=\"small\"\n          label-suffix=\":\"\n          label-width=\"100px\"\n          style=\"padding-right:20px\"\n        >\n          <el-form-item label=\"图标\" prop=\"icon\">\n            <div class=\"icon_box text_primary\" @click=\"selectIcon\">\n              <i :class=\"submitForm.icon\"></i>\n            </div>\n          </el-form-item>\n          <el-form-item label=\"模型层级\" prop=\"typeId\">\n            <el-select v-model=\"submitForm.typeId\" @change=\"changeCitype\">\n              <el-option\n                v-for=\"(item, index) in ciTypeList\"\n                :key=\"index\"\n                :label=\"item.name\"\n                :value=\"item.id\"\n              ></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item label=\"唯一标识\" prop=\"name\" :rules=\"$formRules.common.nameCheck\">\n            <el-input v-model=\"submitForm.name\" :disabled=\"showType =='修改'\"></el-input>\n            <div class=\"form-tips text-tips\">保存后不可修改</div>\n          </el-form-item>\n          <el-form-item label=\"名称\" prop=\"label\">\n            <el-input v-model=\"submitForm.label\"></el-input>\n          </el-form-item>\n          <el-form-item label=\"虚拟模型\" prop=\"isVirtual\" v-if=\"showType =='新增'\">\n            <el-switch \n              v-model=\"submitForm.isVirtual\" \n              active-color=\"#13ce66\" \n              inactive-color=\"#ff4949\"\n              :active-value=\"1\"\n              :inactive-value=\"0\"\n            ></el-switch>\n          </el-form-item>\n          <el-form-item label=\"配置\" v-if=\"submitForm.isVirtual === 1\">\n            <el-popover\n              placement=\"right\"\n              width=\"500\"\n              trigger=\"hover\"\n              >\n              <div>\n                <pre>\n&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n&lt;ci&gt;\n  &lt;!--模型属性定义，需要SQL语句返回对应列--&gt;\n  &lt;attrs&gt;\n    &lt;attr name=\"user_id\" label=\"用户id\"/&gt;\n    &lt;attr name=\"user_name\" label=\"用户名\"/&gt;\n    &lt;attr name=\"teamName\" label=\"分组\"/&gt;\n  &lt;/attrs&gt;\n  &lt;sql&gt;\n    SELECT\n    &lt;!--必须包含id字段，作为配置项主键--&gt;\n    `u`.`id` AS id,\n    &lt;!--必须包含uuid字段，数据类型是char(32)，作为配置项全局主键--&gt;\n    md5(`u`.`id`) AS uuid,\n    &lt;!--必须包含name字段，作为配置项名称--&gt;\n    `u`.`user_name` AS name,\n    &lt;!--属性列需要在上面attrs中定义才生效--&gt;\n    `u`.`user_id` as user_id,\n    `u`.`user_name` as user_name,\n    group_concat( `t`.`name`) AS teamName\n    FROM\n    `user` `u`\n    LEFT JOIN `user_team` `ut` \n    ON `u`.`uuid` = `ut`.`user_uuid`\n    LEFT JOIN `team` `t` \n    ON `t`.`uuid` = `ut`.`team_uuid`\n    GROUP BY u.uuid\n  &lt;/sql&gt;\n&lt;/ci&gt;\n                </pre>\n              </div>\n              <span slot=\"reference\" class=\"text_primary\" style=\"cursor: pointer;\">查看范例</span>\n            </el-popover>\n            <codemirror\n              v-model=\"viewXml\"\n              codeMode=\"xml\"\n            ></codemirror>\n          </el-form-item>\n          <el-form-item label=\"继承\" prop=\"parentCiId\" v-if=\"submitForm.isVirtual === 0\">\n            <el-select v-model=\"submitForm.parentCiId\" @change=\"changeParentCi\" clearable>\n              <el-option\n                v-for=\"(item, index) in ciInheritList\"\n                :key=\"index\"\n                :label=\"item.text\"\n                :value=\"item.value\"\n              ></el-option>\n            </el-select>\n            <div class=\"form-tips text-tips\">被继承模型只能是抽象模型</div>\n          </el-form-item>\n          <el-form-item label=\"抽象模型\" prop=\"isAbstract\" v-if=\"submitForm.isVirtual === 0\">\n            <el-switch \n              v-model=\"submitForm.isAbstract\" \n              active-color=\"#13ce66\" \n              inactive-color=\"#ff4949\"\n              :active-value=\"1\"\n              :inactive-value=\"0\"\n            ></el-switch>\n            <div class=\"form-tips text-tips\">抽象模型可以被继承，但不能添加配置项</div>\n          </el-form-item>\n          <el-form-item label=\"关键模型\" prop=\"isMenu\">\n            <el-switch \n              v-model=\"submitForm.isMenu\" \n              active-color=\"#13ce66\" \n              inactive-color=\"#ff4949\"\n              :active-value=\"1\"\n              :inactive-value=\"0\"\n            ></el-switch>\n            <div class=\"form-tips text-tips\">关键模型会显示在最左侧菜单中</div>\n          </el-form-item>\n          <el-form-item label=\"有效日期\" prop=\"expiredDay\" v-if=\"submitForm.isVirtual === 0\">\n            <el-input type=\"number\" v-model=\"submitForm.expiredDay\" :min=\"0\"></el-input>\n            <div class=\"form-tips text-tips\">单位是天，有效日期为零代表永不过期</div>\n          </el-form-item>\n          <el-form-item label=\"描述\" prop=\"description\">\n            <el-input v-model=\"submitForm.description\" type=\"textarea\" :rows=\"5\"></el-input>\n          </el-form-item>\n        </el-form>\n      </scrollbarBox>\n      \n      <div class=\"submit_btn\">\n        <el-button type=\"primary\" size=\"small\" @click=\"save\">保 存</el-button>\n        <el-button size=\"small\" @click=\"$emit('close')\">取 消</el-button>\n      </div>\n    </el-dialog>\n\n    <iconList\n      v-if=\"showIcon\"\n      :selectIcon=\"submitForm.icon\"\n      :isShow=\"showIcon\"\n      @close=\"showIcon = false\"\n      @submitIcon=\"setIcon\"\n    ></iconList>\n  </div>\n",null]}