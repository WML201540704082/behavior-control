,239,0) 0%, #D9FFE4 100%);\n        border-radius: 4px;\n        display: flex;\n        align-items: center;\n        \n        img{\n          // width: 18px;\n          // height: 18px;\n          margin: 0 10px;\n        }\n      }\n      .ledger_iteml2{\n        background: linear-gradient(270deg, rgba(255,255,255,0) 0%, #FDFADB 100%);\n      }\n      .ledger_itemr{\n        span{\n          color: #192C7D;\n          font-size: 24px;\n          font-weight: 600;\n          margin: 0 10px 0 15px;\n        }\n      }\n    }\n  }\n\n</style>"]}]}