return '新 增';\n      } else if (type == 'edit') {\n        return '更 新';\n      }\n      return null;\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.d_end button {\n  width: 100px;\n}\n</style>\n"]}]}