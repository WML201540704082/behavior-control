bleLoading = false\n      }).catch(() => {\n        this.tableLoading = false\n      })\n    },\n    // 删除\n    delItem(row) {\n      this.$confirm('确定删除该全局属性?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        validatorDel({id: row.id}).then(res => {\n          this.$message({\n            type: 'success',\n            message: '删除成功！'\n          });\n          this.getList()\n        })\n      })\n    },\n    // 编辑\n    editItem(row) {\n      this.showType = '修改'\n      this.itemId = row.id\n      this.showForm = true\n    },\n    saveValidator() {\n      this.showForm = false\n      this.getList()\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n\n</style>\n"]}]}