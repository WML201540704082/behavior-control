play: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      margin: 10px;\n      .title{\n        font-size: 14px;\n      }\n      .num{\n        color: #409EFF;\n        font-size: 20px;\n        font-weight: 500;\n      }\n    }\n\n  }\n}\n</style>\n"]}]}