          message: \"操作成功!\"\n            });\n            this.handleReset();\n          }\n        })\n      },\n      handleReset() {\n        //返回\n        this.$closePage('/terminal/userManagement/index');\n      },\n      beforeOpen() {\n        getEmpty().then(res => {\n          this.form = res.data;\n          this.form.id = null;\n          this.$forceUpdate()\n        });\n      },\n      loadDetail(id) {\n        getUserDetail(id).then(res => {\n          this.form = res.data\n          console.log('this.form',this.form)\n          this.form.timeList = [res.data.loginBeginTime,res.data.loginEndTime]\n          this.form.status = res.data.status == 1 ? '在线' : '离线'\n          this.$refs.dataForm.$forceUpdate()\n          this.$forceUpdate()\n        });\n      },\n    }\n  };\n  </script>\n  \n  "]}]}