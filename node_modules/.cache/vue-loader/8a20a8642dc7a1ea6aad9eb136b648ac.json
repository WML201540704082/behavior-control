{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/page/index/top/top-help.vue?vue&type=style&index=0&id=01ed6407&lang=scss&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/page/index/top/top-help.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.d_file {\n  padding: 0px 12px 12px 12px;\n\n}\n\n.a_fname {\n  font-size: 14px;\n  color: #0D8EFF;\n}\n\n.d_wd {\n  height: 50vh;\n  overflow-y: auto;\n  position: relative;\n}\n.d_empty{\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n",{"version":3,"sources":["top-help.vue"],"names":[],"mappings":";AA4FA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"top-help.vue","sourceRoot":"src/page/index/top","sourcesContent":["<template>\n  <el-dialog\n    :close-on-click-modal=\"false\"\n    :before-close=\"() => $emit('close')\"\n    :show-close=\"true\"\n    append-to-body\n    :visible.sync=\"showHeper\"\n    title=\"帮助文档\"\n    width=\"800px\"\n    v-el-drag-dialog>\n    <div v-loading=\"loading\" class=\"d_wd\">\n      <div v-for=\"(item,index) in files\" :key=\"item.uploadFileName\" class=\"d_file\">\n        <img/>\n        <!--        :href=\"item.fileUrl\"-->\n        <a class=\"a_fname\" @click=\"aDowload(item)\">{{ item.uploadFileName }}{{ getFileType(item.fileUrl) }}</a>\n      </div>\n\n      <div v-if=\"files&&files.length==0\" class=\"d_empty\">\n        <span>暂无数据</span>\n      </div>\n    </div>\n\n    <div class=\"form-btn d_end\">\n      <el-button type=\"danger\" plain @click=\"$emit('close')\">关 闭</el-button>\n    </div>\n  </el-dialog>\n</template>\n\n<script>\nimport {getList} from '@/api/data/uploadfiles'\nimport {mapGetters} from \"vuex\";\n\nexport default {\n  props: ['showHeper'],\n  components: {},\n  data() {\n    return {\n      files: null,\n      loading: false,\n    };\n  },\n  computed: {\n    ...mapGetters([\"lockPasswd\"])\n  },\n  mounted() {\n    this.loading = true;\n    getList().then(res => {\n      this.loading = false;\n      this.files = res.data.records;\n    }).catch(err => {\n      this.loading = false;\n    })\n  },\n\n  methods: {\n    aDowload(item) {\n      const x = new window.XMLHttpRequest();\n      const url = item.fileUrl;\n      const fileName = item.uploadFileName;\n      x.open('GET', url, true);\n      x.responseType = 'blob';\n      x.onload = () => {\n        const url2 = window.URL.createObjectURL(x.response);\n        const a = document.createElement('a');\n        a.href = url2;\n        a.download = fileName;\n        a.click();\n\n        a.style.display = 'none';\n        const timer = setTimeout(() => {\n          a.remove();\n\n          //释放blob对象\n          URL.revokeObjectURL(url2);\n          clearTimeout(timer);\n        }, 1000)\n\n      };\n      x.send();\n    },\n    getFileType(url) {\n      if (url && url.lastIndexOf('.') != -1) {\n        return `${url.substr(url.lastIndexOf('.'))}`;\n      }\n      return null;\n    }\n  },\n\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.d_file {\n  padding: 0px 12px 12px 12px;\n\n}\n\n.a_fname {\n  font-size: 14px;\n  color: #0D8EFF;\n}\n\n.d_wd {\n  height: 50vh;\n  overflow-y: auto;\n  position: relative;\n}\n.d_empty{\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n</style>\n"]}]}