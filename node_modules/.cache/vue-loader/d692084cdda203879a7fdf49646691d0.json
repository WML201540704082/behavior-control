{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/device/components/capitalTransfer/uploadModel.vue?vue&type=style&index=0&id=5bd5bfc2&lang=scss&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/device/components/capitalTransfer/uploadModel.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n::v-deep .import-dialog{\n  .el-dialog__body{\n    text-align: center;\n  }\n}\n\n.icon_item{\n  text-align: center;\n}\n",{"version":3,"sources":["uploadModel.vue"],"names":[],"mappings":";AA6GA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA","file":"uploadModel.vue","sourceRoot":"src/views/device/components/capitalTransfer","sourcesContent":["<template>\n  <div>\n    <!-- 导入对话框 -->\n    <el-dialog :modal-append-to-body=\"false\" :title=\"title\" :visible.sync=\"isVisible\" width=\"600px\"  class=\"import-dialog\">\n      <el-upload\n        ref=\"upload\"\n        :limit=\"1\"\n        accept=\".xlsx,.xls\"\n        name=\"file\"\n        :headers=\"headers\"\n        :data='datas'\n        :action=\"url\"\n        :disabled=\"isUploading\"\n        :http-request=\"uploadFile2\"\n        :on-progress=\"handleFileUploadProgress\"\n        :on-success=\"handleSuccess\"\n        :before-upload=\"beforeUpload\"\n        :auto-upload=\"false\"\n        drag\n      >\n        <i class=\"el-icon-upload\"></i>\n        <div class=\"el-upload__text\">\n          将文件拖到此处，或\n          <em>点击上传</em>\n        </div>\n        <div class=\"el-upload__tip\" slot=\"tip\">根据模板填入信息后，导入文件进行上传。支持格式：xls、xlsx</div>\n      </el-upload>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button type=\"primary\" @click=\"submitFileForm\">确 定</el-button>\n        <el-button @click=\"isVisible = false\">取 消</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { transferImport } from \"@/api/device/devicetransfer\";\nimport website from '@/config/website';\nimport {Base64} from 'js-base64';\nimport {getToken} from '@/util/auth'\nexport default {\n  props: ['isShow', 'selectIcon'],\n  data() {\n    return{\n      // isVisible: false,\n      title: '请导入数据文件',\n      headers: {\n        Authorization: `Basic ${Base64.encode(`${website.clientId}:${website.clientSecret}`)}`,\n        'Idevelop-Auth': 'bearer ' + getToken()\n      },\n      datas: {},\n      url: '#', // /api/idevelop-device/device/transfer/import\n      isUploading: false,\n      fileList: [],\n      activeIcon: ''\n    }\n  },\n  computed: {\n    isVisible: {\n      get(){\n        return this.isShow\n      },\n      set(val){\n        this.$emit(\"update:isShow\", val)\n      }\n    }\n  },\n  methods: {\n    uploadFile2( params ){\n      const file = params.file\n\n      const formData = new FormData()\n      formData.append(\"file\", file)\n\n      transferImport(formData).then(res=>{\n        params.onSuccess(res)\n      }).catch(error=>{\n        params.onError(error)\n      })\n    },\n    // 提交上传文件\n    submitFileForm() {\n      this.$refs.upload.submit()\n    },\n    handleSuccess(res){\n      this.$emit('setVal', res.data)\n      this.isVisible = false\n    },\n    // eslint-disable-next-line no-unused-vars\n    handlePreview(file){\n      //console.log(file)\n    },\n    // eslint-disable-next-line no-unused-vars\n    handleRemove(file, fileList){\n      //console.log(file, fileList)\n    },\n    // eslint-disable-next-line no-unused-vars\n    beforeRemove(file, fileList){\n      return this.$confirm(`确定移除 ${ file.name }`)\n    },\n    // eslint-disable-next-line no-unused-vars\n    handleExceed(file, fileList){\n      // this.$message.warning('')\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n::v-deep .import-dialog{\n  .el-dialog__body{\n    text-align: center;\n  }\n}\n\n.icon_item{\n  text-align: center;\n}\n</style>\n"]}]}