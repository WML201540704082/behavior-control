div>\n      <div class=\"search_list\" v-if=\"searchContentList.length>0\">\n        <div\n          class=\"search_list_item\"\n          v-for=\"(item, index) in searchContentList\"\n          :key=\"index\"\n        >\n          <img src=\"../img/searchIcon.png\" alt=\"\" class=\"search_icon\">\n          <div class=\"title\">{{item.problem}}</div>\n          <div class=\"content\">{{item.answer}}</div>\n          <div class=\"btnn\">\n            <template>\n              <el-button type=\"primary\" size=\"mini\" @click=\"handlelCollect(item)\" v-if=\"item.collectFlag=='未收藏'\">收藏</el-button>\n              <el-tag type=\"success\" v-else> 已收藏 </el-tag>\n            </template>\n            <template>\n              <el-button type=\"primary\" size=\"mini\" @click=\"handlelStudy(item)\" v-if=\"item.learnFlag=='未学习'\" style=\"margin-left: 10px\">学习</el-button>\n              <el-tag type=\"success\" v-else style=\"margin-left: 10px\">已学习</el-tag>\n            </template>\n\n          </div>\n\n        </div>\n      </div>\n      <div v-else class=\"search_empty\">\n        <div class=\"search_emptyc\">\n          <div class=\"search_emptycl\">\n            <div class=\"search_emptyct\">最新知识 ></div>\n            <div class=\"search_emptycc\" v-loading=\"newLoading\">\n              <div\n                class=\"search_emptyc_item\"\n                v-for=\"(item, index) in newList\"\n                :key=\"index\"\n                @click=\"handleClick(item.problem)\">\n                <span :class=\"'col'+index\">{{ index+1 }}</span>\n                {{ item.problem }}\n              </div>\n            </div>\n          </div>\n          <div class=\"search_emptycr\">\n            <div class=\"search_emptyct\">\n              知识热搜 >\n              <el-radio-group v-model=\"month\" @change=\"handleChange\" size=\"mini\" style=\"width: auto;\">\n                <el-radio-button :label=\"1\">日</el-radio-button>\n                <el-radio-button :label=\"2\">周</el-radio-button>\n                <el-radio-button :label=\"3\">月</el-radio-button>\n              </el-radio-group>\n            </div>\n            <div class=\"search_emptycc\" v-loading=\"logLoading\">\n              <div\n                class=\"search_emptyc_item\"\n                v-for=\"(item, index) in logList\"\n                :key=\"index\"\n                @click=\"handleClick(item.problem)\">\n                <span :class=\"'col'+index\">{{ index+1 }}</span>\n                {{ item.problem }}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- <div v-else class=\"search_empty\" style=\"color:#909399\">\n        {{ searchText==''||!isSearch? '请输入您的问题...':'暂无回答'}}\n      </div> -->\n    </div>\n\n    <!-- 上传问题弹窗 -->\n    <uploadQuestion\n      v-if=\"showUpload\"\n      :isShow=\"showUpload\"\n      @close=\"showUpload = false\"\n    ></uploadQuestion>\n    <!-- 新建知识弹窗 -->\n    <addKnowledge\n      v-if=\"showUpload2\"\n      :isShow=\"showUpload2\"\n      @close=\"showUpload2 = false\"\n    ></addKnowledge>\n    <!-- 我的知识弹窗 -->\n    <myKnowledge\n      v-if=\"showUpload3\"\n      :isShow=\"showUpload3\"\n      @close=\"showUpload3 = false\"\n    ></myKnowledge>\n  </div>\n\n\n  <div class=\"intelligenceAnswer\" v-else>\n    <iframe\n      src=\"http://25.41.75.98:32360/chatbot/yOvZPTTLjsTFtEzS\"\n      style=\"width: 100%; height: 100%; min-height: 700px\"\n      allow=\"microphone\">\n    </iframe>\n  </div>\n</div>\n",null]}