{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/data/components/i6000/i6000Unit.vue?vue&type=style&index=0&id=7b9dd986&scoped=true&lang=scss","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/data/components/i6000/i6000Unit.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n.d_stext {\n  padding: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.d_stext span {\n  font-size: 14px;\n  color: #666666;\n}\n\n.d_sb {\n  display: flex;\n  justify-content: space-between;\n}\n\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n",{"version":3,"sources":["i6000Unit.vue"],"names":[],"mappings":";AA+MA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"i6000Unit.vue","sourceRoot":"src/views/data/components/i6000","sourcesContent":["<template>\n  <div class=\"xt-layout page_body\">\n    <div class=\"xt-layout-content\" style=\"height: 84vh; padding: 0px 0px 0px 20px;overflow: hidden\">\n      <el-form :model=\"queryParams\" label-suffix=\":\" label-width=\"120px\" size=\"small\">\n        <el-row :gutter=\"12\">\n<!--          <el-col :span=\"6\">-->\n<!--            <el-form-item label=\"i6000单位ID\">-->\n<!--              <el-input v-model=\"queryParams.i6000DeptId\" placeholder=\"请输入i6000单位ID\" clearable></el-input>-->\n<!--            </el-form-item>-->\n<!--          </el-col>-->\n          <el-col :span=\"6\">\n            <el-form-item label=\"i6000单位名称\">\n              <el-input v-model=\"queryParams.i6000DeptName\" placeholder=\"请输入i6000单位名称\" clearable></el-input>\n            </el-form-item>\n          </el-col>\n<!--          <el-col :span=\"6\">-->\n<!--            <el-form-item label=\"i6000单位ID\">-->\n<!--              <el-input v-model=\"queryParams.i6000UnitId\" placeholder=\"请输入i6000单位ID\" clearable></el-input>-->\n<!--            </el-form-item>-->\n<!--          </el-col>-->\n          <!--          <el-col :span=\"6\">-->\n          <!--            <el-form-item label=\"模型英文名\">-->\n          <!--              <el-input v-model=\"queryParams.ciName\" placeholder=\"请输入模型英文名\" clearable></el-input>-->\n          <!--            </el-form-item>-->\n          <!--          </el-col>-->\n\n          <el-col :span=\"18\" class=\"d_end\">\n            <div>\n              <el-button type=\"primary\" plain size=\"small\" @click=\"getList\">查 询</el-button>\n              <el-button type=\"info\" plain size=\"small\" @click=\"reset\">重 置</el-button>\n              <!--              <el-button type=\"success\" plain size=\"small\" @click=\"handelAdd()\">新 增</el-button>-->\n              <el-button type=\"danger\" plain size=\"small\" @click=\"handelDelete(null)\">删 除</el-button>\n              <el-button type=\"success\" icon=\"el-icon-refresh\" plain size=\"small\" @click=\"handelUpdate(null)\" :loading=\"upLoading\">更新数据</el-button>\n<!--              <el-button type=\"success\" icon=\"el-icon-refresh\" plain size=\"small\" @click=\"handelSync(null)\" :loading=\"tbLoading\">同 步</el-button>-->\n            </div>\n          </el-col>\n        </el-row>\n      </el-form>\n      <!-- 设备列表 -->\n      <el-table ref=\"table\" :data=\"tableData\" stripe border size=\"small\" height=\"68vh\" v-loading=\"tableloading\">\n        <el-table-column type=\"selection\" header-align=\"center\" align=\"center\" width=\"50\"></el-table-column>\n        <el-table-column width=\"50\" type=\"index\" :index=\"Nindex\" label=\"序号\" align=\"center\"></el-table-column>\n        <el-table-column label=\"i6000单位ID\" prop=\"i6000UnitId\" show-overflow-tooltip align=\"center\"></el-table-column>\n        <el-table-column label=\"i6000单位名称\" prop=\"i6000UnitName\" show-overflow-tooltip align=\"center\"></el-table-column>\n        <el-table-column label=\"i6000单位ID\" prop=\"i6000UnitId\" s show-overflow-tooltip align=\"center\"></el-table-column>\n        <el-table-column label=\"更新时间\" prop=\"updateTime\" sortable s show-overflow-tooltip align=\"center\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\">\n          <template slot-scope=\"scope\">\n<!--            <el-button type=\"text\" size=\"small\" icon=\"el-icon-edit\" @click=\"handleEdit(scope.row)\">编辑</el-button>-->\n            <el-button type=\"text\" size=\"small\" icon=\"el-icon-delete\" @click=\"handelDelete(scope.row.i6000DeptId)\" style=\"color: red;\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <!-- 分页 -->\n      <pagination :total=\"page.total\" :page.sync=\"page.currentPage\" :limit.sync=\"page.pageSize\" @pagination=\"getList\"/>\n    </div>\n    <unit-dept-add-edit v-if=\"showAddEdit\"\n                        :isShow=\"showAddEdit\"\n                        :fromValue=\"fromValue\"\n                        :type=\"type\"\n                        @refreshData=\"getList\"\n                        @close=\"showAddEdit = false\">\n    </unit-dept-add-edit>\n  </div>\n</template>\n\n<script>\n\nimport {getList, remove, up,sync} from \"@/api/i6000/unit\";\nimport UnitDeptAddEdit from \"./components/unitDept/addedit.vue\";\n//成本中心页面\nexport default {\n  name: 'i6000Unit',\n  components: {UnitDeptAddEdit},\n  data() {\n    return {\n      tableloading: false,\n      queryParams: {},\n      page: {\n        currentPage: 1,\n        pageSize: 20,\n        total: 0,\n      },\n      tableData: null,\n\n      showAddEdit: false,\n      fromValue: null,\n      type: null,\n\n      upLoading:false,\n      tbLoading: false,\n    }\n  },\n  mounted() {\n    this.page = {currentPage: 1, pageSize: 20, total: 0};\n    this.getList();\n  },\n  methods: {\n    getList() {\n      this.tableloading = true;\n      getList(this.page.currentPage, this.page.pageSize, this.queryParams).then(res => {\n        const data = res.data;\n        this.page.total = data.total;\n        this.tableData = data.records;\n        this.tableloading = false;\n      });\n    },\n    handelAdd() {\n      this.type = 'add';\n      this.showAddEdit = true;\n    },\n    handleEdit(row) {\n      this.type = 'edit';\n      this.showAddEdit = true;\n      this.fromValue = row;\n    },\n    handelUpdate(){\n      this.upLoading = true;\n      up().then(res => {\n        this.$message.success('更新成功');\n      }).finally(() => {\n        this.upLoading = false;\n      });\n    },\n    //手动同步按钮\n    handelSync() {\n      this.tbLoading = true;\n      sync().then(res => {\n        this.$message.success('请求成功');\n      }).finally(() => {\n        this.tbLoading = false;\n      });\n    },\n    handelDelete(id) {\n      if (id) {\n        this.$confirm(\"确定将选择数据删除?\", {\n          confirmButtonText: \"确定\",\n          cancelButtonText: \"取消\",\n          type: \"warning\"\n        }).then(() => {\n          return remove(id);\n        }).then(() => {\n          this.getList();\n          this.$message({\n            type: \"success\",\n            message: \"删除成功!\"\n          });\n        });\n      } else {\n        if (this.$refs.table.selection.length === 0) {\n          this.$message.warning(\"请选择至少一条数据\");\n          return;\n        }\n        this.$confirm(\"确定将选择数据删除?\", {\n          confirmButtonText: \"确定\",\n          cancelButtonText: \"取消\",\n          type: \"warning\"\n        }).then(() => {\n          let ids = this.$refs.table.selection.map((item, index) => {\n            return item.i6000DeptId\n          }).join(',');\n          return remove(ids);\n        }).then(() => {\n          this.getList();\n          this.$message({\n            type: \"success\",\n            message: \"操作成功!\"\n          });\n        });\n      }\n    },\n    Nindex(index) {\n      return index + 1 + (this.page.currentPage - 1) * this.page.pageSize;\n    },\n    reset() {\n      this.queryParams = {};\n      this.page = {currentPage: 1, pageSize: 20, total: 0,};\n      this.getList();\n    },\n    getTypeColor(type) {\n      if (type == '0') {\n        return '#209141';\n      } else if (type == '1') {\n        return '#4390F2';\n      } else if (type == '2') {\n        return '#000000';\n      } else if (type == '3') {\n        return '#000000';\n      }\n      return '#000000';\n    },\n    getTypeName(type) {\n      if (type == '0') {\n        return '属性';\n      } else if (type == '1') {\n        return '配置项';\n      } else if (type == '2') {\n        return '模型';\n      } else if (type == '3') {\n        return '字典模型';\n      }\n    },\n  },\n}\n</script>\n<style scoped lang=\"scss\">\n.d_stext {\n  padding: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.d_stext span {\n  font-size: 14px;\n  color: #666666;\n}\n\n.d_sb {\n  display: flex;\n  justify-content: space-between;\n}\n\n.d_end {\n  display: flex;\n  justify-content: flex-end;\n}\n</style>\n"]}]}