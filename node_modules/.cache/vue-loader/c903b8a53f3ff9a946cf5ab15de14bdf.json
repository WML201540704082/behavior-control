{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/endpoint/components/tree/arrtMapping.vue?vue&type=style&index=0&id=48df4123&lang=scss&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/endpoint/components/tree/arrtMapping.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n::v-deep .el-col-8 {\n  height: 40px;\n}\n\n.search_btn {\n  margin-bottom: 15px\n}\n",{"version":3,"sources":["arrtMapping.vue"],"names":[],"mappings":";AAkJA;AACA;AACA;;AAEA;AACA;AACA","file":"arrtMapping.vue","sourceRoot":"src/views/endpoint/components/tree","sourcesContent":["<template>\n  <div>\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      :append-to-body=\"false\"\n      :visible.sync=\"isShow\"\n      :title=\"'['+ ciLabel +'] 属性映射'\"\n      width=\"1200px\"\n      v-el-drag-dialog\n    >\n      <el-form\n        :model=\"searchForm\"\n        ref=\"searchForm\"\n        label-suffix=\":\"\n        label-width=\"100px\"\n        size=\"small\"\n      >\n        <el-row>\n          <el-col :span=\"8\">\n            <el-form-item label=\"模型ID\" prop=\"ciId\">\n              <el-input v-model=\"searchForm.ciId\" disabled=\"false\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"属性英文名\" prop=\"attrName\">\n              <el-input v-model=\"searchForm.attrName\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"属性中文名\" prop=\"attrLabel\">\n              <el-input v-model=\"searchForm.attrLabel\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <div class=\"search_btn\">\n          <el-button type=\"primary\" size=\"small\" @click=\"search\">查 询</el-button>\n          <el-button size=\"small\" @click=\"restForm\">重 置</el-button>\n          <el-button size=\"small\" icon=\"el-icon-refresh\" @click=\"refresh\">刷 新</el-button>\n        </div>\n      </el-form>\n\n      <div class=\"table_box\">\n        <el-table\n          ref=\"table\"\n          :data=\"tableList\"\n          stripe\n          border\n          size=\"small\"\n          :height=\"tableHeight\"\n          v-loading=\"tableLoading\"\n        >\n          <el-table-column width=\"50\" type=\"index\" :index=\"Nindex\" label=\"序号\" align=\"center\"></el-table-column>\n          <el-table-column label=\"模型-属性\" align=\"center\" prop=\"attrCiId\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"属性ID\" align=\"center\" prop=\"attrId\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"属性英文名\" align=\"center\" prop=\"attrName\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"属性中文名\" align=\"center\" prop=\"attrLabel\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"属性类型编码\" align=\"center\" prop=\"attrType\" show-overflow-tooltip></el-table-column>\n          <el-table-column label=\"属性类型\" align=\"center\" prop=\"attrTypeText\" show-overflow-tooltip></el-table-column>\n        </el-table>\n        <pagination\n          :total=\"total\"\n          :page.sync=\"searchForm.current\"\n          :limit.sync=\"searchForm.size\"\n          @pagination=\"getTableList\"\n        />\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\n  import {getList, refreshCiAttr} from '@/api/device/cmdbciattr'\n\n  export default {\n    props: [\"isShow\", \"ciId\", \"ciName\", \"ciLabel\"],\n    data() {\n      return {\n        searchForm: {\n          size: 20,\n          current: 1\n        },\n        tableList: [],\n        tableHeight: \"500px\",\n        tableLoading: false,\n        total: 0,\n      }\n    },\n    mounted() {\n      this.searchForm.ciId = this.ciId\n      this.getTableList()\n    },\n    methods: {\n      getTableList() {\n        this.tableLoading = true\n        getList(this.searchForm).then(res => {\n          this.tableList = res.data.records\n          this.total = res.data.total\n          this.tableLoading = false\n        }).catch(() => {\n          this.tableLoading = false\n        })\n      },\n      search() {\n        this.searchForm.current = 1\n        this.getTableList()\n      },\n      restForm() {\n        this.searchForm = {\n          size: 20,\n          current: 1,\n          ciId: this.ciId\n        }\n        this.getTableList()\n      },\n      refresh() {\n        this.tableLoading = true\n        refreshCiAttr({\n          ciId: this.ciId,\n          ciName: this.ciName\n        }).then(res => {\n          this.$message({\n            type: \"success\",\n            message: res.data\n          });\n          this.search()\n        })\n      },\n      Nindex(index) {\n        return index + 1 + (this.searchForm.current - 1) * this.searchForm.size;\n      },\n    }\n  }\n</script>\n\n<style lang=\"scss\" scoped>\n  ::v-deep .el-col-8 {\n    height: 40px;\n  }\n\n  .search_btn {\n    margin-bottom: 15px\n  }\n</style>\n"]}]}