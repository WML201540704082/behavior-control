{"remainingRequest":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/wangminglei/Desktop/behavior-control/src/views/ictOperation/components/intelligenceAnswer/operateForm.vue?vue&type=style&index=0&id=73d5df47&lang=scss&scoped=true","dependencies":[{"path":"/Users/wangminglei/Desktop/behavior-control/src/views/ictOperation/components/intelligenceAnswer/operateForm.vue","mtime":1762478292000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/css-loader/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/sass-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/wangminglei/Desktop/behavior-control/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["\n.btn_box{\n  text-align: center\n}\n",{"version":3,"sources":["operateForm.vue"],"names":[],"mappings":";AAwFA;AACA;AACA","file":"operateForm.vue","sourceRoot":"src/views/ictOperation/components/intelligenceAnswer","sourcesContent":["<template>\n  <div>\n    <el-dialog\n      :close-on-click-modal=\"false\"\n      :before-close=\"() => $emit('close')\"\n      :show-close=\"true\"\n      :visible.sync=\"isShow\"\n      title=\"提交表单\"\n      width=\"800px\"\n      top=\"5vh\"\n      append-to-body\n      v-el-drag-dialog\n    >\n      <el-form\n        ref=\"submitForm\"\n        :model=\"submitForm\"\n        label-suffix=\":\"\n        label-width=\"100px\"\n      >\n        <!-- <el-form-item label=\"审核人\">\n          <el-input v-model=\"submitForm.userName\" disabled></el-input>\n        </el-form-item> -->\n        <el-form-item label=\"审批结果\">\n          <el-radio-group v-model=\"submitForm.result\">\n            <el-radio :label=\"0\">未通过</el-radio>\n            <el-radio :label=\"1\">已通过</el-radio>\n          </el-radio-group>\n        </el-form-item>\n        <el-form-item label=\"审核意见\">\n          <el-input v-model=\"submitForm.comment\" type=\"textarea\" :rows=\"5\"></el-input>\n        </el-form-item>\n\n        \n        <div class=\"btn_box\">\n          <el-button type=\"primary\" @click=\"submit\" :loading=\"saveLoading\">提交</el-button>\n          <el-button type=\"primary\" @click=\"$emit('close')\">取消</el-button>\n        </div>\n      </el-form>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport {mapGetters, mapState} from \"vuex\";\nimport {\n  knowledgeReview\n} from \"@/api/ictOperation/index\"\n\nexport default {\n  props: ['isShow', 'questionId'],\n  data() {\n    return{\n      submitForm: {\n        id: '',\n        comment: '',\n        result: 1\n      },\n      userList: [],\n      saveLoading: false,\n    }\n  },\n  computed: {\n    ...mapGetters([\"userDetail\"]),\n  },\n  mounted() {\n    this.initForm()\n  },\n  methods: {\n    initForm() {\n      // this.submitForm.userName = this.userDetail.userName\n      this.submitForm.id = this.questionId\n      this.$forceUpdate()\n    },\n    submit() {\n      this.saveLoading = true\n      knowledgeReview(this.submitForm).then(res => {\n        this.$message({\n          message: res.msg,\n          type: 'success'\n        });\n        this.$emit('submitProcess')\n      })\n    },\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.btn_box{\n  text-align: center\n}\n</style>\n"]}]}