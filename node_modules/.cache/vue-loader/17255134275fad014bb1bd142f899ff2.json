t-size: 14px;\n  font-weight: bold;\n}\n\n.d_t_left {\n  text-align: left;\n  font-size: 10px;\n}\n\n.code_img_box {\n  white-space: normal !important;\n}\n\n.d_oneline {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 1;\n  overflow: hidden;\n}\n\n.d_twoline {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  overflow: hidden;\n}\n\n.d_start {\n  display: flex;\n  justify-content: flex-start;\n}\n\n.s_label {\n  display: block;\n  white-space: nowrap;\n}\n</style>\n"]}]}